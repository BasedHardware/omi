#!/bin/sh
set -eu
repo_root=$(git rev-parse --show-toplevel)
build_dir=$(mktemp -d /tmp/omi-v5-apple-auth.XXXXXX)
trap 'rm -rf "$build_dir"' EXIT
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation \
  "$repo_root/react-native/macos/Tests/OmiAuthMobileCallbackTest.mm" \
  -o "$build_dir/test"
"$build_dir/test"
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation \
  "$repo_root/react-native/apple/OmiDeviceInformationTest.mm" -o "$build_dir/device-information"
"$build_dir/device-information"
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation \
  "$repo_root/react-native/apple/OmiBleSessionTest.mm" -o "$build_dir/ble-session"
"$build_dir/ble-session"
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation \
  "$repo_root/react-native/apple/OmiDeviceControlsTest.mm" -o "$build_dir/device-controls"
"$build_dir/device-controls"
xcrun clang++ -fobjc-arc -std=c++20 -framework Foundation -I"$repo_root/native-core/include" \
  "$repo_root/react-native/apple/OmiRequestTimeoutTest.mm" "$repo_root/native-core/src/omi_backend_policy.cpp" -o "$build_dir/request-timeout"
"$build_dir/request-timeout"
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation -framework Security \
  "$repo_root/react-native/apple/OmiRecordingLogTest.mm" -o "$build_dir/recording-log"
"$build_dir/recording-log"
xcrun clang++ -fobjc-arc -std=c++20 -framework Foundation -framework Security \
  -I"$repo_root/native-core/include" \
  "$repo_root/react-native/apple/OmiRecordingJournalsTest.mm" \
  "$repo_root/native-core/src/omi_backend_policy.cpp" \
  "$repo_root/native-core/src/omi_backend_http.cpp" \
  "$repo_root/native-core/src/omi_backend_recording.cpp" -o "$build_dir/recording-journals"
"$build_dir/recording-journals"
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation \
  -I"$repo_root/native-core/include" \
  "$repo_root/react-native/apple/OmiRecordingPolicyTest.mm" \
  "$repo_root/native-core/src/omi_backend_recording.cpp" -o "$build_dir/recording-policy"
"$build_dir/recording-policy"
for platform_source in 0 1; do
  xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation -framework CoreBluetooth \
    -I"$repo_root/react-native/apple/tests" -DOMI_TEST_IOS_SOURCE="$platform_source" \
    "$repo_root/react-native/apple/tests/OmiNativeStorageReplacementTest.mm" -o "$build_dir/storage-replacement"
  "$build_dir/storage-replacement"
done
xcrun clang++ -fobjc-arc -std=c++20 -framework Foundation -framework Security -framework LocalAuthentication -Wno-nullability-completeness \
  -I"$repo_root/react-native/apple/tests" -I"$repo_root/native-core/include" \
  "$repo_root/react-native/apple/tests/OmiBackendDisposalTest.mm" \
  "$repo_root/native-core/src/omi_backend_policy.cpp" \
  "$repo_root/native-core/src/omi_backend_http.cpp" \
  "$repo_root/native-core/src/omi_backend_recording.cpp" -o "$build_dir/backend-disposal"
"$build_dir/backend-disposal"
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation -framework AVFoundation -framework CoreImage -framework ImageIO -framework CoreGraphics -framework CoreMedia -framework CoreVideo -lsqlite3 \
  "$repo_root/react-native/macos/Tests/OmiRewindStoreTest.mm" -o "$build_dir/rewind-store"
"$build_dir/rewind-store"
xcrun clang++ -fobjc-arc -fblocks -std=c++17 -framework Foundation -framework AppKit -framework ScreenCaptureKit -framework Vision -framework ImageIO -framework CoreGraphics -lsqlite3 \
  "$repo_root/react-native/apple/OmiRewindCapture.mm" "$repo_root/react-native/apple/OmiRewindCaptureTest.mm" -o "$build_dir/rewind-capture"
"$build_dir/rewind-capture"
