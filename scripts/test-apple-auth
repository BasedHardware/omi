#!/bin/sh
set -eu
repo_root=$(git rev-parse --show-toplevel)
build_dir=$(mktemp -d /tmp/omi-v5-apple-auth.XXXXXX)
trap 'rm -rf "$build_dir"' EXIT
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation \
  "$repo_root/react-native/macos/Tests/OmiAuthMobileCallbackTest.mm" \
  -o "$build_dir/test"
"$build_dir/test"
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation \
  "$repo_root/react-native/apple/OmiDeviceInformationTest.mm" -o "$build_dir/device-information"
"$build_dir/device-information"
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation \
  "$repo_root/react-native/apple/OmiBleSessionTest.mm" -o "$build_dir/ble-session"
"$build_dir/ble-session"
