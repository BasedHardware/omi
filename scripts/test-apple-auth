#!/bin/sh
set -eu
repo_root=$(git rev-parse --show-toplevel)
build_dir=$(mktemp -d /tmp/omi-v5-apple-auth.XXXXXX)
trap 'rm -rf "$build_dir"' EXIT
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation \
  "$repo_root/react-native/macos/Tests/OmiAuthMobileCallbackTest.mm" \
  -o "$build_dir/test"
"$build_dir/test"
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation \
  "$repo_root/react-native/apple/OmiDeviceInformationTest.mm" -o "$build_dir/device-information"
"$build_dir/device-information"
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation \
  "$repo_root/react-native/apple/OmiBleSessionTest.mm" -o "$build_dir/ble-session"
"$build_dir/ble-session"
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation \
  "$repo_root/react-native/apple/OmiDeviceControlsTest.mm" -o "$build_dir/device-controls"
"$build_dir/device-controls"
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation \
  "$repo_root/react-native/apple/OmiRequestTimeoutTest.mm" -o "$build_dir/request-timeout"
"$build_dir/request-timeout"
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation -framework Security \
  "$repo_root/react-native/apple/OmiRecordingLogTest.mm" -o "$build_dir/recording-log"
"$build_dir/recording-log"
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation -framework Security \
  "$repo_root/react-native/apple/OmiRecordingJournalsTest.mm" -o "$build_dir/recording-journals"
"$build_dir/recording-journals"
xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation \
  "$repo_root/react-native/apple/OmiRecordingPolicyTest.mm" -o "$build_dir/recording-policy"
"$build_dir/recording-policy"
for platform_source in 0 1; do
  xcrun clang++ -fobjc-arc -std=c++17 -framework Foundation -framework CoreBluetooth \
    -I"$repo_root/react-native/apple/tests" -DOMI_TEST_IOS_SOURCE="$platform_source" \
    "$repo_root/react-native/apple/tests/OmiNativeStorageReplacementTest.mm" -o "$build_dir/storage-replacement"
  "$build_dir/storage-replacement"
done
