{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Live session broker v1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "session_id",
        "generation",
        "operation",
        "params",
        "timeout_ms"
      ],
      "properties": {
        "version": {
          "const": "live-session/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]{1,80}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^oms-[a-z0-9][a-z0-9-]{0,63}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "operation": {
          "enum": [
            "reload",
            "restart",
            "screenshot",
            "logs",
            "controls",
            "status",
            "stop",
            "verify"
          ]
        },
        "params": {
          "type": "object"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "session_id",
        "generation",
        "outcome",
        "result",
        "evidence_path",
        "error_code"
      ],
      "properties": {
        "version": {
          "const": "live-session/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]{1,80}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^oms-[a-z0-9][a-z0-9-]{0,63}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "enum": [
            "ok",
            "rejected",
            "restart-required",
            "blocked"
          ]
        },
        "result": {
          "type": "object"
        },
        "evidence_path": {
          "type": "string"
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
