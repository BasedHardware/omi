{
  "meta": {
    "name": "Omi v2 \u2014 Midnight Graphite",
    "units": "iOS points (1pt = 1 CSS px in the prototype)",
    "source": "design/ios-v2/generator/lib.py"
  },
  "color": {
    "ink": {
      "dark": "#0A0C10",
      "light": "#F2F3F6",
      "role": "Screen background"
    },
    "surface": {
      "dark": "#14171D",
      "light": "#FFFFFF",
      "role": "Cards, grouped lists"
    },
    "raised": {
      "dark": "#1C2029",
      "light": "#E8EAEF",
      "role": "Controls, fields, chips"
    },
    "fill": {
      "dark": "#272C36",
      "light": "#DEE1E7",
      "role": "Pressed state, secondary buttons, tiles"
    },
    "fillStrong": {
      "dark": "#323845",
      "light": "#C9CED7",
      "role": "Toggle off, progress track"
    },
    "sheet": {
      "dark": "#111419",
      "light": "#F7F8FA",
      "role": "Sheet background"
    },
    "label": {
      "dark": "#ECEEF2",
      "light": "#14171D",
      "role": "Primary text; primary button fill"
    },
    "labelSecondary": {
      "dark": "#9AA1AD",
      "light": "#5B6270",
      "role": "Supporting text"
    },
    "labelTertiary": {
      "dark": "#7F8693",
      "light": "#6B7280",
      "role": "Timestamps, hints (>= 4.5:1 on ink and surface)"
    },
    "midnight": {
      "dark": "#6F86AD",
      "light": "#3F5B8C",
      "role": "Toggle on, selection"
    },
    "attention": {
      "dark": "#FFB547",
      "light": "#A35F00",
      "role": "Needs the user"
    },
    "destructive": {
      "dark": "#FF6B61",
      "light": "#D2342A",
      "role": "Delete, end, overdue"
    },
    "led": {
      "dark": "#4C9BFF",
      "light": "#4C9BFF",
      "role": "ONLY the pendant LED / 'mic is on'. Same in both themes."
    }
  },
  "separator": {
    "dark": "rgba(140,150,170,0.20)",
    "light": "rgba(60,67,80,0.14)",
    "width": 0.5
  },
  "typography": {
    "families": {
      "sans": "SF Pro (system)",
      "serif": "New York (system serif) \u2014 memories, recaps, onboarding headlines",
      "mono": "SF Mono"
    },
    "styles": {
      "largeTitle": {
        "size": 34,
        "lineHeight": 41,
        "weight": 700
      },
      "title1": {
        "size": 28,
        "lineHeight": 34,
        "weight": 700
      },
      "title2": {
        "size": 22,
        "lineHeight": 28,
        "weight": 700
      },
      "title3": {
        "size": 20,
        "lineHeight": 25,
        "weight": 600
      },
      "headline": {
        "size": 17,
        "lineHeight": 22,
        "weight": 600
      },
      "body": {
        "size": 17,
        "lineHeight": 22,
        "weight": 400
      },
      "callout": {
        "size": 16,
        "lineHeight": 21,
        "weight": 400
      },
      "subheadline": {
        "size": 15,
        "lineHeight": 20,
        "weight": 400
      },
      "footnote": {
        "size": 13,
        "lineHeight": 18,
        "weight": 400
      },
      "caption1": {
        "size": 12,
        "lineHeight": 16,
        "weight": 400
      },
      "caption2": {
        "size": 11,
        "lineHeight": 13,
        "weight": 400
      }
    },
    "dynamicType": "All styles map to UIFont.TextStyle equivalents and must scale; never fix sizes in production."
  },
  "radius": {
    "display": 55,
    "floatingSheet": 47,
    "sheet": 40,
    "tabBar": 32,
    "card": 26,
    "cardLarge": 28,
    "row": 22,
    "button": "height/2 (capsule)",
    "tile30": 8,
    "tile36": 10,
    "tile52": 14,
    "chip": 17,
    "inner": 10,
    "rule": "concentric: inner radius = outer radius - padding"
  },
  "spacing": {
    "screenMargin": 16,
    "sectionGap": 22,
    "cardPadding": 16,
    "rowPaddingV": 12,
    "rowPaddingH": 16,
    "rowMinHeight": 52,
    "minTapTarget": 44,
    "iconGap": 12
  },
  "controls": {
    "navButton": 44,
    "tabBarHeight": 64,
    "askButton": 64,
    "primaryButton": 50,
    "toggle": [
      51,
      31
    ],
    "checkbox": 24,
    "segmentHeight": 36,
    "searchField": 44,
    "composer": 52
  },
  "material": {
    "glass": {
      "dark": "rgba(30,34,43,0.58) + blur 26 + saturate 170% + top highlight rgba(255,255,255,.24)",
      "light": "rgba(255,255,255,0.68) + blur 26 + hairline rgba(20,23,30,.08)",
      "ios": "iOS 26: .glassEffect(); iOS 15\u201325: .ultraThinMaterial with the same overlays"
    },
    "glassThick": {
      "dark": "rgba(26,29,37,0.88) + blur 34",
      "light": "rgba(250,251,252,0.9) + blur 34",
      "ios": ".regularMaterial"
    }
  },
  "motion": {
    "spring": {
      "css": "cubic-bezier(.32,.72,0,1)",
      "swiftui": ".spring(response: 0.4, dampingFraction: 0.85)",
      "use": "sheets, segmented thumb, toggles, press"
    },
    "press": {
      "scale": 0.96,
      "opacity": 0.82
    },
    "entrance": {
      "from": {
        "y": 12,
        "scale": 0.985,
        "blur": 5,
        "opacity": 0
      },
      "duration": 0.62,
      "stagger": 0.045
    },
    "ledBreathe": {
      "duration": 2.4,
      "curve": "easeInOut",
      "opacityMin": 0.5,
      "scaleMin": 0.8
    },
    "waveformDrift": {
      "duration": 9,
      "curve": "linear"
    },
    "reduceMotion": "every loop stops; entrances become fades"
  },
  "devices": {
    "base": {
      "width": 393,
      "height": 852,
      "safeTop": 54,
      "safeBottom": 34,
      "cutout": "island"
    },
    "se": {
      "width": 375,
      "height": 667,
      "safeTop": 20,
      "safeBottom": 0,
      "cutout": "none"
    },
    "mini": {
      "width": 375,
      "height": 812,
      "safeTop": 48,
      "safeBottom": 34,
      "cutout": "notch"
    },
    "max": {
      "width": 440,
      "height": 956,
      "safeTop": 62,
      "safeBottom": 34,
      "cutout": "island"
    }
  },
  "layout": {
    "DY": "safeTop - 54   (shift for everything hung from the top)",
    "DB": "(safeBottom - 34) / 2   (shift for everything standing on the bottom)",
    "VY(y)": "safeTop + (y - 54) * (height - safeTop - safeBottom) / 764   (map a 393x852 design y onto this device)",
    "KH": "clamp((height - safeTop - safeBottom) / 764, 0.8, 1.1)   (hero art scale; text never scales)",
    "tabBarBottom": "25 + DB",
    "reference": "design canvas is 393x852 (iPhone 16), safeTop 54, safeBottom 34"
  }
}