require_relative '../node_modules/react-native-macos/scripts/react_native_pods'

require 'json'
require 'open3'

# GPT Live uses react-native-webrtc on phone only; its podspec claims osx
# support but its sources import UIKit.
def phone_only_filtered_config
  default = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"]
  json, status = Open3.capture2(*default)
  raise 'react-native config failed' unless status.success?
  config = JSON.parse(json)
  config.fetch('dependencies').delete('react-native-webrtc')
  JSON.generate(config)
end

prepare_react_native_project!

# glog's configure script does not shell-quote xcrun's compiler path.
xcode_clang = Pod::Executable.execute_command('/usr/bin/xcrun', ['--find', 'clang']).strip
if xcode_clang.include?(' ')
  ENV['PATH'] = "#{File.expand_path('scripts', __dir__)}:#{ENV['PATH']}"
end

def configure_omi_react_native
  platform :macos, '14.0'
  use_native_modules!(['ruby', '-e', 'print ARGV[0]', phone_only_filtered_config])
  use_react_native!(
    :path => '../node_modules/react-native-macos',
    :hermes_enabled => false,
    :fabric_enabled => ENV['RCT_NEW_ARCH_ENABLED'] == '1',
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
end

target 'RnRuntime-macOS' do
  configure_omi_react_native
end

target 'OmiV5Runtime' do
  configure_omi_react_native
end

post_install do |installer|
  react_native_post_install(installer)
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |configuration|
      configuration.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '14.0'
      configuration.build_settings['REACT_NATIVE_PATH'] = '${PODS_ROOT}/../../node_modules/react-native-macos'
      if target.name == 'fmt'
        configuration.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++17'
      end
    end
  end
end
