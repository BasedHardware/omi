{
  "schemaVersion": 1,
  "ruling": [
    "COORD-write-path-rulings",
    "COORD-fable-rulings-wave2"
  ],
  "route": "/v1/{domain}/ops",
  "writableDomains": [
    "tasks"
  ],
  "writeIdPattern": "^[0-9a-f]{64}$",
  "writeIdEntropyBytes": 32,
  "outcomes": [
    {
      "outcome": "accepted",
      "status": 200,
      "kind": "accepted",
      "idempotent": false,
      "bodyRatified": false
    },
    {
      "outcome": "accepted_idempotent",
      "status": 200,
      "kind": "accepted",
      "idempotent": true,
      "bodyRatified": false
    },
    {
      "outcome": "authentication",
      "status": 401,
      "body": "{\"error\":\"unauthorized\",\"refusal_outcome\":\"authentication\"}",
      "kind": "refusal",
      "bodyRatified": true
    },
    {
      "outcome": "authorization",
      "status": 403,
      "body": "{\"error\":\"forbidden\",\"refusal_outcome\":\"authorization\"}",
      "kind": "refusal",
      "bodyRatified": true
    },
    {
      "outcome": "entitlement",
      "status": 403,
      "body": "{\"error\":\"forbidden\",\"refusal_outcome\":\"entitlement\"}",
      "kind": "refusal",
      "bodyRatified": true
    },
    {
      "outcome": "stale_epoch",
      "status": 409,
      "body": "{\"error\":\"stale_epoch\",\"refusal_outcome\":\"stale_epoch\"}",
      "kind": "refusal",
      "bodyRatified": true
    },
    {
      "outcome": "validation",
      "status": 422,
      "body": "{\"error\":\"invalid_envelope\"}",
      "kind": "error",
      "bodyRatified": true
    },
    {
      "outcome": "write_id_reuse",
      "status": 409,
      "body": "{\"error\":\"write_id_reuse\"}",
      "kind": "error",
      "bodyRatified": true
    },
    {
      "outcome": "conflict",
      "status": 409,
      "body": "{\"error\":\"conflict\"}",
      "kind": "error",
      "bodyRatified": true
    },
    {
      "outcome": "control_unavailable",
      "kind": "availability",
      "status": 503,
      "body": "{\"error\":\"maintenance\",\"refusal_outcome\":\"control_unavailable\"}",
      "bodyRatified": true,
      "retryAfterSeconds": 60,
      "note": "RATIFIED by COORD-fable-rulings-wave2 W1 as an AVAILABILITY SIGNAL, not a fifth authorization outcome. ADR-010 section 3's four refusal outcomes are statements about the caller's authority; this one says the server does not know and therefore does not serve. The client obligation is refresh control state and drain where authority lives \u2014 not retry in place, and never a dead letter. retry-after is a fixed constant and may not vary with account state; the active epoch is never in the body."
    }
  ]
}
