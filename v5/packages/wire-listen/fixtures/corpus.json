    {
      "name": "malformed-and-hostile-frames",
      "note": "Every frame here must produce a typed invalid/unknown result rather than an exception. This is the fail-open contract the three hand-written clients each implement differently.",
      "handshake": "native",
      "query": "language=en&client_conversation_id=9012aabb-ccdd-4eef-8123-445566778899",
