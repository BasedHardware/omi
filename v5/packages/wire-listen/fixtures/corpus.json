            "type": "service_status",
            "status": "ready"
          },
          "expect": "event:service_status"
        },
        {
          "text": "not json{",
          "expect": "invalid:not_json"
        },
        {
          "text": "",
          "expect": "invalid:empty"
        },
        {
          "text": "null",
          "expect": "invalid:not_an_object"
        },
        {
          "text": "42",
          "expect": "invalid:not_an_object"
        },
        {
          "text": "\"pong\"",
          "expect": "invalid:not_an_object"
        },
        {
          "json": {
            "status": "ready"
          },
          "expect": "invalid:no_type_field"
        },
        {
          "json": {
            "type": 7
          },
          "expect": "invalid:no_type_field"
        },
        {
          "json": {
            "type": "service_status"
          },
          "expect": "invalid:missing_required_fields"
        },
        {
          "json": {
            "type": "photo_described",
            "photo_id": "p1"
