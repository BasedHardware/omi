<?xml version="1.0" encoding="utf-8"?>
<!-- Phone calls (and-calls): merged into the app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The call shows as a system call (self-managed ConnectionService, the CallKit counterpart). -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The proximity sensor turns the screen off at the ear. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.software.connectionservice" android:required="false" />

    <application>
        <service
            android:name="com.friend.ios.phonecalls.OmiConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
        <!-- Keeps the call (microphone, network) alive while the app is in the background. -->
        <service
            android:name="com.friend.ios.phonecalls.PhoneCallForegroundService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone" />
    </application>
</manifest>
