<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark by default like iOS (flutter.appearanceMode defaults to dark). Compose draws everything else. -->
    <style name="Theme.Omi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#212121</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The launch screen: Flutter's Android 12 splash (the Omi mark on black), then Theme.Omi. -->
    <style name="Theme.Omi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Omi</item>
    </style>
</resources>
