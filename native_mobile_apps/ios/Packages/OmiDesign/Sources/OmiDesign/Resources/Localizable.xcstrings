    "nativeIntroDone": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Los geht's"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start using Omi"
          }
        }
      }
    },
    "nativeIntroForYouBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi schlägt dir unter Für dich von selbst Dinge vor und schickt dir zu einer Uhrzeit deiner Wahl einen kurzen Rückblick auf deinen Tag. Wie oft, entscheidest du."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi suggests things on its own in For you and sends a short recap of your day at a time you pick. How often is up to you."
          }
        }
      }
    },
    "nativeIntroForYouSetting": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie oft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how often"
          }
        }
      }
    },
    "nativeIntroForYouTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideen im richtigen Moment"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideas at the right moment"
          }
        }
      }
    },
    "nativeIntroHandOverBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp bei einer Aufgabe auf Omi übernimmt, und Omi legt los. Den Fortschritt siehst du auf dem Sperrbildschirm. Du kannst jederzeit stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Omi takes over on a task and Omi gets to work, with its progress on your Lock Screen. Stop it anytime."
          }
        }
      }
    },
    "nativeIntroHandOverTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib es ab"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand it over"
          }
        }
      }
    },
    "nativeIntroKicker": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So funktioniert Omi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Omi works"
          }
        }
      }
    },
    "nativeIntroLearnBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Gespräch bringt Omi etwas mehr über dich bei: Menschen, Pläne, was du magst. Du siehst alles unter Erinnerungen und kannst jederzeit etwas ändern oder löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every conversation teaches Omi a little more: people, plans, what you like. See it all in Memories and change or delete anything."
          }
        }
      }
    },
    "nativeIntroLearnTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi lernt dich kennen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi gets to know you"
          }
        }
      }
    },
    "nativeIntroListenBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi hört im Hintergrund zu. Wenn ein Gespräch endet, wird daraus eine Zusammenfassung, deine nächsten Schritte und neue Erinnerungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi listens in the background. When a conversation ends, it turns into a summary, your next steps and new memories."
          }
        }
      }
    },
    "nativeIntroListenTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Gespräch zu nächsten Schritten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From talk to next steps"
          }
        }
      }
    },
    "nativeIntroNext": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        }
      }
    },
    "nativeIntroOnItsOwn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von selbst: recherchieren, entwerfen, erinnern"
          }
        },
        "en": {
