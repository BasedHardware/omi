    "nativeMergeStarted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ الدمج. ستظهر المحادثة الجديدة بعد لحظات."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аб'яднанне. Новая размова хутка з'явіцца."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Обединяване. Новият разговор ще се появи след малко."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একত্র হচ্ছে। নতুন কথোপকথনটি একটু পরেই দেখাবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spajanje je u toku. Novi razgovor će se uskoro pojaviti."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinant. La nova conversa apareixerà en un moment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Slučuje se. Nová konverzace se za chvíli objeví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fletter. Den nye samtale dukker op om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird zusammengeführt. Das neue Gespräch erscheint gleich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γίνεται συγχώνευση. Η νέα συζήτηση εμφανίζεται σε λίγο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merging. The new conversation shows up in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinando. La nueva conversación aparece en un momento."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühendan. Uus vestlus ilmub hetke pärast."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال ادغام. گفتگوی جدید کمی بعد ظاهر می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistetään. Uusi keskustelu ilmestyy hetken päästä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusion en cours. La nouvelle conversation apparaît dans un instant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממזג. השיחה החדשה תופיע בעוד רגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मर्ज हो रहा है। नई बातचीत कुछ देर में दिखेगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spajanje u tijeku. Novi razgovor pojavit će se za trenutak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyesítés folyamatban. Az új beszélgetés mindjárt megjelenik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang menggabungkan. Percakapan baru akan muncul sebentar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unione in corso. La nuova conversazione apparirà a breve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "統合中です。新しい会話がまもなく表示されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿಲೀನ ಆಗುತ್ತಿದೆ. ಹೊಸ ಸಂಭಾಷಣೆ ಸ್ವಲ್ಪ ಹೊತ್ತಿನಲ್ಲಿ ಕಾಣಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합 중이에요. 새 대화가 곧 나타나요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jungiama. Naujas pokalbis netrukus atsiras."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apvieno. Jaunā saruna parādīsies pēc brīža."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спојувам. Новиот разговор се појавува за момент."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मर्ज करत आहे. नवीन संभाषण थोड्याच वेळात दिसेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang menggabungkan. Perbualan baharu muncul sebentar lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samenvoegen. Het nieuwe gesprek verschijnt zo."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår sammen. Den nye samtalen dukker opp om litt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scalanie. Nowa rozmowa pojawi się za chwilę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesclando. A nova conversa aparece em instantes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se îmbină. Noua conversație apare într-un moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединяем. Новый разговор скоро появится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zlučuje sa. Nová konverzácia sa o chvíľu zobrazí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Združevanje. Novi pogovor se bo kmalu prikazal."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Спајање у току. Нови разговор ће се појавити за тренутак."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slår ihop. Det nya samtalet visas om en stund."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைக்கிறது. புதிய உரையாடல் சிறிது நேரத்தில் தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "విలీనం అవుతోంది. కొత్త సంభాషణ కాసేపట్లో కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังรวม บทสนทนาใหม่จะปรากฏในอีกสักครู่"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Isinasama. Lalabas ang bagong usapan sa ilang sandali."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birleştiriliyor. Yeni konuşma birazdan görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Об'єднання. Нова розмова з'явиться за мить."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ضم ہو رہی ہیں۔ نئی گفتگو ابھی نظر آئے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang gộp. Cuộc trò chuyện mới sẽ hiện ra trong giây lát."
          }
        },
        "zh": {
