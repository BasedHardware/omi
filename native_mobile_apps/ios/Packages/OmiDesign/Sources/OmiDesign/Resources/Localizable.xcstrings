    "nativeStoreRecordingsFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لك إعادة تشغيل المحادثات. عند الإيقاف يُحفظ النص فقط."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дазваляе прайграваць размовы. Калі выключана, захоўваецца толькі транскрыпцыя."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволява ти да пускаш разговорите отново. Изключено запазва само транскрипцията."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কথোপকথন আবার শুনতে দেয়। বন্ধ থাকলে শুধু ট্রান্সক্রিপ্ট থাকে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućava ponovno slušanje razgovora. Kad je isključeno, čuva se samo transkript."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Et permet tornar a escoltar converses. Desactivat només conserva la transcripció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní ti konverzace přehrát. Když je vypnuto, uloží se jen přepis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader dig afspille samtaler igen. Fra gemmer kun transskriptionen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit kannst du Gespräche nachhören. Aus behält nur das Transkript."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σου επιτρέπει να ξανακούς τις συζητήσεις. Ανενεργό σημαίνει ότι κρατιέται μόνο η μεταγραφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you replay conversations. Off keeps only the transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te permite volver a escuchar las conversaciones. Desactivado guarda solo la transcripción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võimaldab vestlusi uuesti kuulata. Väljas säilib ainult transkriptsioon."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "امکان پخش دوبارهٔ گفتگوها را می‌دهد. خاموش یعنی فقط رونوشت نگه داشته می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit kuunnella keskustelut uudelleen. Pois päältä säilyy vain litteraatti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet de réécouter les conversations. Désactivé, seule la transcription est conservée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאפשר להשמיע שיחות מחדש. כשכבוי נשמר רק התמלול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बातचीत दोबारा सुनने देता है। बंद रखने पर सिर्फ़ ट्रांसक्रिप्ट रखा जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogućuje ponovno slušanje razgovora. Kad je isključeno, čuva se samo transkript."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehetővé teszi a beszélgetések visszajátszását. Kikapcsolva csak az átirat marad meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memungkinkanmu memutar ulang percakapan. Jika mati, hanya transkrip yang disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti permette di riascoltare le conversazioni. Se disattivato, resta solo la trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話を再生できます。オフにすると文字起こしのみ保存されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಭಾಷಣೆಗಳನ್ನು ಮತ್ತೆ ಕೇಳಲು ಅನುವು ಮಾಡುತ್ತದೆ. ಆಫ್ ಮಾಡಿದರೆ ಲಿಪ್ಯಂತರ ಮಾತ್ರ ಉಳಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화를 다시 들을 수 있어요. 끄면 대화 내용 텍스트만 보관돼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leidžia pakartotinai klausytis pokalbių. Išjungus lieka tik transkripcija."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ļauj atskaņot sarunas. Izslēgts saglabā tikai transkriptu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти овозможува повторно да ги слушаш разговорите. Исклучено чува само транскрипт."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संवाद पुन्हा ऐकता येतात. बंद केल्यास फक्त ट्रान्सक्रिप्ट राहते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membolehkan anda memainkan semula perbualan. Mati hanya menyimpan transkrip."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo kun je gesprekken terugluisteren. Uit bewaart alleen de transcriptie."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Lar deg spille av samtaler igjen. Av beholder bare transkripsjonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala odtwarzać rozmowy. Wyłączone zachowuje tylko transkrypcję."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite reouvir as conversas. Desativado mantém só a transcrição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți permite să reasculți conversațiile. Dezactivat, se păstrează doar transcrierea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет переслушивать разговоры. Если выключено, сохраняется только транскрипт."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní ti znova si prehrať konverzácie. Keď je vypnuté, ostane len prepis."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omogoča ponovno poslušanje pogovorov. Če je izklopljeno, se ohrani samo prepis."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Омогућава поновно слушање разговора. Када је искључено, чува се само транскрипт."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låter dig spela upp samtal igen. Av behåller bara transkriptet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உரையாடல்களை மீண்டும் கேட்க உதவும். ஆஃப் செய்தால் எழுத்துப்படி மட்டும் இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంభాషణలను మళ్లీ వినడానికి వీలు కల్పిస్తుంది. ఆఫ్ చేస్తే ట్రాన్స్‌క్రిప్ట్ మాత్రమే ఉంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วยให้เล่นบทสนทนาซ้ำได้ หากปิดจะเก็บเฉพาะข้อความถอดเสียง"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mapakinggan mo ulit ang mga usapan. Kapag naka-off, transcript lang ang itatabi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşmaları yeniden dinlemenizi sağlar. Kapalıyken yalnızca döküm saklanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволяє відтворювати розмови. Якщо вимкнено, зберігається лише транскрипція."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ گفتگو دوبارہ سن سکتے ہیں۔ بند ہو تو صرف ٹرانسکرپٹ رکھا جاتا ہے۔"
