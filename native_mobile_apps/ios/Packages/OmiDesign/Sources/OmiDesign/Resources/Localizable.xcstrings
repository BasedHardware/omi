    "setDefaultAppContent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد تعيين %1$@ كتطبيق تلخيص افتراضي؟\n\nسيتم استخدام هذا التطبيق تلقائيًا لجميع ملخصات المحادثات المستقبلية."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ўстаўіць %1$@ як адмысловае прыкладанне рэзюмавання?\n\nГэтае прыкладанне будзе аўтаматычна выкарыстоўвацца для ўсіх будучых рэзюме разговораў."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Да зададем %1$@ като ваше приложение за обобщаване по подразбиране?\n\nТова приложение ще се използва автоматично за всички бъдещи резюмета на разговори."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ কে আপনার ডিফল্ট সারসংক্ষেপ অ্যাপ হিসাবে সেট করুন?\n\nএই অ্যাপ সমস্ত ভবিষ্যত কথোপকথন সারসংক্ষেপের জন্য স্বয়ংক্রিয়ভাবে ব্যবহার করা হবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavi %1$@ kao zadanu aplikaciju za sažimanje?\n\nOva aplikacija će biti automatski korištena za sve buduće rezimee razgovora."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Establir %1$@ com la teva aplicació de resum predeterminada?\n\nAquesta aplicació s'utilitzarà automàticament per a tots els resums de converses futures."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavit %1$@ jako výchozí aplikaci pro shrnutí?\n\nTato aplikace bude automaticky použita pro všechna budoucí shrnutí konverzací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv %1$@ som din standardapp til resuméer?\n\nDenne app vil automatisk blive brugt til alle fremtidige samtaleresuméer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ als Standard-App für Zusammenfassungen festlegen?\n\nDiese App wird automatisch für alle zukünftigen Gesprächszusammenfassungen verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να οριστεί το %1$@ ως προεπιλεγμένη εφαρμογή σύνοψης;\n\nΑυτή η εφαρμογή θα χρησιμοποιείται αυτόματα για όλες τις μελλοντικές συνόψεις συνομιλιών."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set %1$@ as your default summarization app?\n\nThis app will be automatically used for all future conversation summaries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Establecer %1$@ como tu app de resumen predeterminada?\n\nEsta app se usará automáticamente para todos los resúmenes de conversaciones futuras."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kas määrata %1$@ vaikimisi kokkuvõtte rakenduseks?\n\nSeda rakendust kasutatakse automaatselt kõigi tulevaste vestluste kokkuvõtete jaoks."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظیم %1$@ به عنوان برنامه خلاصه سازی پیش فرض شما؟\n\nاین برنامه به طور خودکار برای تمام خلاصه های مکالمه آینده استفاده خواهد شد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asetetaanko %1$@ oletusyhteenvetosovellukseksi?\n\nTätä sovellusta käytetään automaattisesti kaikkiin tuleviin keskusteluyhteenvetoihin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définir %1$@ comme application de résumé par défaut ?\n\nCette application sera automatiquement utilisée pour tous les futurs résumés de conversations."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדר את %1$@ כאפליקציית הסיכום ברירת המחדל שלך?\n\nאפליקציה זו תשמש באופן אוטומטי לכל סיכומי השיחות בעתיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या %1$@ को आपके डिफ़ॉल्ट सारांश ऐप के रूप में सेट करें?\n\nइस ऐप का उपयोग स्वचालित रूप से सभी भविष्य की बातचीत के सारांश के लिए किया जाएगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavi %1$@ kao zadanu aplikaciju za sažimanje?\n\nOva aplikacija će biti automatski korištena za sve budućne sažetke razgovora."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítja a(z) %1$@ alkalmazást alapértelmezett összefoglaló alkalmazásként?\n\nEz az alkalmazás automatikusan használva lesz minden jövőbeli beszélgetés összefoglalásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur %1$@ sebagai aplikasi ringkasan default Anda?\n\nAplikasi ini akan otomatis digunakan untuk semua ringkasan percakapan di masa depan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostare %1$@ come app di riepilogo predefinita?\n\nQuesta app verrà utilizzata automaticamente per tutti i futuri riepiloghi delle conversazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@をデフォルトの要約アプリとして設定しますか？\n\nこのアプリは今後のすべての会話の要約に自動的に使用されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ನಿಮ್ಮ ಡಿಫಾಲ್ಟ್ ಸಾರಾಂಶ ಅಪ್ಲಿಕೇಶನ್ ಹೊಂದಿಸುವುದೇ?\n\nಈ ಅಪ್ಲಿಕೇಶನ್ ಭವಿಷ್ಯತ್ತಿನ ಎಲ್ಲಾ ಸಂಭಾಷಣೆ ಸಾರಾಂಶಗಳಿಗೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಬಳಸಲಾಗುವುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 기본 요약 앱으로 설정하시겠습니까?\n\n이 앱은 향후 모든 대화 요약에 자동으로 사용됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar nustatyti %1$@ kaip numatytąją santraukų programą?\n\nŠi programa bus automatiškai naudojama visoms būsimoms pokalbių santraukoms."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai iestatīt %1$@ kā noklusējuma kopsavilkuma lietotni?\n\nŠī lietotne tiks automātiski izmantota visiem turpmākajiem sarunu kopsavilkumiem."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Постави %1$@ како твоја подразумевана апликација за сумирање?\n\nОваа апликација ќе се користи автоматски за сите идни сумирања на разговори."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ हे आपल्या डिफॉल्ट सारांश अ‍ॅप म्हणून सेट करायचे?\n\nहे अ‍ॅप सर्व भविष्यातील संभाषण सारांशांसाठी स्वयंचलितपणे वापरला जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan %1$@ sebagai aplikasi ringkasan lalai anda?\n\nAplikasi ini akan digunakan secara automatik untuk semua ringkasan perbualan pada masa hadapan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ instellen als je standaard samenvattingsapp?\n\nDeze app wordt automatisch gebruikt voor alle toekomstige gesprekssamenvattingen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi %1$@ som din standardapp for oppsummeringer?\n\nDenne appen vil automatisk bli brukt for alle fremtidige samtaleoppsummeringer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawić %1$@ jako domyślną aplikację do podsumowań?\n\nTa aplikacja będzie automatycznie używana do wszystkich przyszłych podsumowań rozmów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Definir %1$@ como seu app de resumo padrão?\n\nEste app será usado automaticamente para todos os resumos de conversas futuras."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setați %1$@ ca aplicație implicită de rezumat?\n\nAceastă aplicație va fi utilizată automat pentru toate rezumatele conversațiilor viitoare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установить %1$@ как приложение для сводок по умолчанию?\n\nЭто приложение будет автоматически использоваться для всех будущих сводок разговоров."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaviť %1$@ ako predvolenú aplikáciu na zhrnutia?\n\nTáto aplikácia sa automaticky použije pre všetky budúce zhrnutia konverzácií."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavite %1$@ kot privzeto aplikacijo za povzemanje?\n\nTa aplikacija bo samodejno uporabljena za vse prihodnje povzetke pogovorov."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставите %1$@ као подразумевану апликацију за сумирање?\n\nОва апликација ће аутоматски бити коришћена за сва будућа резимеа разговора."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange %1$@ som din standardapp för sammanfattningar?\n\nDenna app kommer automatiskt att användas för alla framtida konversationssammanfattningar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ஐ உங்கள் இயல்பு சுருக்க பயன்பாட்டாக அமைக்கவும்?\n\nஇந்த பயன்பாடு அனைத்து வருங்கால உரையாடல் சுருக்கத்திற்கு தானாகவே பயன்படுத்தப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ను మీ డిఫాల్ట్ సంక్షేపణ ఆ్యాప్‌గా సెట్ చేయాలా?\n\nఈ ఆ్యాప్ అన్ని భవిష్యత్ సంభాషణ సారాంశాల కోసం స్వయంచాలకంగా ఉపయోగించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้ง %1$@ เป็นแอปสรุปเริ่มต้นของคุณ?\n\nแอปนี้จะถูกใช้โดยอัตโนมัติสำหรับการสรุปการสนทนาทั้งหมดในอนาคต"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Itakda ang %1$@ bilang iyong default na summarization app?\n\nAng app na ito ay awtomatikong gagamitin para sa lahat ng susunod na conversation summaries."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ varsayılan özet uygulamanız olarak ayarlansın mı?\n\nBu uygulama gelecekteki tüm konuşma özetleri için otomatik olarak kullanılacaktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановити %1$@ як додаток для підсумків за замовчуванням?\n\nЦей додаток буде автоматично використовуватися для всіх майбутніх підсумків розмов."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ کو اپنی ڈیفالٹ خلاصہ کاری ایپ کے طور پر سیٹ کریں؟\n\nیہ ایپ تمام مستقبل کی بات چیت کے خلاصوں کے لیے خودکار طور پر استعمال کی جائے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt %1$@ làm ứng dụng tóm tắt mặc định của bạn?\n\nỨng dụng này sẽ được tự động sử dụng cho tất cả các bản tóm tắt cuộc trò chuyện trong tương lai."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %1$@ 设为您的默认摘要应用？\n\n此应用将自动用于所有未来的对话摘要。"
          }
        }
      }
    },
