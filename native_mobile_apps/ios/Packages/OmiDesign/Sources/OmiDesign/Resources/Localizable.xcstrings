    "nativeMicPermissionNeeded": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الميكروفون في الإعدادات للتسجيل."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дазволь доступ да мікрафона ў Наладах, каб запісваць."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши достъп до микрофона в Настройки, за да записваш."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ড করতে সেটিংসে মাইক্রোফোনের অ্যাক্সেস দিন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvoli pristup mikrofonu u Postavkama da bi snimao."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet l'accés al micròfon a Configuració per gravar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro nahrávání povol přístup k mikrofonu v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad mikrofonadgang i Indstillinger for at optage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Mikrofonzugriff in den Einstellungen, um aufzunehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίτρεψε την πρόσβαση στο μικρόφωνο στις Ρυθμίσεις για να ηχογραφήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone access in Settings to record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso al micrófono en Ajustes para grabar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvestamiseks luba seadetes juurdepääs mikrofonile."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ضبط، در تنظیمات دسترسی به میکروفون را مجاز کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli mikrofonin käyttö Asetuksissa tallentaaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise l'accès au micro dans Réglages pour enregistrer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר גישה למיקרופון בהגדרות כדי להקליט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्ड करने के लिए सेटिंग्स में माइक्रोफ़ोन की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
