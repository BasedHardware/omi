    "chatQuotaExceededReply": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد وصلت إلى حدك الشهري. قم بالترقية لمتابعة الدردشة مع Omi بدون قيود."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы дасягнулі свайго месячнага ліміту. Абнавіце, каб працягваць размаўляць з Omi без абмежаванняў."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнахте месечния си лимит. Надградете, за да продължите да чатите с Omi без ограничения."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি আপনার মাসিক সীমায় পৌঁছেছেন। বিনা সীমাবদ্ধতায় Omi-এর সাথে চ্যাট চালিয়ে যেতে আপগ্রেড করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosegli ste svoj mjesečni limit. Nadogradite da nastavite razgovarati s Omi bez ograničenja."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has assolit el teu límit mensual. Actualitza per continuar xatejant amb Omi sense restriccions."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosáhli jste svého měsíčního limitu. Upgradujte, abyste mohli pokračovat v chatu s Omi bez omezení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har nået din månedlige grænse. Opgrader for at fortsætte med at chatte med Omi uden begrænsninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dein monatliches Limit erreicht. Upgrade, um ohne Einschränkungen mit Omi weiterzuchatten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φτάσατε το μηνιαίο σας όριο. Αναβαθμίστε για να συνεχίσετε να συνομιλείτε με το Omi χωρίς περιορισμούς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've hit your monthly limit. Upgrade to keep chatting with Omi without restrictions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado tu límite mensual. Mejora tu plan para seguir chateando con Omi sin restricciones."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Olete saavutanud oma igakuise limiidi. Uuendage, et jätkata Omiga piiranguteta vestlemist."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما به حد ماهانه خود رسیده‌اید. برای ادامه گفتگو با Omi بدون محدودیت ارتقا دهید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet saavuttanut kuukausittaisen rajasi. Päivitä jatkaaksesi keskustelua Omin kanssa ilman rajoituksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint votre limite mensuelle. Passez à un plan supérieur pour continuer à discuter avec Omi sans restrictions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגעת למגבלה החודשית שלך. שדרג כדי להמשיך לשוחח עם Omi ללא הגבלות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने अपनी मासिक सीमा पूरी कर ली है। बिना प्रतिबंध के Omi से चैट जारी रखने के लिए अपग्रेड करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosegli ste svoj mjesečni limit. Nadogradite da nastavite razgovarati s Omi bez ograničenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elérted a havi limitedet. Frissíts, hogy korlátozás nélkül folytasd a csevegést az Omival."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah mencapai batas bulanan. Upgrade untuk terus mengobrol dengan Omi tanpa batasan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il tuo limite mensile. Aggiorna per continuare a chattare con Omi senza restrizioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月間制限に達しました。制限なくOmiとチャットを続けるにはアップグレードしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ನಿಮ್ಮ ಮಾಸಿಕ ಮಿತಿಯನ್ನು ತಲುಪಿದ್ದೀರಿ. ನಿರ್ಬಂಧಗಳಿಲ್ಲದೆ Omi ಜೊತೆ ಚಾಟ್ ಮುಂದುವರಿಸಲು ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월간 한도에 도달했습니다. 제한 없이 Omi와 계속 채팅하려면 업그레이드하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasiekėte savo mėnesinį limitą. Atnaujinkite, kad galėtumėte toliau bendrauti su Omi be apribojimų."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūs esat sasniedzis savu mēneša limitu. Jauniniet, lai turpinātu tērzēt ar Omi bez ierobežojumiem."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Го достигнавте вашиот месечен лимит. Надградете за да продолжите да разговарате со Omi без ограничувања."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही तुमची मासिक मर्यादा गाठली आहे. निर्बंधांशिवाय Omi सोबत चॅट सुरू ठेवण्यासाठी अपग्रेड करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah mencapai had bulanan. Naik taraf untuk terus bersembang dengan Omi tanpa sekatan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je maandelijkse limiet bereikt. Upgrade om zonder beperkingen met Omi te blijven chatten."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har nådd din månedlige grense. Oppgrader for å fortsette å chatte med Omi uten begrensninger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osiągnąłeś miesięczny limit. Ulepsz, aby kontynuować czatowanie z Omi bez ograniczeń."
          }
