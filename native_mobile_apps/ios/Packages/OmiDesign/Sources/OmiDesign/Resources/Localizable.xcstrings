    "deviceOnboardingVoiceReplySample": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم. يبدأ اجتماعك التالي بعد عشرين دقيقة."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гатова. Ваша наступная сустрэча пачнецца праз дваццаць хвілін."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово. Следващата ви среща започва след двадесет минути."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হয়ে গেছে। আপনার পরবর্তী মিটিং বিশ মিনিট পরে শুরু হবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "U redu. Vaš sljedeći sastanak počinje za dvadeset minuta."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Entesos. La teva pròxima reunió comença d'aquí a vint minuts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mám to. Vaše další schůzka začíná za dvacet minut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er klaret. Dit næste møde begynder om tyve minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles klar. Dein nächstes Meeting beginnt in zwanzig Minuten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έγινε. Η επόμενη συνάντησή σας ξεκινά σε είκοσι λεπτά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've got it. Your next meeting starts in twenty minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendido. Tu próxima reunión empieza en veinte minutos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selge. Sinu järgmine kohtumine algab kahekümne minuti pärast."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انجام شد. جلسه بعدی شما بیست دقیقه دیگر شروع می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selvä. Seuraava kokouksesi alkaa kahdenkymmenen minuutin kuluttua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est noté. Votre prochaine réunion commence dans vingt minutes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבנתי. הפגישה הבאה שלך מתחילה בעוד עשרים דקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समझ गया। आपकी अगली मीटिंग बीस मिनट में शुरू होगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U redu. Vaš sljedeći sastanak počinje za dvadeset minuta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendben. A következő megbeszélésed húsz perc múlva kezdődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baik. Rapat Anda berikutnya dimulai dua puluh menit lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevuto. La tua prossima riunione inizia tra venti minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "了解しました。次の会議は20分後に始まります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅರ್ಥವಾಯಿತು. ನಿಮ್ಮ ಮುಂದಿನ ಸಭೆ ಇಪ್ಪತ್ತು ನಿಮಿಷಗಳಲ್ಲಿ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알겠습니다. 다음 회의가 20분 후에 시작됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Supratau. Kitas jūsų susitikimas prasidės po dvidešimties minučių."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapratu. Jūsu nākamā sapulce sāksies pēc divdesmit minūtēm."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Разбрано. Вашиот следен состанок започнува за дваесет минути."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समजले. तुमची पुढील मीटिंग वीस मिनिटांत सुरू होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baik. Mesyuarat anda yang seterusnya bermula dalam masa dua puluh minit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrepen. Je volgende vergadering begint over twintig minuten."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjønner. Det neste møtet ditt starter om tjue minutter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozumiem. Twoje następne spotkanie zaczyna się za dwadzieścia minut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendido. Sua próxima reunião começa em vinte minutos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am înțeles. Următoarea întâlnire începe peste douăzeci de minute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Понял. Ваша следующая встреча начнётся через двадцать минут."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozumiem. Vaše ďalšie stretnutie sa začne o dvadsať minút."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Razumem. Vaš naslednji sestanek se začne čez dvajset minut."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Разумем. Ваш следећи састанак почиње за двадесет минута."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppfattat. Ditt nästa möte börjar om tjugo minuter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புரிந்தது. உங்கள் அடுத்த சந்திப்பு இருபது நிமிடங்களில் தொடங்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అర్థమైంది. మీ తదుపరి సమావేశం ఇరవై నిమిషాల్లో ప్రారంభమవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับทราบ การประชุมครั้งถัดไปของคุณจะเริ่มในอีกยี่สิบนาที"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakuha ko. Magsisimula ang susunod mong meeting sa loob ng dalawampung minuto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anladım. Sonraki toplantınız yirmi dakika içinde başlıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зрозуміло. Ваша наступна зустріч почнеться за двадцять хвилин."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سمجھ گیا۔ آپ کی اگلی میٹنگ بیس منٹ میں شروع ہوگی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi hiểu rồi. Cuộc họp tiếp theo của bạn bắt đầu sau hai mươi phút nữa."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "明白了。你的下一场会议将在二十分钟后开始。"
          }
        }
      }
    },
