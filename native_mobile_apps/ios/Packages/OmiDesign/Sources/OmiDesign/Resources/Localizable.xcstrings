    "nativeNoVoiceSamples": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد عينات صوتية بعد. سمِّ هذا الشخص في نص وسيحتفظ Omi بعينة قصيرة."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Узораў голасу пакуль няма. Пазнач гэтага чалавека ў транскрыпце, і Omi захавае кароткі ўзор."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Все още няма гласови мостри. Назови този човек в транскрипция и Omi ще запази кратка мостра."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো ভয়েস নমুনা নেই। ট্রান্সক্রিপ্টে এই ব্যক্তির নাম দাও, Omi একটি ছোট নমুনা রেখে দেবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema uzoraka glasa. Imenuj ovu osobu u transkriptu i Omi će sačuvati kratak uzorak."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha mostres de veu. Posa nom a aquesta persona en una transcripció i Omi en guardarà una mostra breu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné vzorky hlasu. Pojmenuj tuto osobu v přepisu a Omi si uloží krátký vzorek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen stemmeprøver endnu. Navngiv personen i en transskription, så gemmer Omi en kort prøve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Stimmproben. Benenne die Person in einem Transkript, dann behält Omi eine kurze Probe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμη δείγματα φωνής. Δώσε όνομα σε αυτό το άτομο σε μια μεταγραφή και το Omi θα κρατήσει ένα σύντομο δείγμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No voice samples yet. Name this person in a transcript and Omi keeps a short sample."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay muestras de voz. Ponle nombre a esta persona en una transcripción y Omi guardará una muestra corta."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Häälenäidiseid veel pole. Pane see inimene transkriptsioonis nimepidi kirja ja Omi hoiab lühikest näidist."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز نمونه صدایی نیست. این شخص را در یک متن نام‌گذاری کن تا Omi یک نمونه کوتاه نگه دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä ääninäytteitä. Nimeä tämä henkilö litteroinnissa, niin Omi tallentaa lyhyen näytteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'échantillons de voix. Nomme cette personne dans une transcription et Omi gardera un court échantillon."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין דגימות קול. תן שם לאדם הזה בתמליל ו-Omi ישמור דגימה קצרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई आवाज़ का नमूना नहीं है। ट्रांसक्रिप्ट में इस व्यक्ति का नाम दो और Omi एक छोटा नमूना रख लेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema uzoraka glasa. Imenuj ovu osobu u transkriptu i Omi će zadržati kratak uzorak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs hangminta. Nevezd meg a személyt egy átiratban, és az Omi egy rövid mintát megőriz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada sampel suara. Beri nama orang ini di transkrip dan Omi akan menyimpan sampel singkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun campione vocale. Dai un nome a questa persona in una trascrizione e Omi conserverà un breve campione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声のサンプルはまだありません。文字起こしでこの人に名前を付けると、Omiが短いサンプルを保存します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ಧ್ವನಿ ಮಾದರಿಗಳಿಲ್ಲ. ಪ್ರತಿಲೇಖನದಲ್ಲಿ ಈ ವ್ಯಕ್ತಿಗೆ ಹೆಸರು ನೀಡಿ, Omi ಒಂದು ಚಿಕ್ಕ ಮಾದರಿ ಇಟ್ಟುಕೊಳ್ಳುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 음성 샘플이 없어요. 대화록에서 이 사람의 이름을 지정하면 Omi가 짧은 샘플을 저장해요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Balso pavyzdžių dar nėra. Įvardink šį žmogų transkripcijoje, ir Omi išsaugos trumpą pavyzdį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Balss paraugu vēl nav. Nosauc šo personu transkriptā, un Omi saglabās īsu paraugu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сè уште нема гласовни примероци. Именувај го лицето во транскрипт и Omi чува краток примерок."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून आवाजाचे नमुने नाहीत. ट्रान्सक्रिप्टमध्ये या व्यक्तीला नाव द्या, मग Omi एक छोटा नमुना ठेवतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada sampel suara. Namakan orang ini dalam transkrip dan Omi menyimpan sampel pendek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen stemsamples. Geef deze persoon een naam in een transcriptie en Omi bewaart een kort sample."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen stemmeprøver ennå. Gi denne personen et navn i en transkripsjon, så lagrer Omi en kort prøve."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak próbek głosu. Nazwij tę osobę w transkrypcji, a Omi zachowa krótką próbkę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem amostras de voz. Dê um nome a essa pessoa em uma transcrição e o Omi guarda uma amostra curta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există mostre de voce. Dă un nume acestei persoane într-o transcriere și Omi păstrează o mostră scurtă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Образцов голоса пока нет. Назови этого человека в расшифровке, и Omi сохранит короткий образец."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ žiadne ukážky hlasu. Pomenuj túto osobu v prepise a Omi si uloží krátku ukážku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Še ni vzorcev glasu. Poimenuj to osebo v prepisu in Omi obdrži kratek vzorec."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Још нема узорака гласа. Именуј ову особу у транскрипту и Omi ће сачувати кратак узорак."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga röstprover än. Namnge personen i en transkription så sparar Omi ett kort prov."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் குரல் மாதிரிகள் இல்லை. டிரான்ஸ்கிரிப்டில் இந்த நபருக்குப் பெயரிடு, Omi ஒரு சிறு மாதிரியை வைத்துக்கொள்ளும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా వాయిస్ శాంపిల్స్ లేవు. ట్రాన్స్‌క్రిప్ట్‌లో ఈ వ్యక్తికి పేరు పెట్టు, Omi ఒక చిన్న శాంపిల్ ఉంచుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีตัวอย่างเสียง ตั้งชื่อบุคคลนี้ในบทถอดเสียง แล้ว Omi จะเก็บตัวอย่างสั้น ๆ ไว้"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang voice sample. Pangalanan ang taong ito sa transcript at magtatabi ang Omi ng maikling sample."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz ses örneği yok. Bu kişiyi bir transkriptte adlandır, Omi kısa bir örnek tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зразків голосу ще немає. Назвіть цю людину в транскрипті, і Omi збереже короткий зразок."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی تک آواز کا کوئی نمونہ نہیں۔ ٹرانسکرپٹ میں اس شخص کو نام دیں اور Omi ایک مختصر نمونہ رکھ لے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có mẫu giọng. Hãy đặt tên người này trong bản ghi và Omi sẽ giữ một mẫu ngắn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有声音样本。在转录中为此人命名，Omi 会保存一段简短的样本。"
          }
        }
      }
    },
    "nativeNotAPersonFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للتلفاز أو البودكاست أو الموسيقى. لن يسأل Omi عن هذا الصوت بعد الآن."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Для ТБ, падкастаў або музыкі. Omi больш не будзе пытацца пра гэты голас."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За телевизия, подкасти или музика. Omi спира да пита за този глас."
