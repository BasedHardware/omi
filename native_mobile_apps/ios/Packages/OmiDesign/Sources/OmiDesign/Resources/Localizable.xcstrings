    "nativeCapabilitiesOnboardingReason": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط تقويمك وبريدك وتطبيق المهام ليتولى Omi الخطوات التالية من محادثاتك. Omi لا يرسل أي شيء للآخرين دون موافقتك."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падключы каляндар, пошту і праграму задач, каб Omi мог займацца наступнымі крокамі з тваіх размоў. Omi нічога не адпраўляе іншым без цябе."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свържи календара, пощата и приложението си за задачи, за да може Omi да се грижи за следващите стъпки от разговорите ти. Omi никога не изпраща нищо на други хора без теб."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডার, মেইল ও টাস্ক অ্যাপ সংযুক্ত করুন, যাতে Omi আপনার কথোপকথন থেকে পরবর্তী ধাপগুলো সামলাতে পারে। আপনাকে ছাড়া Omi অন্যদের কাছে কিছুই পাঠায় না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poveži kalendar, poštu i aplikaciju za zadatke da Omi može preuzeti sljedeće korake iz tvojih razgovora. Omi nikad ne šalje ništa drugima bez tebe."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecta el calendari, el correu i l'app de tasques perquè Omi s'encarregui dels passos següents de les teves converses. Omi mai envia res a altres persones sense tu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Propoj kalendář, poštu a aplikaci na úkoly, aby se Omi mohl postarat o další kroky z tvých konverzací. Omi nikdy nic neodešle ostatním bez tebe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbind din kalender, mail og opgave-app, så Omi kan tage sig af næste skridt fra dine samtaler. Omi sender aldrig noget til andre uden dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde Kalender, Mail und Aufgaben-App, damit Omi nächste Schritte aus deinen Gesprächen übernehmen kann. Omi schickt nie etwas an andere ohne dich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύνδεσε το ημερολόγιο, το mail και την εφαρμογή εργασιών σου ώστε το Omi να αναλαμβάνει τα επόμενα βήματα από τις συζητήσεις σου. Το Omi δεν στέλνει ποτέ τίποτα σε άλλους χωρίς εσένα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your calendar, mail and task app so Omi can take care of next steps from your conversations. Omi never sends anything to other people without you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tu calendario, correo y app de tareas para que Omi se ocupe de los próximos pasos de tus conversaciones. Omi nunca envía nada a otras personas sin ti."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühenda oma kalender, e-post ja ülesannete rakendus, et Omi saaks sinu vestlustest tulenevad järgmised sammud enda peale võtta. Omi ei saada kunagi midagi teistele ilma sinuta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تقویم، ایمیل و برنامهٔ کارهایت را وصل کن تا Omi گام‌های بعدی گفتگوهایت را انجام دهد. Omi هرگز بدون تو چیزی برای دیگران نمی‌فرستد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä kalenterisi, sähköpostisi ja tehtäväsovelluksesi, jotta Omi voi hoitaa keskustelujesi seuraavat askeleet. Omi ei koskaan lähetä mitään muille ilman sinua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte ton agenda, ta messagerie et ton app de tâches pour qu'Omi s'occupe des prochaines étapes de tes conversations. Omi n'envoie jamais rien à d'autres personnes sans toi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חבר את היומן, הדואר ואפליקציית המשימות שלך כדי ש-Omi יטפל בצעדים הבאים משיחותיך. Omi אף פעם לא שולח דבר לאחרים בלעדיך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना कैलेंडर, मेल और टास्क ऐप कनेक्ट करें ताकि Omi आपकी बातचीत के अगले कदम संभाल सके। Omi आपके बिना दूसरों को कभी कुछ नहीं भेजता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poveži kalendar, poštu i aplikaciju za zadatke kako bi se Omi mogao pobrinuti za sljedeće korake iz tvojih razgovora. Omi nikada ništa ne šalje drugima bez tebe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kösd össze a naptáradat, a leveleidet és a feladatkezelő appodat, hogy az Omi intézhesse a beszélgetéseidből adódó következő lépéseket. Az Omi soha nem küld semmit másoknak nélküled."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan kalender, email, dan aplikasi tugasmu agar Omi bisa mengurus langkah berikutnya dari percakapanmu. Omi tidak pernah mengirim apa pun ke orang lain tanpa kamu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega calendario, posta e app delle attività così Omi può occuparsi dei prossimi passi delle tue conversazioni. Omi non invia mai nulla ad altri senza di te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダー、メール、タスクアプリを接続すると、Omiが会話から生まれた次のステップを進めます。あなたに確認せず、他の人に何かを送ることはありません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಕ್ಯಾಲೆಂಡರ್, ಮೇಲ್ ಮತ್ತು ಕಾರ್ಯ ಆ್ಯಪ್ ಸಂಪರ್ಕಿಸಿ, ಇದರಿಂದ Omi ನಿಮ್ಮ ಸಂಭಾಷಣೆಗಳ ಮುಂದಿನ ಹಂತಗಳನ್ನು ನೋಡಿಕೊಳ್ಳಬಹುದು. Omi ನಿಮ್ಮ ಒಪ್ಪಿಗೆಯಿಲ್ಲದೆ ಇತರರಿಗೆ ಏನನ್ನೂ ಕಳುಹಿಸುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더, 메일, 작업 앱을 연결하면 Omi가 대화에서 나온 다음 단계를 처리할 수 있어요. Omi는 회원님 확인 없이는 다른 사람에게 아무것도 보내지 않아요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijunk kalendorių, paštą ir užduočių programėlę, kad Omi galėtų pasirūpinti kitais žingsniais iš tavo pokalbių. Omi niekada nieko nesiunčia kitiems be tavęs."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Savieno kalendāru, pastu un uzdevumu lietotni, lai Omi parūpētos par nākamajiem soļiem no tavām sarunām. Omi nekad nesūta neko citiem bez tevis."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поврзи го календарот, поштата и апликацијата за задачи за Omi да се грижи за следните чекори од твоите разговори. Omi никогаш не испраќа ништо до други без тебе."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे कॅलेंडर, मेल आणि टास्क अॅप कनेक्ट करा, म्हणजे Omi तुमच्या संवादांमधील पुढील पायऱ्या सांभाळू शकेल. Omi तुमच्याशिवाय इतरांना कधीही काहीही पाठवत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan kalendar, mel dan apl tugas anda supaya Omi boleh menguruskan langkah seterusnya daripada perbualan anda. Omi tidak pernah menghantar apa-apa kepada orang lain tanpa anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel je agenda, mail en taken-app zodat Omi de volgende stappen uit je gesprekken kan regelen. Omi stuurt nooit iets naar anderen zonder jou."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til kalender, e-post og oppgaveapp slik at Omi kan ta seg av neste steg fra samtalene dine. Omi sender aldri noe til andre uten deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz kalendarz, pocztę i aplikację do zadań, aby Omi zajęło się kolejnymi krokami z twoich rozmów. Omi nigdy nie wysyła nic innym bez ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte sua agenda, e-mail e app de tarefas para o Omi cuidar dos próximos passos das suas conversas. O Omi nunca envia nada a outras pessoas sem você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează-ți calendarul, e-mailul și aplicația de sarcini, ca Omi să se ocupe de pașii următori din conversațiile tale. Omi nu trimite niciodată nimic altor persoane fără tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите календарь, почту и приложение для задач, чтобы Omi занимался следующими шагами из ваших разговоров. Omi никогда ничего не отправляет другим людям без вас."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripoj kalendár, poštu a aplikáciu na úlohy, aby sa Omi mohol postarať o ďalšie kroky z tvojich konverzácií. Omi nikdy nič neodošle iným ľuďom bez teba."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poveži koledar, e-pošto in aplikacijo za naloge, da se lahko Omi loti naslednjih korakov iz tvojih pogovorov. Omi nikoli ne pošlje ničesar drugim brez tebe."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Повежи календар, пошту и апликацију за задатке да би Omi могао да се побрине за следеће кораке из твојих разговора. Omi никада ништа не шаље другима без тебе."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut din kalender, e-post och uppgiftsapp så att Omi kan ta hand om nästa steg från dina samtal. Omi skickar aldrig något till andra utan dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நாட்காட்டி, மின்னஞ்சல், பணிச் செயலியை இணைத்தால், உங்கள் உரையாடல்களிலிருந்து வரும் அடுத்த படிகளை Omi பார்த்துக்கொள்ளும். உங்கள் ஒப்புதல் இல்லாமல் Omi மற்றவர்களுக்கு எதையும் அனுப்பாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ క్యాలెండర్, మెయిల్, టాస్క్ యాప్‌ను కనెక్ట్ చేయండి, అప్పుడు మీ సంభాషణల నుండి వచ్చే తదుపరి దశలను Omi చూసుకుంటుంది. మీ అనుమతి లేకుండా Omi ఇతరులకు ఏదీ పంపదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อปฏิทิน อีเมล และแอปจัดการงานของคุณ เพื่อให้ Omi ดูแลขั้นตอนถัดไปจากบทสนทนาของคุณ Omi ไม่ส่งอะไรให้คนอื่นโดยที่คุณไม่รู้"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikonekta ang kalendaryo, mail at task app mo para maasikaso ng Omi ang mga susunod na hakbang mula sa mga usapan mo. Hindi kailanman nagpapadala ang Omi ng anuman sa ibang tao nang wala ka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takviminizi, e-postanızı ve görev uygulamanızı bağlayın; Omi konuşmalarınızdan çıkan sonraki adımları halletsin. Omi siz olmadan başkalarına asla bir şey göndermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть календар, пошту й застосунок із завданнями, щоб Omi займався наступними кроками з ваших розмов. Omi ніколи нічого не надсилає іншим без вас."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا کیلنڈر، میل اور ٹاسک ایپ جوڑیں تاکہ Omi آپ کی گفتگو کے اگلے اقدامات سنبھال سکے۔ Omi آپ کے بغیر دوسروں کو کبھی کچھ نہیں بھیجتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối lịch, thư và ứng dụng công việc để Omi lo các bước tiếp theo từ cuộc trò chuyện của bạn. Omi không bao giờ gửi gì cho người khác khi chưa có bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "连接你的日历、邮件和任务应用，让 Omi 处理对话中的后续步骤。未经你同意，Omi 绝不会向他人发送任何内容。"
          }
        }
      }
    },
