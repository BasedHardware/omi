    "nativePeopleFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعلم Omi صوت كل شخص من محادثاتك ويحدد من قال ماذا."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi вывучае голас кожнага чалавека па тваіх размовах і пазначае, хто што сказаў."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi научава гласа на всеки човек от разговорите ти и отбелязва кой какво е казал."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi আপনার কথোপকথন থেকে প্রত্যেকের কণ্ঠ শেখে এবং কে কী বলেছে তা চিহ্নিত করে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi uči glas svake osobe iz tvojih razgovora i označava ko je šta rekao."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi aprèn la veu de cada persona a partir de les teves converses i etiqueta qui ha dit què."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi se z tvých konverzací učí hlas každého člověka a označuje, kdo co řekl."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi lærer hver persons stemme fra dine samtaler og markerer, hvem der sagde hvad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi lernt die Stimmen aus deinen Gesprächen und zeigt, wer was gesagt hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Omi μαθαίνει τη φωνή κάθε ατόμου από τις συζητήσεις σου και σημειώνει ποιος είπε τι."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi learns each person's voice from your conversations and labels who said what."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi aprende la voz de cada persona a partir de tus conversaciones y etiqueta quién dijo qué."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi õpib iga inimese hääle sinu vestlustest ja märgib, kes mida ütles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi صدای هر فرد را از گفتگوهایت یاد می‌گیرد و مشخص می‌کند چه کسی چه گفته است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi oppii jokaisen henkilön äänen keskusteluistasi ja merkitsee, kuka sanoi mitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi apprend la voix de chaque personne à partir de tes conversations et indique qui a dit quoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi לומד את הקול של כל אדם מהשיחות שלך ומסמן מי אמר מה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi आपकी बातचीत से हर व्यक्ति की आवाज़ सीखता है और बताता है कि किसने क्या कहा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi uči glas svake osobe iz tvojih razgovora i označava tko je što rekao."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Omi megtanulja mindenki hangját a beszélgetéseidből, és jelöli, ki mit mondott."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi mempelajari suara setiap orang dari percakapanmu dan menandai siapa mengatakan apa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi impara la voce di ogni persona dalle tue conversazioni e indica chi ha detto cosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Omiは会話から一人ひとりの声を学習し、誰が何を話したかを表示します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ನಿಮ್ಮ ಸಂಭಾಷಣೆಗಳಿಂದ ಪ್ರತಿ ವ್ಯಕ್ತಿಯ ಧ್ವನಿ ಕಲಿತು ಯಾರು ಏನು ಹೇಳಿದರು ಎಂದು ಗುರುತಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi는 대화에서 각 사람의 목소리를 학습해 누가 무슨 말을 했는지 표시해요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi išmoksta kiekvieno žmogaus balsą iš tavo pokalbių ir pažymi, kas ką pasakė."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi no tavām sarunām iemācās katra cilvēka balsi un atzīmē, kurš ko teica."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi го учи гласот на секоја личност од твоите разговори и означува кој што рекол."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi तुमच्या संवादांमधून प्रत्येक व्यक्तीचा आवाज शिकतो आणि कोण काय बोलले ते नोंदवतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi mempelajari suara setiap orang daripada perbualan anda dan melabelkan siapa berkata apa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi leert de stem van elke persoon uit je gesprekken en labelt wie wat zei."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi lærer stemmen til hver person fra samtalene dine og merker hvem som sa hva."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi uczy się głosu każdej osoby z twoich rozmów i oznacza, kto co powiedział."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Omi aprende a voz de cada pessoa nas suas conversas e identifica quem disse o quê."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi învață vocea fiecărei persoane din conversațiile tale și marchează cine a spus ce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi запоминает голос каждого человека из ваших разговоров и помечает, кто что сказал."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi sa učí hlas každej osoby z tvojich konverzácií a označuje, kto čo povedal."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi se iz tvojih pogovorov nauči glas vsake osebe in označi, kdo je kaj rekel."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi из твојих разговора учи глас сваке особе и означава ко је шта рекао."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi lär sig varje persons röst från dina samtal och märker upp vem som sa vad."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உரையாடல்களிலிருந்து ஒவ்வொருவரின் குரலையும் Omi கற்றுக்கொண்டு, யார் என்ன சொன்னார்கள் என்று குறிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సంభాషణల నుండి Omi ప్రతి వ్యక్తి వాయిస్‌ను నేర్చుకుని, ఎవరు ఏమన్నారో గుర్తిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi เรียนรู้เสียงของแต่ละคนจากบทสนทนาของคุณ และระบุว่าใครพูดอะไร"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natututunan ng Omi ang boses ng bawat tao mula sa mga usapan mo at nilalagyan ng label kung sino ang nagsabi ng ano."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi her kişinin sesini konuşmalarınızdan öğrenir ve kimin ne dediğini etiketler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi вивчає голос кожної людини з ваших розмов і позначає, хто що сказав."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi آپ کی گفتگو سے ہر شخص کی آواز سیکھتا ہے اور لکھتا ہے کہ کس نے کیا کہا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi học giọng của từng người từ các cuộc trò chuyện của bạn và ghi nhãn ai đã nói gì."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi 会从你的对话中学习每个人的声音，并标注谁说了什么。"
          }
        }
      }
    },
