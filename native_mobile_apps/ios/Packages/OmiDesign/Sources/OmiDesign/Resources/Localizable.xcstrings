        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi никогда не записывает в Apple Health и не изменяет ваши данные."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nikdy nezapisuje do Apple Health ani neupravuje vaše údaje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nikoli ne piše v Apple Health in ne spreminja vaših podatkov."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi никада не уписује у Apple Health и не мења ваше податке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi skriver aldrig till Apple Health eller ändrar dina data."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ஒருபோதும் Apple Health-இல் எழுதாது அல்லது உங்கள் தரவை மாற்றாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi Apple Health కు ఎప్పుడూ వ్రాయదు లేదా మీ డేటాను మార్చదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ไม่เคยเขียนไปยัง Apple Health หรือแก้ไขข้อมูลของคุณ"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi kailanman nagsusulat ang Omi sa Apple Health o nagbabago ng iyong datos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi, Apple Health'e asla yazmaz ve verilerini değiştirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ніколи не записує в Apple Health і не змінює ваші дані."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi کبھی Apple Health میں نہیں لکھتا اور نہ ہی آپ کا ڈیٹا تبدیل کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi không bao giờ ghi vào Apple Health hoặc thay đổi dữ liệu của bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi 永远不会写入 Apple Health 或修改您的数据。"
          }
        }
      }
    },
