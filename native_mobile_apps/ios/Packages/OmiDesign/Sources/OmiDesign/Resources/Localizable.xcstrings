    "conversationPromptHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثال: استخراج المهام والقرارات المتخذة والنقاط الرئيسية من المحادثة المقدمة."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "напрыклад, Вылучыце задачы, прынятыя рашэнні і ключавыя высновы з прадстаўленай размовы."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "напр. Извлечете задачи, взети решения и ключови изводи от предоставения разговор."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেমন, প্রদত্ত কথোপকথন থেকে কাজ, নেওয়া সিদ্ধান্ত এবং মূল বিষয়গুলি বের করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "npr., Izvucite zadatke, donesene odluke i ključne zaključke iz datog razgovora."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ex., Extreu tasques, decisions preses i punts clau de la conversa proporcionada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "např. Extrahujte úkoly, přijatá rozhodnutí a klíčové poznatky z poskytnuté konverzace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "f.eks. Udtræk opgaver, beslutninger og vigtige pointer fra samtalen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z.B. Extrahieren Sie Aufgaben, getroffene Entscheidungen und wichtige Erkenntnisse aus dem Gespräch."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "π.χ., Εξάγετε εργασίες, αποφάσεις και βασικά συμπεράσματα από τη συνομιλία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g., Extract tasks, decisions made, and key takeaways from the provided conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ej., Extrae tareas, decisiones tomadas y puntos clave de la conversación proporcionada."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "nt Eraldage vestlusest ülesanded, tehtud otsused ja põhipunktid."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای مثال، وظایف، تصمیمات گرفته‌شده و نکات کلیدی را از گفتگوی ارائه‌شده استخراج کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "esim. Poimi tehtävät, päätökset ja keskeiset havainnot keskustelusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ex., Extraire les tâches, les décisions prises et les points clés de la conversation fournie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למשל, חלץ משימות, החלטות שהתקבלו ותובנות עיקריות מהשיחה שסופקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उदा., दी गई बातचीत से कार्य, लिए गए निर्णय और मुख्य बिंदु निकालें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "npr. Izdvojite zadatke, donesene odluke i ključne zaključke iz priloženog razgovora."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "pl. Nyerje ki a feladatokat, döntéseket és fő tanulságokat a beszélgetésből."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "mis., Ekstrak tugas, keputusan yang dibuat, dan poin penting dari percakapan yang diberikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "es., Estrai attività, decisioni prese e punti chiave dalla conversazione fornita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：会話からタスク、決定事項、重要なポイントを抽出します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉದಾಹರಣೆ, ಒದಗಿಸಿದ ಸಂಭಾಷಣೆಯಿಂದ ಕಾರ್ಯಗಳು, ತೆಗೆದುಕೊಂಡ ನಿರ್ಧಾರಗಳು ಮತ್ತು ಪ್ರಮುಖ ಅಂಶಗಳನ್ನು ಹೊರತೆಗೆಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 제공된 대화에서 작업, 결정 사항 및 주요 내용을 추출합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "pvz., Ištraukite užduotis, priimtus sprendimus ir pagrindinius dalykus iš pokalbio."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "piem., Izvelciet uzdevumus, pieņemtos lēmumus un galvenos secinājumus no sarunas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "нпр., Извлечи задачи, донесени одлуки и клучни заклучоци од дадениот разговор."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उदा., प्रदान केलेल्या संभाषणातून कार्ये, घेतलेले निर्णय आणि मुख्य मुद्दे काढा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "cth., Ekstrak tugas, keputusan yang dibuat, dan perkara utama dari perbualan yang diberikan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bijv., Haal taken, genomen beslissingen en belangrijke punten uit het gesprek."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "f.eks., Trekk ut oppgaver, beslutninger og hovedpunkter fra samtalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "np. Wyodrębnij zadania, podjęte decyzje i kluczowe wnioski z rozmowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ex., Extraia tarefas, decisões tomadas e pontos-chave da conversa fornecida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "ex., Extrageți sarcini, decizii luate și concluzii cheie din conversația furnizată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "напр., Извлеките задачи, принятые решения и ключевые выводы из разговора."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "napr. Extrahujte úlohy, prijaté rozhodnutia a kľúčové poznatky z konverzácie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "npr. Izluščite naloge, sprejete odločitve in ključne ugotovitve iz podanega pogovora."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "нпр. Извуците задатке, донете одлуке и кључне закључке из датог разговора."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "t.ex., Extrahera uppgifter, fattade beslut och viktiga slutsatser från samtalet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எ.கா., வழங்கப்பட்ட உரையாடலிலிருந்து பணிகள், எடுக்கப்பட்ட முடிவுகள் மற்றும் முக்கிய கருத்துக்களை பிரித்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఉదా., అందించిన సంభాషణ నుండి పనులు, తీసుకున్న నిర్ణయాలు మరియు ముఖ్యాంశాలను సంగ్రహించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช่น ดึงงาน การตัดสินใจ และประเด็นสำคัญจากการสนทนาที่ให้มา"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g., I-extract ang mga gawain, decisions na ginawa, at key takeaways mula sa ibinigay na conversation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "örn., Verilen konuşmadan görevleri, alınan kararları ve önemli çıkarımları çıkarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "напр., Витягніть завдання, прийняті рішення та ключові висновки з розмови."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مثال کے طور پر، فراہم کردہ بات چیت سے کام، فیصلے، اور اہم نکات نکالیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VD: Trích xuất các nhiệm vụ, quyết định đã đưa ra và điểm chính từ cuộc hội thoại được cung cấp."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "例如，从提供的对话中提取任务、决策和关键要点。"
          }
        }
      }
    },
