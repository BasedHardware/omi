    "chatOfflineHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل. أعد الاتصال لإرسال الرسائل."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы па-за сеткай. Падключыцеся, каб адпраўляць паведамленні."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нямате връзка. Свържете се отново, за да изпращате съобщения."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি অফলাইন। বার্তা পাঠাতে আবার সংযোগ করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Niste na mreži. Ponovo se povežite da biste slali poruke."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No tens connexió. Torna't a connectar per enviar missatges."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste offline. Pro odesílání zpráv se znovu připojte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er offline. Opret forbindelse igen for at sende beskeder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Stelle die Verbindung wieder her, um Nachrichten zu senden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε εκτός σύνδεσης. Συνδεθείτε ξανά για να στείλετε μηνύματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline. Reconnect to send messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Vuelve a conectarte para enviar mensajes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Oled võrguühenduseta. Sõnumite saatmiseks loo uuesti ühendus."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آفلاین هستید. برای ارسال پیام دوباره وصل شوید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet offline-tilassa. Muodosta yhteys lähettääksesi viestejä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Reconnectez-vous pour envoyer des messages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין חיבור. התחבר מחדש כדי לשלוח הודעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऑफ़लाइन हैं। संदेश भेजने के लिए फिर से कनेक्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niste na mreži. Ponovno se povežite da biste slali poruke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline vagy. Üzenetek küldéséhez csatlakozz újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sedang offline. Sambungkan kembali untuk mengirim pesan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei offline. Riconnettiti per inviare messaggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。メッセージを送信するには再接続してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿದ್ದೀರಿ. ಸಂದೇಶ ಕಳುಹಿಸಲು ಮತ್ತೆ ಸಂಪರ್ಕಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 상태입니다. 메시지를 보내려면 다시 연결하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esate neprisijungę. Prisijunkite, kad galėtumėte siųsti žinutes."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūs esat bezsaistē. Lai sūtītu ziņas, izveidojiet savienojumu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сте поврзани. Поврзете се повторно за да испраќате пораки."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही ऑफलाइन आहात. संदेश पाठवण्यासाठी पुन्हा कनेक्ट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda di luar talian. Sambung semula untuk menghantar mesej."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent offline. Maak opnieuw verbinding om berichten te versturen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er frakoblet. Koble til igjen for å sende meldinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś offline. Połącz się ponownie, aby wysyłać wiadomości."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está offline. Reconecte-se para enviar mensagens."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ești offline. Reconectează-te pentru a trimite mesaje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения. Подключитесь, чтобы отправлять сообщения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ste offline. Na odosielanie správ sa znova pripojte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niste povezani. Za pošiljanje sporočil se znova povežite."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Нисте на мрежи. Поново се повежите да бисте слали поруке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är offline. Anslut igen för att skicka meddelanden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஆஃப்லைனில் உள்ளீர்கள். செய்திகளை அனுப்ப மீண்டும் இணைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఆఫ్‌లైన్‌లో ఉన్నారు. సందేశాలు పంపడానికి మళ్లీ కనెక్ట్ అవ్వండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณออฟไลน์อยู่ เชื่อมต่อใหม่เพื่อส่งข้อความ"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline ka. Kumonekta muli para makapagpadala ng mensahe."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışısın. Mesaj göndermek için yeniden bağlan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає з'єднання. Підключіться, щоб надсилати повідомлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ آف لائن ہیں۔ پیغامات بھیجنے کے لیے دوبارہ جڑیں۔"
