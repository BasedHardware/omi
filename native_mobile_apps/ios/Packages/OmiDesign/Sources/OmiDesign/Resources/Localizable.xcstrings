            "value": "Aby Omi mohol zaznamenať, kde sa vaše konverzácie odohrali."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Da lahko Omi zabeleži, kje so potekali vaši pogovori."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Да би Omi могао да забележи где су се ваши разговори одвијали."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Så att Omi kan notera var dina samtal ägde rum."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உரையாடல்கள் எங்கே நடந்தன என்பதை Omi குறிக்க."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సంభాషణలు ఎక్కడ జరిగాయో Omi నమోదు చేయడానికి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อให้ Omi บันทึกได้ว่าบทสนทนาของคุณเกิดขึ้นที่ไหน"
