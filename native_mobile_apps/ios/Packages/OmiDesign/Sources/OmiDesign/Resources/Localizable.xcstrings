        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko često se Omi sam javlja tokom dana."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb quina freqüència Omi et contacta pel seu compte durant el dia."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak často se Omi během dne ozve sám od sebe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor ofte Omi selv henvender sig i løbet af dagen."
