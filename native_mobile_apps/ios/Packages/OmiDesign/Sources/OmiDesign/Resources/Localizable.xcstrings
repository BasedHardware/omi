        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপস! আপনি যে অ্যাপটি খুঁজছেন তা উপলব্ধ নয় বলে মনে হচ্ছে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ups! Izgleda da aplikacija koju tražite nije dostupna."
          }
