    "nativeHandOverCalendar": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يراجع تقويمك ويمكنه حجز وقت لك"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правярае твой каляндар і можа забраніраваць час"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверява календара ти и може да запази време за теб"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ক্যালেন্ডার দেখে এবং সময় ব্লক করতে পারে"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerava tvoj kalendar i može rezervisati vrijeme"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta el teu calendari i pot reservar temps per tu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroluje tvůj kalendář a může ti rezervovat čas"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjekker din kalender og kan blokere tid for dig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft deinen Kalender und kann Zeit für dich blocken"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγχει το ημερολόγιό σου και μπορεί να κλείσει χρόνο για σένα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks your calendar and can block time for you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu calendario y puede reservar tiempo por ti"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaatab su kalendrit ja võib sulle aega kinni panna"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تقویمت را بررسی می‌کند و می‌تواند برایت زمان رزرو کند"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkistaa kalenterisi ja voi varata aikaa puolestasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte ton agenda et peut bloquer du temps pour toi"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בודק את היומן שלך ויכול לחסום זמן עבורך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका कैलेंडर देखता है और आपके लिए समय ब्लॉक कर सकता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjerava tvoj kalendar i može ti blokirati vrijeme"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrzi a naptáradat, és le tud foglalni időt neked"
