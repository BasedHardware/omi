    "nativeFirmwareUpdateConfirmBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ Omi مشحونًا وقريبًا من iPhone، ولا تغلق التطبيق. يستغرق ذلك بضع دقائق. سيُعاد تشغيل Omi عند الانتهاء."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Трымай Omi зараджаным і побач з iPhone і не закрывай праграму. Гэта зойме некалькі хвілін. Потым Omi перазапусціцца."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Дръж Omi зареден и близо до iPhone и не затваряй приложението. Отнема няколко минути. След това Omi ще се рестартира."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi চার্জ দেওয়া অবস্থায় iPhone-এর কাছে রাখো, আর অ্যাপ বন্ধ কোরো না। এতে কয়েক মিনিট লাগবে। শেষ হলে Omi রিস্টার্ট হবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drži Omi napunjen i blizu iPhonea i ne zatvaraj aplikaciju. Ovo traje nekoliko minuta. Omi se nakon toga ponovo pokreće."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el teu Omi carregat i a prop de l'iPhone, i no tanquis l'app. Triga uns minuts. El teu Omi es reiniciarà quan acabi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měj Omi nabitý a blízko iPhonu a nezavírej aplikaci. Trvá to pár minut. Potom se Omi restartuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold din Omi opladet og tæt på din iPhone, og luk ikke appen. Det tager et par minutter. Din Omi genstarter, når den er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte deinen Omi geladen und nah an deinem iPhone und schließ die App nicht. Das dauert ein paar Minuten. Danach startet dein Omi neu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτα το Omi φορτισμένο και κοντά στο iPhone σου και μην κλείσεις την εφαρμογή. Χρειάζονται λίγα λεπτά. Μόλις τελειώσει, το Omi επανεκκινείται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your Omi charged and close to your iPhone, and don't close the app. This takes a few minutes. Your Omi restarts when it's done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu Omi cargado y cerca de tu iPhone, y no cierres la app. Tarda unos minutos. Tu Omi se reinicia al terminar."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoia oma Omi laetuna ja iPhone'i lähedal ning ära sulge rakendust. See võtab paar minutit. Valmis olles Omi taaskäivitub."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi را شارژ و نزدیک iPhone نگه دار و برنامه را نبند. چند دقیقه طول می‌کشد. پس از پایان، Omi دوباره راه‌اندازی می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä Omi ladattuna ja iPhonen lähellä äläkä sulje sovellusta. Tähän menee muutama minuutti. Omi käynnistyy uudelleen, kun päivitys on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde ton Omi chargé et près de ton iPhone, et ne ferme pas l'app. Cela prend quelques minutes. Ton Omi redémarre à la fin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאר את ה-Omi טעון וקרוב ל-iPhone, ואל תסגור את האפליקציה. זה לוקח כמה דקות. ה-Omi יופעל מחדש בסיום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Omi को चार्ज रखो और iPhone के पास रखो, और ऐप बंद मत करो। इसमें कुछ मिनट लगते हैं। पूरा होने पर तुम्हारा Omi रीस्टार्ट होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neka Omi bude napunjen i blizu tvog iPhonea te nemoj zatvarati aplikaciju. Traje nekoliko minuta. Omi se po završetku ponovno pokreće."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd töltve az Omit, maradjon az iPhone-od közelében, és ne zárd be az appot. Pár percig tart. Az Omi végül újraindul."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan Omi terisi daya dan dekat dengan iPhone-mu, dan jangan tutup aplikasi. Ini butuh beberapa menit. Omi akan restart setelah selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni Omi carico e vicino al tuo iPhone e non chiudere l'app. Ci vogliono pochi minuti. Al termine Omi si riavvia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Omiを充電した状態でiPhoneの近くに置き、アプリを閉じないでください。数分かかります。完了するとOmiが再起動します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ Omi ಚಾರ್ಜ್ ಆಗಿರಲಿ ಮತ್ತು ನಿಮ್ಮ iPhone ಹತ್ತಿರ ಇರಲಿ, ಆ್ಯಪ್ ಮುಚ್ಚಬೇಡಿ. ಇದಕ್ಕೆ ಕೆಲವು ನಿಮಿಷಗಳು ಬೇಕು. ಮುಗಿದ ನಂತರ ನಿಮ್ಮ Omi ಮರುಪ್ರಾರಂಭವಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi를 충전한 상태로 iPhone 가까이에 두고, 앱을 닫지 마세요. 몇 분 걸려요. 끝나면 Omi가 다시 시작돼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laikyk Omi įkrautą ir šalia savo iPhone ir neuždaryk programėlės. Tai užtrunka kelias minutes. Baigus Omi persijungs iš naujo."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzturi Omi uzlādētu un tuvu iPhone, un neaizver lietotni. Tas aizņem dažas minūtes. Kad viss gatavs, Omi restartējas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Држи го Omi наполнет и близу до твојот iPhone и не ја затворај апликацијата. Трае неколку минути. Omi се рестартира кога ќе заврши."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा Omi चार्ज ठेवा आणि iPhone जवळ ठेवा, तसेच अॅप बंद करू नका. यास काही मिनिटे लागतात. पूर्ण झाल्यावर Omi रीस्टार्ट होतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan Omi dicas dan dekat dengan iPhone anda, dan jangan tutup apl. Ini mengambil masa beberapa minit. Omi dimulakan semula apabila selesai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je Omi opgeladen en dicht bij je iPhone, en sluit de app niet. Dit duurt een paar minuten. Je Omi herstart als het klaar is."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Omi ladet og nær iPhone, og ikke lukk appen. Det tar noen minutter. Omi starter på nytt når den er ferdig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuj naładowane Omi blisko iPhone'a i nie zamykaj aplikacji. To potrwa kilka minut. Po zakończeniu Omi uruchomi się ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha seu Omi carregado e perto do iPhone, e não feche o app. Leva alguns minutos. Seu Omi reinicia quando terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține Omi încărcat și aproape de iPhone și nu închide aplicația. Durează câteva minute. Omi repornește când termină."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держи Omi заряженным рядом с iPhone и не закрывай приложение. Это займёт несколько минут. После обновления Omi перезапустится."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechaj Omi nabité a blízko iPhonu a nezatváraj aplikáciu. Trvá to niekoľko minút. Po dokončení sa Omi reštartuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi naj bo napolnjen in blizu iPhona, aplikacije pa ne zapiraj. Traja nekaj minut. Ko se konča, se Omi znova zažene."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Држи Omi напуњеним и близу iPhone-а и не затварај апликацију. Траје неколико минута. Када се заврши, Omi се поново покреће."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll din Omi laddad och nära din iPhone, och stäng inte appen. Det tar några minuter. Din Omi startar om när den är klar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உன் Omi-ஐ சார்ஜ் செய்து iPhone அருகில் வைத்திரு, செயலியை மூடாதே. இதற்கு சில நிமிடங்கள் ஆகும். முடிந்ததும் உன் Omi மறுதொடக்கம் ஆகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నీ Omiని ఛార్జ్ చేసి iPhone దగ్గర ఉంచు, యాప్‌ను మూసివేయకు. దీనికి కొన్ని నిమిషాలు పడుతుంది. పూర్తయ్యాక నీ Omi రీస్టార్ట్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชาร์จ Omi ให้พร้อม วางไว้ใกล้ iPhone และอย่าปิดแอป ใช้เวลาไม่กี่นาที Omi จะรีสตาร์ตเมื่อเสร็จ"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Panatilihing may charge ang Omi at malapit sa iPhone mo, at huwag isara ang app. Ilang minuto ito. Magre-restart ang Omi kapag tapos na."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi'nin şarjlı ve iPhone'una yakın olduğundan emin ol, uygulamayı kapatma. Birkaç dakika sürer. Bittiğinde Omi yeniden başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримайте Omi зарядженим і поруч з iPhone, не закривайте застосунок. Це займе кілька хвилин. Після завершення Omi перезапуститься."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے Omi کو چارج رکھیں اور اپنے iPhone کے قریب رکھیں، اور ایپ بند نہ کریں۔ اس میں چند منٹ لگتے ہیں۔ مکمل ہونے پر آپ کا Omi دوبارہ شروع ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy giữ Omi đủ pin và ở gần iPhone, đồng thời đừng đóng ứng dụng. Việc này mất vài phút. Omi sẽ khởi động lại khi xong."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持 Omi 有电并靠近 iPhone，且不要关闭应用。这需要几分钟。完成后 Omi 会重新启动。"
          }
        }
      }
    },
