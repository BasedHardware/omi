    "nativeOnDeviceTranscriptionFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم التعرّف على الكلام من Apple على iPhone بدلًا من التفريغ السحابي لـ Omi، لتسجيلات الهاتف وOmi."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкарыстоўвае распазнаванне маўлення Apple на iPhone замест воблачнай транскрыпцыі Omi, для запісаў з тэлефона і з Omi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Използва разпознаването на реч на Apple на iPhone вместо облачната транскрипция на Omi, за записи от телефона и от Omi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোন ও Omi রেকর্ডিংয়ের জন্য Omi-র ক্লাউড ট্রান্সক্রিপশনের বদলে আপনার iPhone-এ Apple স্পিচ রিকগনিশন ব্যবহার করে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi Appleovo prepoznavanje govora na tvom iPhoneu umjesto Omi cloud transkripcije, za snimke s telefona i s Omi uređaja."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitza el reconeixement de veu d'Apple a l'iPhone en lloc de la transcripció al núvol d'Omi, per a gravacions del mòbil i d'Omi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používá rozpoznávání řeči Apple v iPhonu místo cloudového přepisu Omi, pro nahrávky z telefonu i z Omi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruger Apples talegenkendelse på din iPhone i stedet for Omis cloud-transskription, til telefon- og Omi-optagelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt Apples Spracherkennung auf dem iPhone statt der Cloud-Transkription von Omi, für Handy- und Omi-Aufnahmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιεί την αναγνώριση ομιλίας της Apple στο iPhone σου αντί για τη μεταγραφή στο cloud του Omi, για ηχογραφήσεις από το κινητό και το Omi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses Apple speech recognition on your iPhone instead of Omi's cloud transcription, for phone and Omi recordings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el reconocimiento de voz de Apple en tu iPhone en lugar de la transcripción en la nube de Omi, para grabaciones del teléfono y de Omi."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasutab Omi pilvetranskriptsiooni asemel su iPhone'i Apple'i kõnetuvastust nii telefoni kui ka Omi salvestuste jaoks."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌جای رونویسی ابری Omi، از تشخیص گفتار Apple روی iPhone تو برای ضبط‌های گوشی و Omi استفاده می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttää iPhonesi Applen puheentunnistusta Omin pilvilitteroinnin sijaan puhelimella ja Omilla tehdyille tallenteille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la reconnaissance vocale d'Apple sur ton iPhone au lieu de la transcription cloud d'Omi, pour les enregistrements du téléphone et d'Omi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתמש בזיהוי הדיבור של Apple ב-iPhone שלך במקום בתמלול הענן של Omi, עבור הקלטות מהטלפון ומה-Omi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन और Omi की रिकॉर्डिंग के लिए Omi के क्लाउड ट्रांसक्रिप्शन की जगह आपके iPhone पर Apple की स्पीच रिकग्निशन इस्तेमाल करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi Appleovo prepoznavanje govora na tvom iPhoneu umjesto Omijeve transkripcije u oblaku, za snimke s telefona i Omija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iPhone-od Apple beszédfelismerését használja az Omi felhős átírása helyett a telefonos és Omi-felvételekhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memakai pengenalan ucapan Apple di iPhone-mu, bukan transkripsi cloud Omi, untuk rekaman ponsel dan Omi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il riconoscimento vocale Apple sul tuo iPhone invece della trascrizione cloud di Omi, per le registrazioni da telefono e da Omi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホとOmiの録音で、Omiのクラウド文字起こしの代わりにiPhoneのAppleの音声認識を使います。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋನ್ ಮತ್ತು Omi ರೆಕಾರ್ಡಿಂಗ್‌ಗಳಿಗೆ, Omi ಯ ಕ್ಲೌಡ್ ಲಿಪ್ಯಂತರದ ಬದಲು ನಿಮ್ಮ iPhone ನಲ್ಲಿರುವ Apple ಮಾತು ಗುರುತಿಸುವಿಕೆಯನ್ನು ಬಳಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰과 Omi 녹음에 대해 Omi 클라우드 텍스트 변환 대신 iPhone의 Apple 음성 인식을 사용해요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefono ir Omi įrašams naudoja Apple kalbos atpažinimą tavo iPhone vietoj Omi debesies transkripcijos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmanto Apple runas atpazīšanu tavā iPhone Omi mākoņa transkripcijas vietā, tālruņa un Omi ierakstiem."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Користи препознавање говор од Apple на твојот iPhone наместо облак-транскрипцијата на Omi, за снимки од телефон и од Omi."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोन आणि Omi रेकॉर्डिंगसाठी Omi च्या क्लाउड ट्रान्सक्रिप्शनऐवजी तुमच्या iPhone वर Apple स्पीच रेकग्निशन वापरते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan pengecaman pertuturan Apple pada iPhone anda dan bukannya transkripsi awan Omi, untuk rakaman telefon dan Omi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt Apple-spraakherkenning op je iPhone in plaats van de cloudtranscriptie van Omi, voor opnames van je telefoon en Omi."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruker Apples talegjenkjenning på iPhonen i stedet for Omis skytranskripsjon, for opptak fra telefon og Omi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa rozpoznawania mowy Apple na iPhonie zamiast transkrypcji w chmurze Omi, dla nagrań z telefonu i z Omi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o reconhecimento de fala da Apple no iPhone em vez da transcrição na nuvem do Omi, para gravações do celular e do Omi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește recunoașterea vocală Apple de pe iPhone în loc de transcrierea din cloud Omi, pentru înregistrările de pe telefon și de pe Omi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует распознавание речи Apple на iPhone вместо облачной транскрипции Omi для записей с телефона и Omi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používa rozpoznávanie reči Apple na tvojom iPhone namiesto cloudového prepisu Omi, pre nahrávky z telefónu aj z Omi."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Namesto Omijevega oblačnega prepisa uporablja Applovo prepoznavanje govora na tvojem iPhonu, za posnetke s telefona in z Omi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Користи Apple препознавање говора на твом iPhone-у уместо Omi облачне транскрипције, за снимке са телефона и са Omi-ја."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använder Apples taligenkänning på din iPhone i stället för Omis molntranskribering, för inspelningar från telefon och Omi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஃபோன் மற்றும் Omi பதிவுகளுக்கு, Omi-யின் கிளவுட் எழுத்துப்படிக்குப் பதிலாக உங்கள் iPhone-இல் உள்ள Apple பேச்சு அறிதலைப் பயன்படுத்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోన్, Omi రికార్డింగ్‌ల కోసం Omi క్లౌడ్ ట్రాన్స్‌క్రిప్షన్‌కు బదులుగా మీ iPhoneలోని Apple స్పీచ్ రికగ్నిషన్‌ను ఉపయోగిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้การรู้จำเสียงพูดของ Apple บน iPhone ของคุณแทนการถอดเสียงบนคลาวด์ของ Omi สำหรับการบันทึกด้วยโทรศัพท์และ Omi"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagamit ng speech recognition ng Apple sa iPhone mo sa halip na cloud transcription ng Omi, para sa mga recording mula sa telepono at Omi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon ve Omi kayıtları için Omi'nin bulut yazıya dökmesi yerine iPhone'unuzdaki Apple konuşma tanımayı kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує розпізнавання мовлення Apple на вашому iPhone замість хмарної транскрипції Omi, для записів із телефона й Omi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون اور Omi کی ریکارڈنگز کے لیے Omi کی کلاؤڈ ٹرانسکرپشن کے بجائے آپ کے iPhone پر Apple کی اسپیچ ریکگنیشن استعمال کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng tính năng nhận dạng giọng nói của Apple trên iPhone thay vì chép lời trên đám mây của Omi, cho cả bản ghi từ điện thoại và Omi."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "对手机和 Omi 的录音，使用 iPhone 上的 Apple 语音识别，而不是 Omi 的云端转写。"
          }
        }
      }
    },
