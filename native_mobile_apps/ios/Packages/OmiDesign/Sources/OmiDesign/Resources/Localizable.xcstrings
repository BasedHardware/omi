    "nativeSpeechPermissionNeeded": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالتعرّف على الكلام في الإعدادات للتفريغ على الجهاز."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дазволь распазнаванне маўлення ў Наладах для транскрыпцыі на прыладзе."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреши разпознаването на реч в Настройки за транскрипция на устройството."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইসে ট্রান্সক্রিপশনের জন্য সেটিংসে স্পিচ রিকগনিশনের অনুমতি দিন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvoli prepoznavanje govora u Postavkama za transkripciju na uređaju."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet el reconeixement de veu a Configuració per a la transcripció al dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro přepis v zařízení povol rozpoznávání řeči v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad talegenkendelse i Indstillinger for transskription på enheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube die Spracherkennung in den Einstellungen für die Transkription auf dem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίτρεψε την αναγνώριση ομιλίας στις Ρυθμίσεις για μεταγραφή στη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow speech recognition in Settings for on-device transcription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el reconocimiento de voz en Ajustes para transcribir en el dispositivo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seadmesiseseks transkribeerimiseks luba seadetes kõnetuvastus."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای رونویسی روی دستگاه، در تنظیمات تشخیص گفتار را مجاز کن."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
