        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How often Omi reaches out on its own during the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con qué frecuencia Omi te escribe por iniciativa propia durante el día."
