    "deviceStorageNearlyFull": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجهاز ممتلئ تقريبًا — قم بالمزامنة لتحرير مساحة."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Прылада амаль запоўнена — сінхранізуйце, каб вызваліць месца."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройството е почти пълно — синхронизирайте, за да освободите място."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিভাইস প্রায় পূর্ণ — জায়গা খালি করতে সিঙ্ক করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uređaj je gotovo pun — sinkronizirajte da oslobodite prostor."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositiu és gairebé ple — sincronitza per alliberar espai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařízení je téměř plné — synchronizujte pro uvolnění místa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheden er næsten fuld — synkronisér for at frigøre plads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerät fast voll — synchronisieren, um Speicher freizugeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συσκευή είναι σχεδόν γεμάτη — συγχρονίστε για να ελευθερώσετε χώρο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device nearly full — sync to free space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo está casi lleno: sincroniza para liberar espacio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seade on peaaegu täis — sünkroonige ruumi vabastamiseks."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستگاه تقریباً پر است — برای آزادسازی فضا همگام‌سازی کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laite on lähes täynnä — synkronoi vapauttaaksesi tilaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareil presque plein — synchronisez pour libérer de l'espace."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המכשיר כמעט מלא — סנכרן כדי לפנות מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस लगभग भर गया है — स्थान खाली करने के लिए सिंक करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uređaj je gotovo pun — sinkronizirajte kako biste oslobodili prostor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszköz majdnem tele van — szinkronizáljon a hely felszabadításához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat hampir penuh — sinkronkan untuk mengosongkan ruang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivo quasi pieno — sincronizza per liberare spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの空き容量がわずかです — 同期して空き容量を確保してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಾಧನ ಬಹುತೇಕ ತುಂಬಿದೆ — ಸ್ಥಳವನ್ನು ಮುಕ್ತಗೊಳಿಸಲು ಸಿಂಕ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 거의 가득 찼습니다 — 동기화하여 공간을 확보하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įrenginys beveik pilnas — sinchronizuokite, kad atlaisvintumėte vietos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ierīce ir gandrīz pilna — sinhronizējiet, lai atbrīvotu vietu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уредот е речиси полн — синхронизирајте за да ослободите простор."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डिव्हाइस जवळजवळ भरले आहे — जागा मोकळी करण्यासाठी सिंक करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti hampir penuh — segerakkan untuk mengosongkan ruang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparaat bijna vol — synchroniseer om ruimte vrij te maken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten er nesten full — synkroniser for å frigjøre plass."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urządzenie jest prawie pełne — zsynchronizuj, aby zwolnić miejsce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivo quase cheio — sincronize para liberar espaço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispozitivul este aproape plin — sincronizează pentru a elibera spațiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство почти заполнено — синхронизируйте, чтобы освободить место."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zariadenie je takmer plné — synchronizujte, aby ste uvoľnili miesto."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naprava je skoraj polna — sinhronizirajte za sprostitev prostora."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Уређај је скоро пун — синхронизујте да ослободите простор."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheten är nästan full — synkronisera för att frigöra utrymme."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாதனம் கிட்டத்தட்ட நிரம்பிவிட்டது — இடத்தைக் காலி செய்ய ஒத்திசைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పరికరం దాదాపు నిండిపోయింది — స్థలాన్ని ఖాళీ చేయడానికి సింక్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์เกือบเต็มแล้ว — ซิงค์เพื่อเพิ่มพื้นที่ว่าง"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Halos puno na ang device — mag-sync para magbakante ng espasyo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz neredeyse dolu — yer açmak için eşitleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пристрій майже заповнений — синхронізуйте, щоб звільнити місце."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آلہ تقریباً بھر چکا ہے — جگہ خالی کرنے کے لیے سنک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị gần đầy — đồng bộ để giải phóng dung lượng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "设备快满了 — 请同步以释放空间。"
          }
        }
      }
    },
