    "nativeWaitingOnOthersFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أمور التزم بها آخرون في محادثاتك."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тое, што іншыя людзі абяцалі ў тваіх размовах."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Неща, за които други хора са се ангажирали в разговорите ти."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কথোপকথনে অন্যরা যা করার প্রতিশ্রুতি দিয়েছে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stvari koje su drugi ljudi obećali u tvojim razgovorima."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Coses que altres persones han promès a les teves converses."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Věci, které ostatní slíbili ve tvých konverzacích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ting, andre har lovet i dine samtaler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was andere in deinen Gesprächen zugesagt haben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσα δεσμεύτηκαν άλλοι στις συζητήσεις σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Things other people committed to in your conversations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que otras personas se comprometieron a hacer en tus conversaciones."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Mida teised on sinu vestlustes lubanud."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارهایی که دیگران در گفتگوهای تو متعهد شده‌اند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mihin muut ovat sitoutuneet keskusteluissasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que d'autres personnes se sont engagées à faire dans tes conversations."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דברים שאחרים התחייבו אליהם בשיחות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो बातें दूसरों ने आपकी बातचीत में करने का वादा किया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Što su drugi obećali u tvojim razgovorima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amit mások vállaltak a beszélgetéseidben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hal-hal yang dijanjikan orang lain dalam percakapanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cose che altre persone hanno promesso nelle tue conversazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話の中で他の人が約束したこと。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸಂಭಾಷಣೆಗಳಲ್ಲಿ ಇತರರು ಮಾಡುವುದಾಗಿ ಹೇಳಿದ ಕೆಲಸಗಳು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화에서 다른 사람들이 하기로 한 일이에요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai, ką kiti pažadėjo tavo pokalbiuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietas, ko citi apņēmās tavās sarunās."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Работи што другите ги презеле во твоите разговори."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या संवादांमध्ये इतरांनी ज्या गोष्टींची जबाबदारी घेतली."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkara yang orang lain janjikan dalam perbualan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dingen die anderen in je gesprekken hebben toegezegd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ting andre har forpliktet seg til i samtalene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rzeczy, które inni obiecali w twoich rozmowach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coisas com que outras pessoas se comprometeram nas suas conversas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucruri la care s-au angajat alte persoane în conversațiile tale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, что другие люди пообещали в ваших разговорах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Veci, ku ktorým sa ostatní zaviazali v tvojich konverzáciách."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stvari, ki so jih drugi obljubili v tvojih pogovorih."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ствари на које су се други обавезали у твојим разговорима."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saker som andra har lovat i dina samtal."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் உரையாடல்களில் மற்றவர்கள் செய்வதாக ஒப்புக்கொண்டவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సంభాషణల్లో ఇతరులు చేస్తామని ఒప్పుకున్న విషయాలు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่คนอื่นรับปากไว้ในบทสนทนาของคุณ"
