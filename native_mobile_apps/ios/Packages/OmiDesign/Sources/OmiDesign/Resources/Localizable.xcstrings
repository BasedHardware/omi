    "appleHealthManageNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصل Omi إلى Apple Health عبر إطار عمل HealthKit من Apple. يمكنك إلغاء الوصول في أي وقت من إعدادات iOS."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi атрымлівае доступ да Apple Health праз фрэймворк HealthKit ад Apple. Вы можаце адклікаць доступ у любы час у Наладах iOS."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi осъществява достъп до Apple Health чрез рамката HealthKit на Apple. Можете да отмените достъпа по всяко време от Настройките на iOS."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi অ্যাপলের HealthKit ফ্রেমওয়ার্কের মাধ্যমে Apple Health-এ অ্যাক্সেস করে। আপনি যেকোনো সময় iOS সেটিংস থেকে অ্যাক্সেস প্রত্যাহার করতে পারেন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi pristupa Apple Health-u preko Appleovog HealthKit okvira. Pristup možete opozvati u bilo kojem trenutku u iOS postavkama."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi accedeix a Apple Health a través del framework HealthKit d'Apple. Pots revocar l'accés en qualsevol moment a la configuració d'iOS."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi přistupuje k Apple Health prostřednictvím frameworku HealthKit od Applu. Přístup můžete kdykoli odvolat v Nastavení iOS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi tilgår Apple Health via Apples HealthKit-framework. Du kan til enhver tid tilbagekalde adgangen i iOS-indstillingerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi greift über Apples HealthKit-Framework auf Apple Health zu. Du kannst den Zugriff jederzeit in den iOS-Einstellungen widerrufen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Omi αποκτά πρόσβαση στο Apple Health μέσω του πλαισίου HealthKit της Apple. Μπορείτε να ανακαλέσετε την πρόσβαση ανά πάσα στιγμή από τις Ρυθμίσεις iOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi accesses Apple Health through Apple's HealthKit framework. You can revoke access anytime in iOS Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi accede a Apple Health a través del framework HealthKit de Apple. Puedes revocar el acceso en cualquier momento desde los Ajustes de iOS."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi kasutab Apple Health'i juurdepääsuks Apple'i HealthKit'i raamistikku. Juurdepääsu saate igal ajal tühistada iOS'i seadetes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi از طریق چارچوب HealthKit اپل به Apple Health دسترسی دارد. در هر زمان می‌توانید دسترسی را از تنظیمات iOS لغو کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi käyttää Apple Healthia Applen HealthKit-kehyksen kautta. Voit perua käyttöoikeuden milloin tahansa iOS-asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi accède à Apple Health via le framework HealthKit d'Apple. Vous pouvez révoquer l'accès à tout moment dans les Réglages iOS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ניגש ל-Apple Health דרך מסגרת העבודה HealthKit של Apple. ניתן לבטל את הגישה בכל עת בהגדרות iOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi Apple के HealthKit फ्रेमवर्क के माध्यम से Apple Health तक पहुँचता है। आप किसी भी समय iOS सेटिंग्स से एक्सेस रद्द कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi pristupa Apple Health-u putem Appleovog HealthKit okvira. Pristup možete opozvati u bilo kojem trenutku u iOS postavkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Omi az Apple HealthKit keretrendszerén keresztül fér hozzá az Apple Healthhez. A hozzáférést bármikor visszavonhatod az iOS beállításaiból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi mengakses Apple Health melalui framework HealthKit dari Apple. Anda dapat mencabut akses kapan saja di Pengaturan iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi accede ad Apple Health tramite il framework HealthKit di Apple. Puoi revocare l'accesso in qualsiasi momento dalle Impostazioni iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi は Apple の HealthKit フレームワークを通じて Apple Health にアクセスします。アクセスはいつでも iOS の設定から取り消せます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi Apple ನ HealthKit ಫ್ರೇಮ್‌ವರ್ಕ್ ಮೂಲಕ Apple Health ಅನ್ನು ಪ್ರವೇಶಿಸುತ್ತದೆ. ನೀವು iOS ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ಪ್ರವೇಶವನ್ನು ಹಿಂಪಡೆಯಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi는 Apple의 HealthKit 프레임워크를 통해 Apple Health에 접근합니다. iOS 설정에서 언제든지 접근 권한을 철회할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi pasiekia Apple Health per Apple HealthKit sistemą. Prieigą galite bet kada atšaukti iOS nustatymuose."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi piekļūst Apple Health, izmantojot Apple HealthKit ietvaru. Piekļuvi varat atsaukt jebkurā laikā iOS iestatījumos."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi пристапува до Apple Health преку HealthKit рамката на Apple. Пристапот можете да го повлечете во секое време во поставките на iOS."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi Apple च्या HealthKit फ्रेमवर्कद्वारे Apple Health ला प्रवेश करतो. आपण कोणत्याही वेळी iOS सेटिंग्जमधून प्रवेश रद्द करू शकता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi mengakses Apple Health melalui rangka kerja HealthKit Apple. Anda boleh membatalkan akses pada bila-bila masa dalam Tetapan iOS."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi heeft toegang tot Apple Health via Apple's HealthKit-framework. Je kunt de toegang op elk moment intrekken in de iOS-instellingen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi får tilgang til Apple Health gjennom Apples HealthKit-rammeverk. Du kan når som helst trekke tilbake tilgangen i iOS-innstillingene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi uzyskuje dostęp do Apple Health za pośrednictwem frameworka HealthKit firmy Apple. Dostęp możesz cofnąć w dowolnym momencie w Ustawieniach iOS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Omi acessa o Apple Health através do framework HealthKit da Apple. Você pode revogar o acesso a qualquer momento nos Ajustes do iOS."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi accesează Apple Health prin framework-ul HealthKit de la Apple. Poți revoca accesul oricând din Setările iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi получает доступ к Apple Health через фреймворк HealthKit от Apple. Вы можете отозвать доступ в любой момент в Настройках iOS."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi pristupuje k Apple Health prostredníctvom frameworku HealthKit od spoločnosti Apple. Prístup môžete kedykoľvek zrušiť v Nastaveniach iOS."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi dostopa do Apple Health prek Applovega ogrodja HealthKit. Dostop lahko kadar koli prekličete v nastavitvah iOS."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi приступа Apple Health-у преко Apple-овог HealthKit оквира. Приступ можете опозвати у било ком тренутку у подешавањима iOS-а."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi får åtkomst till Apple Health via Apples HealthKit-ramverk. Du kan återkalla åtkomsten när som helst i iOS-inställningarna."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi, Apple இன் HealthKit கட்டமைப்பின் மூலம் Apple Health-ஐ அணுகுகிறது. iOS அமைப்புகளில் எந்த நேரத்திலும் அணுகலை ரத்து செய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi Apple యొక్క HealthKit ఫ్రేమ్‌వర్క్ ద్వారా Apple Health ను యాక్సెస్ చేస్తుంది. మీరు ఎప్పుడైనా iOS సెట్టింగ్‌ల నుండి యాక్సెస్‌ను ఉపసంహరించుకోవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi เข้าถึง Apple Health ผ่านเฟรมเวิร์ก HealthKit ของ Apple คุณสามารถเพิกถอนการเข้าถึงได้ทุกเมื่อในการตั้งค่า iOS"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ina-access ng Omi ang Apple Health sa pamamagitan ng HealthKit framework ng Apple. Maaari mong bawiin ang access anumang oras sa iOS Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi, Apple Health'e Apple'ın HealthKit çerçevesi üzerinden erişir. Erişimi istediğiniz zaman iOS Ayarlar'dan iptal edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi отримує доступ до Apple Health через фреймворк HealthKit від Apple. Ви можете відкликати доступ у будь-який час у Налаштуваннях iOS."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi، Apple کے HealthKit فریم ورک کے ذریعے Apple Health تک رسائی حاصل کرتا ہے۔ آپ کسی بھی وقت iOS کی ترتیبات سے رسائی منسوخ کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi truy cập Apple Health thông qua framework HealthKit của Apple. Bạn có thể thu hồi quyền truy cập bất cứ lúc nào trong Cài đặt iOS."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi 通过 Apple 的 HealthKit 框架访问 Apple Health。您可以随时在 iOS 设置中撤销访问权限。"
          }
        }
      }
    },
    "appleHealthNotAvailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health غير متاح على هذا الجهاز"
