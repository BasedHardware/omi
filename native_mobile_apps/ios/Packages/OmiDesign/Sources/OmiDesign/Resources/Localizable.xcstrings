    "nativePairingHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل Omi وقرّبه من iPhone."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключы Omi і трымай яго каля iPhone."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включи Omi и го дръж близо до iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Omi চালু করে iPhone-এর কাছে ধরুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključi svoj Omi i drži ga blizu iPhonea."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encén el teu Omi i sosté'l a prop de l'iPhone."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapni Omi a drž ho blízko iPhonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tænd din Omi, og hold den tæt på din iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte dein Omi ein und halte es in die Nähe deines iPhones."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε το Omi σου και κράτα το κοντά στο iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on your Omi and hold it near your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enciende tu Omi y acércalo a tu iPhone."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita oma Omi sisse ja hoia see iPhone'i lähedal."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi خود را روشن کن و نزدیک iPhone نگه دار."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kytke Omi päälle ja pidä se lähellä iPhonea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allume ton Omi et approche-le de ton iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדלק את ה-Omi שלך והחזק אותו ליד ה-iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना Omi चालू करें और उसे iPhone के पास रखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključi svoj Omi i prinesi ga svom iPhoneu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be az Omidat, és tartsd az iPhone-od közelébe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan Omi dan dekatkan ke iPhone-mu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accendi il tuo Omi e tienilo vicino al tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Omiの電源を入れ、iPhoneの近くに置いてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ Omi ಆನ್ ಮಾಡಿ ಮತ್ತು ನಿಮ್ಮ iPhone ಹತ್ತಿರ ಹಿಡಿಯಿರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi를 켜고 iPhone 가까이에 두세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Įjunk savo Omi ir laikyk šalia iPhone."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ieslēdz savu Omi un tuvini to iPhone."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вклучи го Omi и држи го блиску до iPhone."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा Omi चालू करा आणि तो iPhone जवळ धरा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Omi anda dan pegang berhampiran iPhone anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet je Omi aan en houd hem dicht bij je iPhone."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Omi og hold den nær iPhonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Omi i trzymaj je blisko iPhone'a."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue o Omi e segure-o perto do iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pornește Omi și ține-l aproape de iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Omi и поднесите его к iPhone."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapni Omi a drž ho blízko iPhonu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklopi Omi in ga drži blizu iPhona."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Укључи Omi и држи га близу iPhone-а."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på din Omi och håll den nära din iPhone."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Omi-ஐ ஆன் செய்து iPhone அருகில் வைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Omiని ఆన్ చేసి మీ iPhone దగ్గర ఉంచండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Omi ของคุณแล้วถือไว้ใกล้ iPhone"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "I-on ang Omi mo at ilapit ito sa iPhone mo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi'nizi açın ve iPhone'unuza yaklaştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Omi і піднесіть його до iPhone."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا Omi آن کریں اور اسے اپنے iPhone کے قریب رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Omi và để gần iPhone của bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "打开你的 Omi，并将其靠近 iPhone。"
