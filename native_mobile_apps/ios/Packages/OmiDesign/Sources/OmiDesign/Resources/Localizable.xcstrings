          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rögzítéshez engedélyezd a mikrofonhozzáférést a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
