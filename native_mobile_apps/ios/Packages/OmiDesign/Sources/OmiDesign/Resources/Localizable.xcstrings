    "nativeOmiAppsFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تضيف التطبيقات مهارات يستخدمها Omi في الدردشة وعند تولّي المهام."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Праграмы дадаюць навыкі, якія Omi можа выкарыстоўваць у чаце і пры выкананні задач."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложенията добавят умения, които Omi може да използва в чата и когато поема задачи."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ এমন দক্ষতা যোগ করে যা Omi চ্যাটে এবং কাজ হাতে নিলে ব্যবহার করতে পারে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije dodaju vještine koje Omi može koristiti u chatu i kada preuzima zadatke."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps afegeixen habilitats que Omi pot utilitzar al xat i quan assumeix tasques."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace přidávají dovednosti, které Omi může používat v chatu a při převzetí úkolů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps tilføjer færdigheder, som Omi kan bruge i chatten og når den overtager opgaver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps geben Omi zusätzliche Fähigkeiten im Chat und beim Übernehmen von Aufgaben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές προσθέτουν δεξιότητες που μπορεί να χρησιμοποιήσει το Omi στη συνομιλία και όταν αναλαμβάνει εργασίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps add skills Omi can use in chat and when it takes over tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps añaden habilidades que Omi puede usar en el chat y al encargarse de tareas."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakendused lisavad oskusi, mida Omi saab vestluses ja ülesannete ülevõtmisel kasutada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامه‌ها مهارت‌هایی اضافه می‌کنند که Omi در چت و هنگام انجام کارها از آن‌ها استفاده می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellukset lisäävät taitoja, joita Omi voi käyttää chatissa ja tehtäviä hoitaessaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps ajoutent des compétences qu'Omi peut utiliser dans le chat et quand il prend en charge des tâches."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפליקציות מוסיפות יכולות ש-Omi יכול להשתמש בהן בצ'אט וכשהוא לוקח על עצמו משימות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप्स ऐसे स्किल जोड़ते हैं जिन्हें Omi चैट में और टास्क संभालते समय इस्तेमाल कर सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije dodaju vještine koje Omi može koristiti u chatu i kad preuzima zadatke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az appok olyan képességeket adnak, amelyeket az Omi a csevegésben és a feladatok átvételekor használhat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi menambah keterampilan yang bisa dipakai Omi di chat dan saat mengambil alih tugas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app aggiungono abilità che Omi può usare in chat e quando si occupa delle attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを追加すると、チャットやタスクを任せるときにOmiが使えるスキルが増えます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್‌ಗಳು ಚಾಟ್‌ನಲ್ಲಿ ಮತ್ತು ಕಾರ್ಯಗಳನ್ನು ವಹಿಸಿಕೊಳ್ಳುವಾಗ Omi ಬಳಸಬಹುದಾದ ಕೌಶಲ್ಯಗಳನ್ನು ಸೇರಿಸುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 채팅과 작업을 맡길 때 Omi가 쓸 수 있는 기능을 추가해요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Programėlės prideda įgūdžių, kuriuos Omi gali naudoti pokalbyje ir perimdamas užduotis."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lietotnes pievieno prasmes, ko Omi var izmantot čatā un uzdevumu veikšanā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Апликациите додаваат вештини што Omi може да ги користи во чатот и кога презема задачи."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अॅप्स Omi ला चॅटमध्ये आणि कामे हाती घेताना वापरता येणारी कौशल्ये देतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl menambah kemahiran yang boleh digunakan Omi dalam sembang dan apabila mengambil alih tugas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps voegen vaardigheden toe die Omi in de chat en bij overgenomen taken kan gebruiken."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Apper gir Omi ferdigheter som kan brukes i chat og når den tar over oppgaver."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacje dodają umiejętności, których Omi może używać na czacie i przy przejmowaniu zadań."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps adicionam habilidades que o Omi pode usar no chat e ao assumir tarefas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile adaugă abilități pe care Omi le poate folosi în chat și când preia sarcini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения добавляют навыки, которые Omi использует в чате и при выполнении задач."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácie pridávajú schopnosti, ktoré Omi môže používať v chate a pri preberaní úloh."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije dodajo spretnosti, ki jih Omi lahko uporablja v klepetu in pri prevzemanju nalog."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Апликације додају вештине које Omi може да користи у чату и када преузима задатке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appar lägger till färdigheter som Omi kan använda i chatten och när den tar över uppgifter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அரட்டையிலும் பணிகளை எடுத்துக்கொள்ளும்போதும் Omi பயன்படுத்தக்கூடிய திறன்களை செயலிகள் சேர்க்கின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చాట్‌లో, పనులను చేపట్టేటప్పుడు Omi ఉపయోగించగల నైపుణ్యాలను యాప్‌లు జోడిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
