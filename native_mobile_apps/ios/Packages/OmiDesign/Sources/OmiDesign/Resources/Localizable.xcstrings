        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "За Omi да може да забележи каде се одвивале вашите разговори."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जेणेकरून तुमची संभाषणे कुठे झाली हे Omi नोंदवू शकेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Supaya Omi boleh mencatat tempat perbualan anda berlaku."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodat Omi kan vastleggen waar je gesprekken plaatsvonden."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
