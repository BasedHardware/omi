    "nativeConversationTimeoutFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدة الهدوء قبل أن تنتهي المحادثة تلقائيًا. يُطبَّق على المحادثة التالية."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Колькі часу мусіць быць ціха, каб размова скончылася сама. Дзейнічае з наступнай размовы."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Колко дълго трябва да е тихо, преди разговорът да приключи сам. Важи за следващия разговор."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কতক্ষণ চুপচাপ থাকলে কথোপকথন নিজে থেকে শেষ হবে। পরের কথোপকথন থেকে প্রযোজ্য।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko dugo mora biti tiho prije nego što se razgovor sam završi. Važi od sljedećeg razgovora."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quant de temps ha d'estar en silenci perquè una conversa acabi sola. S'aplica a la propera conversa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak dlouho musí být ticho, než konverzace sama skončí. Platí od další konverzace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor længe der skal være stille, før en samtale slutter af sig selv. Gælder fra næste samtale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange es still sein muss, bis eine Unterhaltung von selbst endet. Gilt ab der nächsten Unterhaltung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόση ησυχία χρειάζεται για να τελειώσει μόνη της μια συζήτηση. Ισχύει από την επόμενη συζήτηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long it stays quiet before a conversation ends on its own. Applies to the next conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiempo debe haber silencio para que una conversación termine sola. Se aplica a la próxima conversación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui kaua peab vaikne olema, enne kui vestlus ise lõpeb. Kehtib järgmisele vestlusele."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چقدر باید سکوت باشد تا گفتگو خودش تمام شود. از گفتگوی بعدی اعمال می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka kauan hiljaisuuden pitää kestää, ennen kuin keskustelu päättyy itsestään. Koskee seuraavaa keskustelua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée de silence avant qu'une conversation se termine d'elle-même. S'applique à la prochaine conversation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה זמן צריך להיות שקט עד ששיחה מסתיימת מעצמה. חל מהשיחה הבאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बातचीत अपने आप खत्म होने से पहले कितनी देर शांति रहनी चाहिए। अगली बातचीत से लागू होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko dugo mora biti tiho prije nego se razgovor sam završi. Vrijedi od sljedećeg razgovora."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mennyi csend után ér véget magától egy beszélgetés. A következő beszélgetéstől érvényes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa lama hening sebelum percakapan berakhir sendiri. Berlaku untuk percakapan berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto deve restare in silenzio prima che una conversazione finisca da sola. Vale dalla prossima conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話が自動的に終了するまでの無音の長さです。次の会話から適用されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಭಾಷಣೆ ತಾನಾಗಿಯೇ ಮುಗಿಯುವ ಮೊದಲು ಎಷ್ಟು ಹೊತ್ತು ಮೌನವಾಗಿರಬೇಕು. ಮುಂದಿನ ಸಂಭಾಷಣೆಯಿಂದ ಅನ್ವಯವಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조용한 상태가 얼마나 이어지면 대화가 자동으로 끝날지 정해요. 다음 대화부터 적용돼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiek laiko turi būti tylu, kad pokalbis pats pasibaigtų. Taikoma nuo kito pokalbio."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cik ilgi jāpaliek klusumam, pirms saruna beidzas pati. Attiecas uz nākamo sarunu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Колку долго трае тишината пред разговорот сам да заврши. Важи за следниот разговор."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संभाषण आपोआप संपण्यापूर्वी किती वेळ शांतता असावी. पुढच्या संभाषणापासून लागू."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa lama senyap sebelum perbualan tamat dengan sendirinya. Terpakai untuk perbualan seterusnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe lang het stil blijft voordat een gesprek vanzelf eindigt. Geldt voor het volgende gesprek."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor lenge det er stille før en samtale avsluttes av seg selv. Gjelder neste samtale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak długo ma trwać cisza, zanim rozmowa zakończy się sama. Dotyczy następnej rozmowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto tempo de silêncio até uma conversa terminar sozinha. Vale para a próxima conversa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cât timp trebuie să fie liniște înainte ca o conversație să se încheie singură. Se aplică următoarei conversații."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько должна длиться тишина, чтобы разговор завершился сам. Действует со следующего разговора."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako dlho musí byť ticho, kým sa konverzácia sama skončí. Platí od nasledujúcej konverzácie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako dolgo mora biti tišina, preden se pogovor sam konča. Velja od naslednjega pogovora."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Колико дуго мора бити тихо да се разговор сам заврши. Односи се на следећи разговор."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur länge det måste vara tyst innan ett samtal avslutas av sig självt. Gäller från nästa samtal."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உரையாடல் தானாக முடிவதற்கு முன் எவ்வளவு நேரம் அமைதியாக இருக்க வேண்டும். அடுத்த உரையாடலிலிருந்து பொருந்தும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంభాషణ తనంతట తానే ముగియడానికి ముందు ఎంతసేపు నిశ్శబ్దంగా ఉండాలి. తదుపరి సంభాషణ నుండి వర్తిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะเวลาที่เงียบก่อนบทสนทนาจะจบเอง มีผลกับบทสนทนาถัดไป"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaano katagal itong tahimik bago kusang matapos ang usapan. Para sa susunod na usapan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir konuşmanın kendiliğinden bitmeden önce ne kadar sessiz kalacağı. Sonraki konuşmaya uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки триває тиша, перш ніж розмова завершиться сама. Діє для наступної розмови."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گفتگو خود ختم ہونے سے پہلے کتنی دیر خاموشی رہے۔ اگلی گفتگو پر لاگو ہوگا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng im lặng kéo dài bao lâu thì cuộc trò chuyện tự kết thúc. Áp dụng cho cuộc trò chuyện tiếp theo."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "安静多久后对话会自动结束。适用于下一场对话。"
          }
        }
      }
