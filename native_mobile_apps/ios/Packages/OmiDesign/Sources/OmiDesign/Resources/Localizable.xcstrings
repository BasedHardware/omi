    "nativeKeepsWorkingHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إغلاق هذه الشاشة. يواصل Omi العمل ويضع النتيجة في الرئيسية."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна закрыць. Omi працягвае працаваць і пакладзе вынік на Галоўную."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можеш да затвориш това. Omi продължава да работи и ще постави резултата в Начало."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুমি এটি বন্ধ করতে পারো। Omi কাজ চালিয়ে যাচ্ছে এবং ফলাফল হোমে রাখবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo možeš zatvoriti. Omi nastavlja raditi i rezultat stavlja na Početnu."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho pots tancar. Omi continua treballant i deixa el resultat a Inici."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle můžeš zavřít. Omi pracuje dál a výsledek uloží na Domů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan lukke dette. Omi arbejder videre og lægger resultatet på Hjem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst das schließen. Omi arbeitet weiter und legt das Ergebnis auf Start."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να το κλείσεις. Το Omi συνεχίζει να δουλεύει και βάζει το αποτέλεσμα στην Αρχική."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can close this. Omi keeps working and puts the result on Home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cerrar esto. Omi sigue trabajando y pone el resultado en Inicio."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle võid sulgeda. Omi töötab edasi ja paneb tulemuse avalehele."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌توانی این را ببندی. Omi به کار ادامه می‌دهد و نتیجه را در خانه می‌گذارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit sulkea tämän. Omi jatkaa työtä ja tuo tuloksen Kotiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux fermer ceci. Omi continue de travailler et dépose le résultat dans Accueil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לסגור את זה. Omi ממשיך לעבוד ויציב את התוצאה בדף הבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इसे बंद कर सकते हैं। Omi काम करता रहेगा और नतीजा होम पर रख देगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo možeš zatvoriti. Omi nastavlja raditi i rezultat stavlja na Početnu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt bezárhatod. Az Omi tovább dolgozik, és az eredményt a Kezdőlapra teszi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa menutup ini. Omi tetap bekerja dan menaruh hasilnya di Beranda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi chiudere questa schermata. Omi continua a lavorare e mette il risultato in Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面は閉じて大丈夫です。Omiは作業を続け、結果をホームに届けます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಇದನ್ನು ಮುಚ್ಚಬಹುದು. Omi ಕೆಲಸ ಮುಂದುವರಿಸುತ್ತದೆ ಮತ್ತು ಫಲಿತಾಂಶವನ್ನು ಮುಖಪುಟದಲ್ಲಿ ಇಡುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면은 닫아도 돼요. Omi가 계속 작업하고 결과를 홈에 올려 둘게요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gali tai uždaryti. Omi toliau dirba ir rezultatą padės į Pradžią."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "To vari aizvērt. Omi turpina darbu un ievieto rezultātu sadaļā Sākums."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можеш да го затвориш ова. Omi продолжува да работи и го става резултатот на Почетна."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही हे बंद करू शकता. Omi काम करत राहतो आणि निकाल होमवर ठेवतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menutup ini. Omi terus berfungsi dan meletakkan hasilnya di Laman Utama."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt dit sluiten. Omi blijft werken en zet het resultaat op Start."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan lukke dette. Omi jobber videre og legger resultatet på Hjem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz to zamknąć. Omi pracuje dalej i umieści wynik na ekranie Start."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode fechar isto. O Omi continua trabalhando e coloca o resultado no Início."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți închide asta. Omi continuă să lucreze și pune rezultatul în Acasă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это можно закрыть. Omi продолжит работу и положит результат на Главную."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto môžeš zavrieť. Omi pracuje ďalej a výsledok uloží na Domov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To lahko zapreš. Omi dela naprej in rezultat shrani na Domov."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ово можеш да затвориш. Omi наставља да ради и резултат ставља на Почетну."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan stänga det här. Omi jobbar vidare och lägger resultatet på Hem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இதை மூடலாம். Omi தொடர்ந்து வேலை செய்து, முடிவை முகப்பில் வைக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు దీన్ని మూసివేయవచ్చు. Omi పని కొనసాగిస్తూ ఫలితాన్ని హోమ్‌లో ఉంచుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดหน้านี้ได้เลย Omi ยังทำงานต่อและจะนำผลลัพธ์ไปไว้ที่หน้าหลัก"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwede mo na itong isara. Tuloy pa rin ang trabaho ni Omi at ilalagay niya ang resulta sa Home."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu kapatabilirsin. Omi çalışmaya devam eder ve sonucu Ana Sayfa'ya koyar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це можна закрити. Omi продовжує працювати й покладе результат на Головну."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اسے بند کر سکتے ہیں۔ Omi کام جاری رکھتا ہے اور نتیجہ ہوم پر رکھ دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể đóng mục này. Omi vẫn tiếp tục làm việc và đặt kết quả vào Trang chủ."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以关闭这里。Omi 会继续工作，并把结果放到首页。"
          }
        }
      }
    },
