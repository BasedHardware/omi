    "nativeLightGreenBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يومض أثناء الشحن ويبقى مضاءً عند الامتلاء."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Міргае падчас зарадкі і гарыць бесперапынна, калі зараджаны."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Мига при зареждане и свети постоянно, когато е пълен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চার্জ হওয়ার সময় জ্বলে-নেভে, পূর্ণ হলে স্থির জ্বলে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Treperi dok se puni i svijetli stalno kad je pun."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Parpelleja mentre carrega i queda fix quan és ple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při nabíjení bliká, po nabití svítí trvale."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinker under opladning og lyser konstant, når den er fuld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinkt beim Laden und leuchtet dauerhaft, wenn es voll ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναβοσβήνει όταν φορτίζει και μένει αναμμένο όταν γεμίσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinks while charging and stays on when full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parpadea al cargar y se queda fija cuando está lleno."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilgub laadimise ajal ja jääb põlema, kui on täis."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام شارژ چشمک می‌زند و وقتی پر شد ثابت می‌ماند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilkkuu latauksen aikana ja palaa tasaisesti, kun akku on täynnä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clignote pendant la charge et reste allumé quand il est plein."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מהבהב בזמן טעינה ונשאר דולק כשהוא מלא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चार्ज होते समय झपकता है और भर जाने पर लगातार जलता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Treperi dok se puni i svijetli stalno kad je pun."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Töltés közben villog, teltnél folyamatosan világít."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkedip saat mengisi daya dan menyala terus saat penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampeggia durante la carica e resta fisso quando è pieno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電中は点滅し、満充電になると点灯したままになります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚಾರ್ಜ್ ಆಗುವಾಗ ಮಿಟುಕಿಸುತ್ತದೆ, ತುಂಬಿದಾಗ ಸ್ಥಿರವಾಗಿ ಉರಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충전 중에는 깜빡이고, 가득 차면 계속 켜져 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kraunantis mirksi, o kai pilna, šviečia nuolat."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzlādes laikā mirgo un deg nepārtraukti, kad ir pilns."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трепка додека се полни и свети постојано кога е полн."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चार्ज होताना लुकलुकतो आणि पूर्ण झाल्यावर सतत चालू राहतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkelip semasa mengecas dan menyala tetap apabila penuh."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knippert tijdens het opladen en blijft branden als hij vol is."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinker under lading og lyser fast når den er full."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miga podczas ładowania i świeci stale, gdy jest pełne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisca durante a carga e fica acesa quando está cheio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipește în timpul încărcării și rămâne aprins când e plin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мигает во время зарядки и горит постоянно, когда заряжен."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri nabíjaní bliká, po nabití svieti trvalo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Med polnjenjem utripa, ko je poln, sveti neprekinjeno."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Трепери док се пуни и стално светли када је пун."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinkar under laddning och lyser stadigt när den är full."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சார்ஜ் ஆகும்போது மின்னும், நிரம்பியதும் தொடர்ந்து எரியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఛార్జ్ అవుతున్నప్పుడు మెరుస్తుంది, నిండాక స్థిరంగా వెలుగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กะพริบขณะชาร์จ และติดค้างเมื่อเต็ม"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumukurap habang nagcha-charge at tuloy-tuloy na bukas kapag puno na."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarj olurken yanıp söner, dolunca sürekli yanar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блимає під час заряджання й світиться постійно, коли заряджено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چارج ہوتے وقت جھپکتی ہے اور بھر جانے پر مسلسل جلتی رہتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấp nháy khi sạc và sáng liên tục khi đầy."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "充电时闪烁，充满后常亮。"
          }
        }
