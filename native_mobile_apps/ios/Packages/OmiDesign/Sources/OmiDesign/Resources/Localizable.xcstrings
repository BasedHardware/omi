    "nativeDeleteAccountWarning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف جميع محادثاتك وذكرياتك ومهامك. لا يمكن التراجع عن ذلك."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе твае размовы, успаміны і задачы будуць выдалены. Гэта нельга адмяніць."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всички твои разговори, спомени и задачи се изтриват. Това не може да се отмени."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সব কথোপকথন, স্মৃতি ও কাজ মুছে যাবে। এটি ফেরানো যাবে না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi tvoji razgovori, sjećanja i zadaci bit će izbrisani. Ovo se ne može poništiti."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'eliminaran totes les teves converses, records i tasques. Aquesta acció no es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny tvé konverzace, vzpomínky a úkoly budou smazány. Tuto akci nelze vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle dine samtaler, minder og opgaver slettes. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Gespräche, Erinnerungen und Aufgaben werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλες οι συζητήσεις, οι αναμνήσεις και οι εργασίες σου διαγράφονται. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your conversations, memories and tasks are deleted. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan todas tus conversaciones, recuerdos y tareas. Esta acción no se puede deshacer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik sinu vestlused, mälestused ja ülesanded kustutatakse. Seda ei saa tagasi võtta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همهٔ گفتگوها، خاطرات و کارهای تو حذف می‌شوند. این کار قابل بازگشت نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki keskustelusi, muistosi ja tehtäväsi poistetaan. Tätä ei voi perua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes tes conversations, tous tes souvenirs et toutes tes tâches seront supprimés. Cette action est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל השיחות, הזיכרונות והמשימות שלך יימחקו. לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सारी बातचीत, यादें और टास्क हटा दिए जाएँगे। इसे वापस नहीं किया जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi tvoji razgovori, uspomene i zadaci bit će izbrisani. Ovo se ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden beszélgetésed, emléked és feladatod törlődik. Ez nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua percakapan, memori, dan tugasmu akan dihapus. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le tue conversazioni, i ricordi e le attività verranno eliminati. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての会話、メモリー、タスクが削除されます。この操作は取り消せません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಎಲ್ಲಾ ಸಂಭಾಷಣೆಗಳು, ನೆನಪುಗಳು ಮತ್ತು ಕಾರ್ಯಗಳು ಅಳಿಸಲ್ಪಡುತ್ತವೆ. ಇದನ್ನು ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 대화, 메모리, 작업이 삭제돼요. 이 작업은 되돌릴 수 없어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visi tavo pokalbiai, prisiminimai ir užduotys bus ištrinti. Šio veiksmo atšaukti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas tavas sarunas, atmiņas un uzdevumi tiks dzēsti. To nevar atsaukt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сите твои разговори, спомени и задачи се бришат. Ова не може да се врати."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे सर्व संवाद, आठवणी आणि कामे हटवली जातात. हे पूर्ववत करता येत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua perbualan, memori dan tugas anda dipadam. Ini tidak boleh dibuat asal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al je gesprekken, herinneringen en taken worden verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle samtaler, minner og oppgaver slettes. Dette kan ikke angres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie twoje rozmowy, wspomnienia i zadania zostaną usunięte. Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as suas conversas, memórias e tarefas serão excluídas. Isso não pode ser desfeito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate conversațiile, amintirile și sarcinile tale sunt șterse. Acțiunea nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все ваши разговоры, воспоминания и задачи будут удалены. Это нельзя отменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky tvoje konverzácie, spomienky a úlohy sa odstránia. Túto akciu nemožno vrátiť späť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi tvoji pogovori, spomini in naloge bodo izbrisani. Tega ni mogoče razveljaviti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Сви твоји разговори, успомене и задаци биће обрисани. Ово се не може опозвати."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla dina samtal, minnen och uppgifter raderas. Det går inte att ångra."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அனைத்து உரையாடல்கள், நினைவுகள், பணிகள் நீக்கப்படும். இதைத் திரும்பப் பெற முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ సంభాషణలు, జ్ఞాపకాలు, పనులన్నీ తొలగించబడతాయి. దీన్ని రద్దు చేయలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บทสนทนา ความทรงจำ และงานทั้งหมดของคุณจะถูกลบ การกระทำนี้ไม่สามารถย้อนกลับได้"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mabubura ang lahat ng usapan, alaala at gawain mo. Hindi na ito maibabalik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm konuşmalarınız, anılarınız ve görevleriniz silinir. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі ваші розмови, спогади та завдання буде видалено. Це не можна скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی تمام گفتگوئیں، یادیں اور کام حذف ہو جائیں گے۔ اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn bộ cuộc trò chuyện, ký ức và công việc của bạn sẽ bị xóa. Không thể hoàn tác."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你所有的对话、记忆和任务都将被删除，且无法撤销。"
          }
        }
      }
    },
