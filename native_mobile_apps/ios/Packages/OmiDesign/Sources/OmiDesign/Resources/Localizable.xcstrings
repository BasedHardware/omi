    "appNotAvailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عفواً! يبدو أن التطبيق الذي تبحث عنه غير متوفر."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ой! Здаецца, дадатак, якi вы шукаеце, недаступны."
