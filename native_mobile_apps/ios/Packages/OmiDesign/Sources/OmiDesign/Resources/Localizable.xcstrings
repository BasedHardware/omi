      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi konnte keinen Schlüssel erstellen. Prüf deine Verbindung und versuch es noch mal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi couldn't create a key. Check your connection and try again."
          }
        }
