    "phoneFreeCallLimitReached": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الوصول إلى حد المكالمات المجانية الشهري. يُعاد ضبطه الشهر القادم."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Месячны ліміт бясплатных званкоў вычарпаны. Ён абнавіцца ў наступным месяцы."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Месечният лимит на безплатни обаждания е достигнат. Нулира се следващия месец."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাসিক বিনামূল্যের কলের সীমা পূর্ণ হয়েছে। এটি পরের মাসে রিসেট হবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostignut je mjesečni limit besplatnih poziva. Resetuje se sljedećeg mjeseca."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'ha arribat al límit mensual de trucades gratuïtes. Es restableix el mes vinent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měsíční limit bezplatných hovorů je vyčerpán. Obnoví se příští měsíc."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den månedlige grænse for gratis opkald er nået. Den nulstilles næste måned."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Monatliches Limit für kostenlose Anrufe erreicht. Es wird nächsten Monat zurückgesetzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συμπληρώθηκε το μηνιαίο όριο δωρεάν κλήσεων. Επαναφέρεται τον επόμενο μήνα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monthly free call limit reached. It resets next month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado el límite mensual de llamadas gratuitas. Se restablece el próximo mes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasuta kõnede kuulimiit on täis. See lähtestub järgmisel kuul."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به سقف ماهانه تماس‌های رایگان رسیده‌اید. ماه بعد بازنشانی می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmaisten puheluiden kuukausiraja on täynnä. Se nollautuu ensi kuussa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite mensuelle d'appels gratuits atteinte. Elle sera réinitialisée le mois prochain."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגעת למגבלת השיחות החינמיות החודשית. היא תתאפס בחודש הבא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मासिक मुफ़्त कॉल सीमा पूरी हो गई। यह अगले महीने रीसेट होगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosegnuto je mjesečno ograničenje besplatnih poziva. Resetira se sljedeći mjesec."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elérted a havi ingyenes hívások korlátját. A jövő hónapban visszaáll."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas panggilan gratis bulanan tercapai. Akan diatur ulang bulan depan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite mensile di chiamate gratuite raggiunto. Si azzera il mese prossimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の無料通話の上限に達しました。来月リセットされます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಾಸಿಕ ಉಚಿತ ಕರೆ ಮಿತಿ ತಲುಪಿದೆ. ಮುಂದಿನ ತಿಂಗಳು ಮರುಹೊಂದಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달 무료 통화 한도에 도달했습니다. 다음 달에 초기화됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasiektas mėnesio nemokamų skambučių limitas. Jis atsinaujins kitą mėnesį."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sasniegts mēneša bezmaksas zvanu limits. Tas tiks atiestatīts nākamajā mēnesī."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнат е месечниот лимит на бесплатни повици. Се ресетира следниот месец."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मासिक मोफत कॉल मर्यादा गाठली. ती पुढच्या महिन्यात रीसेट होईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Had panggilan percuma bulanan dicapai. Ia ditetapkan semula bulan depan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maandelijkse limiet voor gratis gesprekken bereikt. Deze wordt volgende maand gereset."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Den månedlige grensen for gratis samtaler er nådd. Den tilbakestilles neste måned."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osiągnięto miesięczny limit bezpłatnych połączeń. Zostanie zresetowany w przyszłym miesiącu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite mensal de chamadas gratuitas atingido. É reposto no próximo mês."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai atins limita lunară de apeluri gratuite. Se resetează luna viitoare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Месячный лимит бесплатных звонков исчерпан. Он обновится в следующем месяце."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesačný limit bezplatných hovorov je vyčerpaný. Obnoví sa budúci mesiac."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosežena je mesečna omejitev brezplačnih klicev. Ponastavi se naslednji mesec."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнуто је месечно ограничење бесплатних позива. Ресетује се следећег месеца."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Månadsgränsen för gratissamtal är nådd. Den återställs nästa månad."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாதாந்திர இலவச அழைப்பு வரம்பை அடைந்துவிட்டீர்கள். அடுத்த மாதம் மீட்டமைக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నెలవారీ ఉచిత కాల్ పరిమితి చేరుకుంది. వచ్చే నెల రీసెట్ అవుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถึงขีดจำกัดการโทรฟรีรายเดือนแล้ว จะรีเซ็ตในเดือนหน้า"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naabot na ang buwanang limitasyon ng libreng tawag. Magre-reset ito sa susunod na buwan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aylık ücretsiz arama sınırına ulaşıldı. Gelecek ay sıfırlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місячний ліміт безкоштовних дзвінків вичерпано. Він оновиться наступного місяця."
          }
        },
        "ur": {
          "stringUnit": {
