    "nativeConnectAIIntro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Claude, ChatGPT oder einen anderen Assistenten nutzen, was Omi weiß: deine Gespräche, Erinnerungen und Aufgaben. Er kann nur lesen, und du kannst ihn jederzeit trennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let Claude, ChatGPT or another assistant use what Omi knows: your conversations, memories and tasks. It can only read, and you can disconnect it at any time."
          }
        }
      }
    },
    "nativeConnectAIKey": {
      "extractionState": "manual",
