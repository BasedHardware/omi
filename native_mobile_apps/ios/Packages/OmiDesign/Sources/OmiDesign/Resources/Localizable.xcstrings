    "nativeEngineNoDownload": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم استخدام محرك الكلام الأصلي لجهازك. لا يلزم تنزيل نموذج."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Будзе выкарыстаны родзім рухавік маўлення вашага прыбора. Загрузка мадэлі не патрэбна."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще се използва вграденият речеви механизъм на устройството. Не е необходимо изтегляне на модел."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ডিভাইসের নেটিভ স্পিচ ইঞ্জিন ব্যবহার করা হবে। কোন মডেল ডাউনলোড প্রয়োজন নেই।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristiće se ugrađeni motor za govore vašeg uređaja. Preuzimanje modela nije potrebno."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sutilitzarà el motor de veu natiu del teu dispositiu. No cal descarregar cap model."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bude použit nativní hlasový engine vašeho zařízení. Není nutné stahovat model."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din enheds indbyggede talemotor vil blive brugt. Ingen model-download påkrævet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die native Sprach-Engine Ihres Geräts wird verwendet. Kein Modell-Download erforderlich."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα χρησιμοποιηθεί η εγγενής μηχανή ομιλίας της συσκευής σας. Δεν απαιτείται λήψη μοντέλου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your devices native speech engine will be used. No model download required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usará el motor de voz nativo de tu dispositivo. No se requiere descarga de modelo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasutatakse teie seadme natiivset kõnemootorit. Mudeli allalaadimine pole vajalik."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موتور گفتار بومی دستگاه شما استفاده خواهد شد. بدون دانلود مدل مورد نیاز."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytetään laitteesi natiivia puhe-moottoria. Mallin latausta ei tarvita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur vocal natif de votre appareil sera utilisé. Aucun téléchargement de modèle requis."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנוע הדיבור המקומי של המכשיר שלך יהיה בשימוש. הורדת דגם אינה נדרשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डिवाइस का मूल स्पीच इंजन उपयोग किया जाएगा। मॉडल डाउनलोड की आवश्यकता नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristit će se motor govora vašeg uređaja. Preuzimanje modela nije potrebno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközöd natív beszédmotorja lesz használva. Nem szükséges modell letöltése."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesin suara asli perangkat Anda akan digunakan. Tidak perlu mengunduh model."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà utilizzato il motore vocale nativo del tuo dispositivo. Non è necessario scaricare un modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのネイティブ音声エンジンが使用されます。モデルのダウンロードは不要です。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸಾಧನದ ಸ್ಥಳೀಯ ಭಾಷಣ ಇಂಜಿನ್ ಬಳಸಲಾಗುವುದು. ಯಾವುದೇ ಮಾದರಿ ಡೌನ್‌ಲೋಡ್ ಅಗತ್ಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 기본 음성 엔진이 사용됩니다. 모델 다운로드가 필요 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bus naudojamas jūsų įrenginio vietinis kalbos variklis. Modelio atsisiuntimas nereikalingas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiks izmantots jūsu ierīces vietējais runas dzinējs. Modeļa lejupielāde nav nepieciešama."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ќе се користи нативната машина за говор на твојот уред. Нема потреба од преземање модел."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आपल्या डिव्हाइसचा नेटिव्ह स्पीच इंजिन वापरला जाईल. मॉडेल डाउनलोड आवश्यक नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjin pertuturan asli peranti anda akan digunakan. Tiada muat turun model diperlukan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De native spraakengine van je apparaat wordt gebruikt. Geen model download nodig."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhetens innebygde talemotor vil bli brukt. Ingen modellnedlasting nødvendig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanie użyty natywny silnik mowy Twojego urządzenia. Pobieranie modelu nie jest wymagane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mecanismo de fala nativo do seu dispositivo será usado. Não é necessário baixar modelo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Motorul vocal nativ al dispozitivului va fi folosit. Nu este necesară descărcarea modelului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет использован встроенный речевой движок вашего устройства. Загрузка модели не требуется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bude použitý natívny hlasový engine vášho zariadenia. Nie je potrebné sťahovať model."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabljena bo nativna govorica naprave. Prenos modela ni potreben."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Биће коришћен изворни говорни механизам вашег уређаја. Преузимање модела није потребно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din enhets inbyggda talmotor kommer att användas. Ingen modellnedladdning krävs."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் சாதனத்தின் பூர்வீக பேச்சு ஞ்சனம் பயன்படுத்தப்படும்। மாதிரி பதிவிறக்கம் தேவையில்லை।"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పరికరం యొక్క నేటివ్ స్పీచ్ ఇంజిన్ ఉపయోగించబడుతుంది. మోడల్ డౌన్‌లోడ్ అవసరం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะใช้เอนจินเสียงแบบเนทีฟของอุปกรณ์ ไม่ต้องดาวน์โหลดโมเดล"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang native speech engine ng iyong device ay gagamitin. Walang model download na kailangan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazınızın yerel konuşma motoru kullanılacak. Model indirmesi gerekli değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Буде використано вбудований мовленнєвий рушій вашого пристрою. Завантаження моделі не потрібне."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے ڈیوائس کے native speech engine کا استعمال کیا جائے گا۔ کوئی ماڈل ڈاؤن لوڈ درکار نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ giọng nói gốc của thiết bị sẽ được sử dụng. Không cần tải xuống mô hình."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "将使用您设备的原生语音引擎。无需下载模型。"
          }
        }
