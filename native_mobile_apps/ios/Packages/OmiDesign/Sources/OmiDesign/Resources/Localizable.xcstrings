    "deleteMeetingScreenshotMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إزالة لقطة الشاشة من ملاحظة هذا الاجتماع. لا يمكن التراجع عن ذلك."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Здымак экрана будзе выдалены з нататкі гэтай сустрэчы. Гэта нельга адрабіць."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Екранната снимка ще бъде премахната от бележката за тази среща. Това не може да бъде отменено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি এই মিটিংয়ের নোট থেকে স্ক্রিনশটটি সরিয়ে দেবে। এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo uklanja snimak ekrana iz bilješke ovog sastanka. Ne može se poništiti."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això elimina la captura de pantalla de la nota d'aquesta reunió. No es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímek obrazovky bude odebrán z poznámky této schůzky. Tuto akci nelze vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner skærmbilledet fra mødets note. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bildschirmfoto wird aus der Notiz dieses Meetings entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το στιγμιότυπο οθόνης θα αφαιρεθεί από τη σημείωση αυτής της σύσκεψης. Δεν είναι δυνατή η αναίρεση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the screenshot from this meeting's note. It can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la captura de pantalla de la nota de esta reunión. No se puede deshacer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See eemaldab ekraanipildi selle koosoleku märkmest. Seda ei saa tagasi võtta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار اسکرین‌شات را از یادداشت این جلسه حذف می‌کند. قابل بازگشت نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvakaappaus poistetaan tämän kokouksen muistiinpanosta. Toimintoa ei voi kumota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capture d'écran sera retirée de la note de cette réunion. Cette action est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צילום המסך יוסר מהסיכום של הפגישה הזו. לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस मीटिंग के नोट से स्क्रीनशॉट हटा देगा। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo uklanja snimku zaslona iz bilješke ovog sastanka. Radnja se ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A képernyőkép törlődik a megbeszélés jegyzetéből. Ez nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus tangkapan layar dari catatan rapat ini. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo screenshot verrà rimosso dalla nota di questa riunione. L'operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このミーティングのメモからスクリーンショットを削除します。この操作は取り消せません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ಈ ಸಭೆಯ ಟಿಪ್ಪಣಿಯಿಂದ ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಅನ್ನು ತೆಗೆದುಹಾಕುತ್ತದೆ. ಇದನ್ನು ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 회의 노트에서 스크린샷이 삭제됩니다. 되돌릴 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrano kopija bus pašalinta iš šio susitikimo užrašo. Šio veiksmo anuliuoti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrānuzņēmums tiks noņemts no šīs sapulces piezīmes. To nevar atsaukt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова ја отстранува сликата од екранот од белешката на овој состанок. Не може да се врати."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यामुळे या मीटिंगच्या नोटमधून स्क्रीनशॉट काढला जाईल. हे पूर्ववत करता येणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan mengalih keluar tangkapan skrin daripada nota mesyuarat ini. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de schermafbeelding uit de notitie van deze vergadering verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner skjermbildet fra notatet for dette møtet. Det kan ikke angres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrzut ekranu zostanie usunięty z notatki tego spotkania. Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove a captura de tela da nota desta reunião. Não é possível desfazer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura de ecran va fi eliminată din nota acestei întâlniri. Acțiunea nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимок экрана будет удалён из заметки этой встречи. Это действие нельзя отменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímka obrazovky sa odstráni z poznámky tejto schôdzky. Túto akciu nie je možné vrátiť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem boste posnetek zaslona odstranili iz zapiska tega sestanka. Tega ni mogoče razveljaviti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ово уклања снимак екрана из белешке овог састанка. Не може се опозвати."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmbilden tas bort från anteckningen för det här mötet. Det går inte att ångra."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இந்தக் கூட்டத்தின் குறிப்பிலிருந்து திரைப்பிடிப்பை நீக்கும். இதைச் செயல்தவிர்க்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ఈ సమావేశం నోట్ నుండి స్క్రీన్‌షాట్‌ను తీసివేస్తుంది. దీన్ని రద్దు చేయలేరు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการนี้จะลบภาพหน้าจอออกจากบันทึกของการประชุมนี้ และไม่สามารถเลิกทำได้"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aalisin nito ang screenshot sa note ng meeting na ito. Hindi na ito maibabalik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem ekran görüntüsünü bu toplantının notundan kaldırır. Geri alınamaz."
