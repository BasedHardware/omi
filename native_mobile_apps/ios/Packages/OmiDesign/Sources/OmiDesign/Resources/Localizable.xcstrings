    "nativeBluetoothOff": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل Bluetooth واسمح لـ Omi باستخدامه."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключы Bluetooth і дазволь Omi яго выкарыстоўваць."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включи Bluetooth и разреши на Omi да го ползва."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth চালু করুন এবং Omi-কে ব্যবহারের অনুমতি দিন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključi Bluetooth i dozvoli aplikaciji Omi da ga koristi."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el Bluetooth i permet que Omi l'utilitzi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapni Bluetooth a povol Omi jeho použití."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Bluetooth til, og giv Omi lov til at bruge det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Bluetooth ein und erlaube Omi den Zugriff."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποίησε το Bluetooth και επίτρεψε τη χρήση του από το Omi."
