          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso al microfono nelle Impostazioni per registrare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音するには、設定でマイクへのアクセスを許可してください。"
