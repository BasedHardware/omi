          }
        }
      }
    },
    "nativeConnectAIChatGPTStep1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in ChatGPT die Einstellungen, dann Apps."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In ChatGPT, open Settings, then Apps."
          }
        }
      }
    },
    "nativeConnectAIChatGPTStep2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche nach Omi und tippe auf Verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search for Omi and tap Connect."
          }
        }
      }
    },
    "nativeConnectAIChatGPTStep3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit deinem Omi-Konto an und erlaube den Zugriff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with your Omi account and allow access."
          }
        }
      }
    },
    "nativeConnectAIClaudeStep1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere Omis Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Omi's address."
          }
        }
      }
    },
    "nativeConnectAIClaudeStep2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in Claude die Einstellungen, dann Konnektoren, und tippe auf Eigenen Konnektor hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Claude, open Settings, then Connectors, and tap Add custom connector."
          }
        }
      }
    },
    "nativeConnectAIClaudeStep3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenne ihn Omi, füge die Adresse ein und tippe auf Hinzufügen. Tippe dann auf Verbinden und erlaube den Zugriff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name it Omi, paste the address and tap Add. Then tap Connect and allow access."
          }
        }
      }
    },
    "nativeConnectAICopySetup": {
      "extractionState": "manual",
      "localizations": {
