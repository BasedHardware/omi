    "appleHealthFeatureSecureDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مزامنة بيانات Apple Health بخصوصية مع حسابك في Omi."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Даныя Apple Health прыватна сінхранізуюцца з акаўнтам Omi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Данните от Apple Health се синхронизират поверително с акаунта ви."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Apple Health ডেটা ব্যক্তিগতভাবে আপনার Omi অ্যাকাউন্টে সিঙ্ক হয়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši Apple Health podaci se privatno sinhroniziraju s vašim Omi računom."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves dades d'Apple Health se sincronitzen de forma privada amb el teu compte d'Omi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše data z Apple Health se soukromě synchronizují s účtem Omi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine Apple Health-data synkroniseres privat til din Omi-konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Apple Health-Daten werden privat mit deinem Omi-Konto synchronisiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δεδομένα Apple Health συγχρονίζονται ιδιωτικά στον λογαριασμό Omi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple Health data syncs privately to your Omi account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos de Apple Health se sincronizan de forma privada con tu cuenta de Omi."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teie Apple Health'i andmed sünkroonitakse privaatselt teie Omi kontoga."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های Apple Health شما به‌صورت خصوصی با حساب Omi همگام می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health -tietosi synkronoidaan yksityisesti Omi-tilillesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données Apple Health se synchronisent en privé avec votre compte Omi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתוני Apple Health שלך מסונכרנים באופן פרטי לחשבון Omi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका Apple Health डेटा निजी रूप से आपके Omi खाते से सिंक होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši Apple Health podaci sinkroniziraju se privatno s Omi računom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health-adataid bizalmasan szinkronizálódnak az Omi-fiókoddal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Apple Health Anda disinkronkan secara pribadi ke akun Omi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati Apple Health si sincronizzano privatamente con il tuo account Omi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health のデータは Omi アカウントに安全に同期されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ Apple Health ಡೇಟಾ ಖಾಸಗಿಯಾಗಿ ನಿಮ್ಮ Omi ಖಾತೆಗೆ ಸಿಂಕ್ ಆಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health 데이터는 비공개로 Omi 계정과 동기화됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų Apple Health duomenys privačiai sinchronizuojami su Omi paskyra."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu Apple Health dati privāti sinhronizējas ar Omi kontu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите Apple Health податоци приватно се синхронизираат со Omi сметката."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आपला Apple Health डेटा खासगीरित्या आपल्या Omi खात्याशी सिंक होतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Apple Health anda disegerakkan secara peribadi ke akaun Omi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Apple Health-gegevens synchroniseren privé naar je Omi-account."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health-dataene dine synkroniseres privat til Omi-kontoen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane z Apple Health prywatnie synchronizują się z kontem Omi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados do Apple Health sincronizam privadamente com sua conta Omi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele tale Apple Health se sincronizează privat cu contul tău Omi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные Apple Health приватно синхронизируются с вашим аккаунтом Omi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše údaje z Apple Health sa súkromne synchronizujú s účtom Omi."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši podatki Apple Health se zasebno sinhronizirajo z računom Omi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши Apple Health подаци се приватно синхронизују са Omi налогом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina Apple Health-data synkroniseras privat till ditt Omi-konto."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Apple Health தரவு உங்கள் Omi கணக்குடன் தனிப்பட்ட முறையில் ஒத்திசைக்கப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Apple Health డేటా ప్రైవేట్‌గా మీ Omi ఖాతాకు సమకాలీకరించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูล Apple Health ของคุณซิงค์อย่างเป็นส่วนตัวกับบัญชี Omi"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang iyong datos sa Apple Health ay pribadong sinisync sa iyong Omi account."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health verilerin Omi hesabına gizli şekilde senkronize edilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші дані Apple Health приватно синхронізуються з обліковим записом Omi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا Apple Health ڈیٹا نجی طور پر آپ کے Omi اکاؤنٹ کے ساتھ ہم وقت ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu Apple Health của bạn được đồng bộ riêng tư vào tài khoản Omi."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Apple Health 数据私密同步到您的 Omi 账户。"
          }
        }
      }
    },
