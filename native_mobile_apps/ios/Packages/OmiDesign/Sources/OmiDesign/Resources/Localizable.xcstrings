    "nativeIntroAsksFirst": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt dich immer zuerst: bezahlen, Nachrichten senden, alles, was sich nicht rückgängig machen lässt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always asks you first: paying, sending messages, anything that can't be undone"
          }
        }
      }
