    "voiceSettingsSaveOthersSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تسمّي شخصًا، يحتفظ Omi بعيّنة صوتية قصيرة ليتعرّف عليه في المرة القادمة"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі вы называеце кагосьці, Omi захоўвае кароткі ўзор голасу, каб пазнаць яго наступным разам"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Когато назовете някого, Omi пази кратък гласов образец, за да го разпознае следващия път"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কারও নাম দিলে, পরের বার চিনতে Omi একটি ছোট কণ্ঠস্বরের নমুনা রাখে"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada nekoga imenujete, Omi čuva kratak uzorak glasa kako bi ga sljedeći put prepoznao"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan anomenes algú, l’Omi guarda una mostra de veu breu per reconèixer-lo la propera vegada"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když někoho pojmenujete, Omi si uchová krátkou ukázku hlasu, aby ho příště poznal"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du navngiver nogen, gemmer Omi en kort stemmeprøve, så den kan genkende dem næste gang"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du jemanden benennst, speichert Omi eine kurze Stimmprobe, um die Person beim nächsten Mal zu erkennen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν ονομάζετε κάποιον, το Omi κρατά ένα σύντομο δείγμα φωνής για να τον αναγνωρίσει την επόμενη φορά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you name someone, Omi keeps a short voice sample so it can recognize them next time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando nombras a alguien, Omi guarda una breve muestra de voz para reconocerlo la próxima vez"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kui annad kellelegi nime, hoiab Omi alles lühikese häälenäidise, et teda järgmine kord ära tunda"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی کسی را نام‌گذاری می‌کنید، Omi یک نمونه کوتاه از صدا نگه می‌دارد تا دفعه بعد او را بشناسد"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun nimeät jonkun, Omi tallentaa lyhyen ääninäytteen tunnistaakseen hänet ensi kerralla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous nommez une personne, Omi conserve un court échantillon de sa voix pour la reconnaître la prochaine fois"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשאתם נותנים שם למישהו, Omi שומר דגימת קול קצרה כדי לזהות אותו בפעם הבאה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप किसी का नाम बताते हैं, तो अगली बार पहचानने के लिए Omi आवाज़ का एक छोटा नमूना रखता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kada nekoga imenujete, Omi čuva kratak uzorak glasa kako bi ga sljedeći put prepoznao"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha megnevezel valakit, az Omi egy rövid hangmintát tárol, hogy legközelebb felismerje"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Anda memberi nama seseorang, Omi menyimpan sampel suara singkat agar bisa mengenalinya lain kali"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando dai un nome a qualcuno, Omi conserva un breve campione vocale per riconoscerlo la prossima volta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かに名前を付けると、次回聞き分けられるようOmiが短い音声サンプルを保存します"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಯಾರಿಗಾದರೂ ಹೆಸರಿಸಿದಾಗ, ಮುಂದಿನ ಬಾರಿ ಗುರುತಿಸಲು Omi ಒಂದು ಚಿಕ್ಕ ಧ್ವನಿ ಮಾದರಿಯನ್ನು ಇಟ್ಟುಕೊಳ್ಳುತ್ತದೆ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가에게 이름을 붙이면, 다음에 알아볼 수 있도록 Omi가 짧은 음성 샘플을 보관해요"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kai ką nors pavadinate, Omi išsaugo trumpą balso pavyzdį, kad kitą kartą jį atpažintų"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad kādu nosaucat, Omi saglabā īsu balss paraugu, lai nākamreiz viņu atpazītu"
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кога ќе именувате некого, Omi чува краток примерок од гласот за да го препознае следниот пат"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही एखाद्याला नाव दिल्यावर, पुढच्या वेळी ओळखता यावे म्हणून Omi आवाजाचा एक छोटा नमुना ठेवतो"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila anda menamakan seseorang, Omi menyimpan sampel suara pendek supaya dapat mengenalinya lain kali"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je iemand een naam geeft, bewaart Omi een kort stemfragment om diegene de volgende keer te herkennen"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du navngir noen, lagrer Omi en kort stemmeprøve for å kjenne dem igjen neste gang"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy nazwiesz osobę, Omi zachowa krótką próbkę jej głosu, aby następnym razem ją rozpoznać"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você nomeia alguém, o Omi guarda uma pequena amostra de voz para reconhecer a pessoa da próxima vez"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când numești pe cineva, Omi păstrează o scurtă mostră de voce pentru a-l recunoaște data viitoare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы называете человека, Omi сохраняет короткий образец голоса, чтобы узнать его в следующий раз"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď niekoho pomenujete, Omi si uchová krátku ukážku hlasu, aby ho nabudúce spoznal"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko nekoga poimenujete, Omi shrani kratek vzorec glasu, da ga naslednjič prepozna"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Када некога именујете, Omi чува кратак узорак гласа да би га следећи пут препознао"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du namnger någon sparar Omi ett kort röstprov så att den känner igen personen nästa gång"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஒருவருக்குப் பெயரிடும்போது, அடுத்த முறை அடையாளம் காண Omi ஒரு சிறிய குரல் மாதிரியை வைத்திருக்கும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఎవరికైనా పేరు పెట్టినప్పుడు, తదుపరిసారి గుర్తించడానికి Omi ఒక చిన్న గొంతు నమూనాను ఉంచుకుంటుంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อคุณตั้งชื่อให้ใครสักคน Omi จะเก็บตัวอย่างเสียงสั้นๆ ไว้เพื่อจดจำเขาได้ในครั้งถัดไป"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapag pinangalanan mo ang isang tao, nagtatago ang Omi ng maikling sample ng boses para makilala siya sa susunod"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birine ad verdiğinde Omi, onu bir dahaki sefere tanıyabilmek için kısa bir ses örneği saklar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ви називаєте когось, Omi зберігає короткий зразок голосу, щоб наступного разу впізнати цю людину"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ کسی کا نام دیتے ہیں تو Omi اگلی بار پہچاننے کے لیے آواز کا ایک مختصر نمونہ رکھتا ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn đặt tên cho ai đó, Omi lưu một mẫu giọng ngắn để nhận ra họ vào lần sau"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "当你为某人命名时，Omi 会保留一小段声音样本，以便下次认出对方"
          }
        }
      }
    },
