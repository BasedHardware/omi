        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কাজগুলি গ্রহণ করা যায়নি। আপনি হয়তো আগেই এই শেয়ার গ্রহণ করেছেন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće prihvatiti ove zadatke. Možda ste već prihvatili ovo dijeljenje."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'han pogut acceptar aquestes tasques. Potser ja has acceptat aquesta compartició."
