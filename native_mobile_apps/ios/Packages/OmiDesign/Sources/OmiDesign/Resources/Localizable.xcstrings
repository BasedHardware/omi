    "payYourSttProvider": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجاني في Omi. تدفع لمزوّد النسخ مباشرةً."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У Omi гэта бясплатна. Вы плаціце свайму пастаўшчыку транскрыпцыі напрамую."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Безплатно в Omi. Плащате директно на вашия доставчик на транскрипция."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi-তে বিনামূল্যে। আপনি সরাসরি আপনার ট্রান্সক্রিপশন প্রদানকারীকে অর্থ দেন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Besplatno u Omiju. Transkripcijskom dobavljaču plaćate direktno."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuït a Omi. Pagues directament al proveïdor de transcripció."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V Omi zdarma. Poskytovateli přepisu platíte přímo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis i Omi. Du betaler din transskriptionsudbyder direkte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos in Omi. Du zahlst deinen Transkriptionsanbieter direkt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δωρεάν στο Omi. Πληρώνετε απευθείας τον πάροχο μεταγραφής σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free in Omi. You pay your transcription provider directly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis en Omi. Pagas directamente a tu proveedor de transcripción."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Omis on tasuta. Transkriptsiooni pakkujale maksad otse."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در Omi رایگان است. هزینه را مستقیماً به ارائه‌دهنده رونویسی می‌پردازید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi on ilmainen. Maksat transkriptiopalvelun tarjoajalle suoraan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit dans Omi. Vous payez directement votre fournisseur de transcription."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חינם ב-Omi. אתה משלם ישירות לספק התמלול שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi में मुफ़्त। आप अपने ट्रांसक्रिप्शन प्रदाता को सीधे भुगतान करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besplatno u Omi-ju. Pružatelju transkripcije plaćaš izravno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Omi-ban ingyenes. Az átíró szolgáltatódnak közvetlenül fizetsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis di Omi. Kamu membayar penyedia transkripsi secara langsung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis in Omi. Paghi direttamente il tuo fornitore di trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Omiは無料です。文字起こしプロバイダーにのみ直接料金を支払います。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ನಲ್ಲಿ ಉಚಿತ. ನೀವು ನಿಮ್ಮ ಟ್ರಾನ್ಸ್‌ಕ್ರಿಪ್ಷನ್ ಸೇವಾ ಪೂರೈಕೆದಾರರಿಗೆ ನೇರವಾಗಿ ಪಾವತಿಸುತ್ತೀರಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi는 무료예요. 받아쓰기 제공업체에 직접 비용을 내시면 돼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi yra nemokama. Už transkribavimą mokate tiesiogiai savo teikėjui."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ir bezmaksas. Transkribēšanas pakalpojumu sniedzējam maksājat tieši."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно во Omi. Директно му плаќате на вашиот добавувач за транскрипција."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi मध्ये मोफत. तुम्ही तुमच्या ट्रान्स्क्रिप्शन प्रदात्याला थेट पैसे देता."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Percuma dalam Omi. Anda membayar penyedia transkripsi anda secara terus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis in Omi. Je betaalt je transcriptieprovider rechtstreeks."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis i Omi. Du betaler transkripsjonstjenesten direkte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpłatne w Omi. Płacisz bezpośrednio swojemu dostawcy transkrypcji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis no Omi. Você paga diretamente ao seu provedor de transcrição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit în Omi. Plătești direct furnizorului de transcriere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Omi бесплатно. Оплата поставщику транскрибации напрямую."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V Omi je to zadarmo. Platíte priamo svojmu poskytovateľovi prepisu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi je brezplačen. Ponudniku transkripcije plačate neposredno vi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно у апликацији Omi. Плаћате директно свом добављачу транскрипције."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis i Omi. Du betalar din transkriptionsleverantör direkt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi-இல் இலவசம். எழுத்தாக்க வழங்குநருக்கு நேரடியாகப் பணம் செலுத்துவீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Omiలో ఉచితం. మీరు మీ ట్రాన్స్‌క్రిప్షన్ ప్రొవైడర్‌కు నేరుగా చెల్లిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟรีใน Omi คุณจ่ายให้ผู้ให้บริการถอดเสียงโดยตรง"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Libre sa Omi. Direkta mong binabayaran ang iyong transcription provider."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi'de ücretsiz. Transkripsiyon sağlayıcınıza doğrudan siz ödersiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовно в Omi. Ви платите провайдеру транскрибування напряму."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi میں مفت۔ آپ براہ راست اپنے ٹرانسکرپشن فراہم کنندہ کو ادائیگی کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miễn phí trong Omi. Bạn trả tiền trực tiếp cho nhà cung cấp chuyển giọng nói thành văn bản."
          }
        },
        "zh": {
