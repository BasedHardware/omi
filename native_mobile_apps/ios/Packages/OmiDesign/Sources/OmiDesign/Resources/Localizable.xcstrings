    "cancelReasonSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل يمكنك إخبارنا لماذا ستغادر؟"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можаце мне сказаць, чаму вы адыходзіце?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете ли да ни кажете защо напускате?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কেন যাচ্ছেন তা বলতে পারেন?"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete li nam reći zašto odlazite?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ens pots dir per què marxes?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete nám říct, proč odcházíte?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan du fortælle os, hvorfor du forlader?"
          }
        },
