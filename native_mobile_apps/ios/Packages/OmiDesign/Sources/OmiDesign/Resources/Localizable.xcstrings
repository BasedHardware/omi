    "appleHealthDeniedBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لدى Omi إذن لقراءة بيانات Apple Health الخاصة بك. فعّل ذلك من إعدادات iOS ← الخصوصية والأمان ← Health ← Omi."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У Omi няма дазволу на чытанне даных Apple Health. Уключыце яго ў Налады iOS → Прыватнасць і бяспека → Health → Omi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi няма разрешение да чете данните ви от Apple Health. Активирайте го в Настройки на iOS → Поверителност и сигурност → Health → Omi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi-র আপনার Apple Health ডেটা পড়ার অনুমতি নেই। iOS সেটিংস → Privacy & Security → Health → Omi-তে এটি সক্ষম করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nema dozvolu za čitanje vaših Apple Health podataka. Omogućite ga u iOS Postavke → Privatnost i sigurnost → Health → Omi."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi no té permís per llegir les teves dades d'Apple Health. Activa-ho a Configuració d'iOS → Privadesa i seguretat → Health → Omi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nemá oprávnění číst vaše data z Apple Health. Povolte ho v Nastavení iOS → Soukromí a zabezpečení → Health → Omi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi har ikke tilladelse til at læse dine Apple Health-data. Aktivér det i iOS-indstillinger → Anonymitet og sikkerhed → Health → Omi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi hat keine Berechtigung, deine Apple Health-Daten zu lesen. Aktiviere sie unter iOS Einstellungen → Datenschutz & Sicherheit → Health → Omi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Omi δεν έχει άδεια να διαβάσει τα δεδομένα σας Apple Health. Ενεργοποιήστε το στο Ρυθμίσεις iOS → Απόρρητο και ασφάλεια → Health → Omi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi doesn't have permission to read your Apple Health data. Enable it in iOS Settings → Privacy & Security → Health → Omi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi no tiene permiso para leer tus datos de Apple Health. Actívalo en Ajustes de iOS → Privacidad y seguridad → Salud → Omi."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Omil pole luba teie Apple Health'i andmete lugemiseks. Lubage see: iOS Seaded → Privaatsus ja turvalisus → Health → Omi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi مجوز خواندن داده‌های Apple Health شما را ندارد. آن را در تنظیمات iOS ← حریم خصوصی و امنیت ← Health ← Omi فعال کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omilla ei ole oikeutta lukea Apple Health -tietojasi. Ota se käyttöön: iOS-asetukset → Yksityisyys ja turvallisuus → Health → Omi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi n'a pas l'autorisation de lire vos données Apple Health. Activez-la dans Réglages iOS → Confidentialité et sécurité → Santé → Omi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל-Omi אין הרשאה לקרוא את נתוני Apple Health שלך. הפעל אותה בהגדרות iOS ← פרטיות ואבטחה ← Health ← Omi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi के पास आपका Apple Health डेटा पढ़ने की अनुमति नहीं है। iOS सेटिंग्स → गोपनीयता और सुरक्षा → Health → Omi में इसे सक्षम करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nema dozvolu za čitanje vaših Apple Health podataka. Omogućite ga u iOS Postavke → Privatnost i sigurnost → Health → Omi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ominak nincs engedélye az Apple Health-adataid olvasására. Engedélyezd: iOS Beállítások → Adatvédelem és biztonság → Health → Omi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi tidak memiliki izin untuk membaca data Apple Health Anda. Aktifkan di Pengaturan iOS → Privasi & Keamanan → Health → Omi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi non ha il permesso di leggere i tuoi dati di Apple Health. Attivalo in Impostazioni iOS → Privacy e sicurezza → Salute → Omi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi は Apple Health データを読み取る権限がありません。iOS の設定 → プライバシーとセキュリティ → ヘルスケア → Omi で有効にしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ಗೆ ನಿಮ್ಮ Apple Health ಡೇಟಾವನ್ನು ಓದುವ ಅನುಮತಿ ಇಲ್ಲ. iOS ಸೆಟ್ಟಿಂಗ್‌ಗಳು → ಗೌಪ್ಯತೆ ಮತ್ತು ಭದ್ರತೆ → Health → Omi ನಲ್ಲಿ ಇದನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi에 Apple Health 데이터를 읽을 권한이 없습니다. iOS 설정 → 개인정보 보호 및 보안 → 건강 → Omi에서 활성화하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi neturi leidimo skaityti jūsų Apple Health duomenis. Įjunkite: iOS Nustatymai → Privatumas ir sauga → Health → Omi."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nav atļaujas lasīt jūsu Apple Health datus. Iespējojiet: iOS Iestatījumi → Privātums un drošība → Health → Omi."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi нема дозвола да ги чита вашите Apple Health податоци. Овозможете го во iOS Поставки → Приватност и безбедност → Health → Omi."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi कडे आपला Apple Health डेटा वाचण्याची परवानगी नाही. iOS सेटिंग्ज → गोपनीयता आणि सुरक्षा → Health → Omi मध्ये ते सक्षम करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi tidak mempunyai kebenaran membaca data Apple Health anda. Dayakan di Tetapan iOS → Privasi & Keselamatan → Health → Omi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi heeft geen toestemming om je Apple Health-gegevens te lezen. Schakel het in via iOS-instellingen → Privacy en beveiliging → Gezondheid → Omi."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi har ikke tillatelse til å lese Apple Health-dataene dine. Slå det på i iOS-innstillinger → Personvern og sikkerhet → Helse → Omi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nie ma uprawnień do odczytu Twoich danych z Apple Health. Włącz to w Ustawienia iOS → Prywatność i bezpieczeństwo → Health → Omi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Omi não tem permissão para ler seus dados do Apple Health. Ative em Ajustes do iOS → Privacidade e Segurança → Saúde → Omi."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nu are permisiunea de a citi datele tale Apple Health. Activează din Setări iOS → Confidențialitate și securitate → Health → Omi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У Omi нет разрешения на чтение данных Apple Health. Включите его в Настройках iOS → Конфиденциальность и безопасность → Здоровье → Omi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nemá povolenie na čítanie vašich údajov Apple Health. Povoľte ho v Nastaveniach iOS → Súkromie a bezpečnosť → Health → Omi."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nima dovoljenja za branje vaših podatkov Apple Health. Omogočite ga v Nastavitvah iOS → Zasebnost in varnost → Health → Omi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi нема дозволу да чита ваше Apple Health податке. Омогућите га у iOS Подешавања → Приватност и безбедност → Health → Omi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi har inte behörighet att läsa dina Apple Health-data. Aktivera det i iOS-inställningar → Integritet och säkerhet → Hälsa → Omi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் Apple Health தரவைப் படிக்க Omi க்கு அனுமதி இல்லை. iOS அமைப்புகள் → தனியுரிமை & பாதுகாப்பு → Health → Omi இல் இதை இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi కి మీ Apple Health డేటాను చదవడానికి అనుమతి లేదు. iOS సెట్టింగ్‌లు → గోప్యత & భద్రత → Health → Omi లో దీన్ని ప్రారంభించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ไม่มีสิทธิ์อ่านข้อมูล Apple Health ของคุณ เปิดใช้งานในการตั้งค่า iOS → ความเป็นส่วนตัวและความปลอดภัย → Health → Omi"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang pahintulot ang Omi na basahin ang iyong Apple Health data. I-enable ito sa iOS Settings → Privacy & Security → Health → Omi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi'nin Apple Health verilerinizi okuma izni yok. Bunu iOS Ayarlar → Gizlilik ve Güvenlik → Sağlık → Omi yolundan etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi не має дозволу на читання даних Apple Health. Увімкніть це в Налаштування iOS → Конфіденційність і безпека → Здоров'я → Omi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi کو آپ کا Apple Health ڈیٹا پڑھنے کی اجازت نہیں ہے۔ اسے iOS ترتیبات ← پرائیویسی اور سیکیورٹی ← Health ← Omi میں فعال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi không có quyền đọc dữ liệu Apple Health của bạn. Bật tính năng này trong Cài đặt iOS → Quyền riêng tư & Bảo mật → Sức khỏe → Omi."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi 没有读取您的 Apple Health 数据的权限。请在 iOS 设置 → 隐私与安全性 → 健康 → Omi 中启用。"
          }
        }
      }
    },
