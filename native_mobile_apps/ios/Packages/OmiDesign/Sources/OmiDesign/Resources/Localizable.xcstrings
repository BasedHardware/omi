        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Bluetooth y permite que Omi lo use."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lülita Bluetooth sisse ja luba Omil seda kasutada."
