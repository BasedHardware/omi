    "deleteSampleConfirmation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة عيّنة صوت %1$@. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Узор голасу %1$@ будзе выдалены. Гэта нельзя адмяніць."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Гласовата проба на %1$@ ще бъде премахната. Това действие не може да бъде отменено."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-এর ভয়েস স্যাম্পল সরানো হবে। এটি পূর্বাবস্থায় ফিরিয়ে আনা যায় না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzorak glasa osobe %1$@ bit će uklonjen. Ovo se ne može poništiti."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Se suprimirà la mostra de veu de %1$@. Això no es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasový vzorek osoby %1$@ bude odstraněn. Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@s stemmeprøve fjernes. Dette kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stimmprobe von %1$@ wird entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το δείγμα φωνής για %1$@ θα αφαιρεθεί. Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@'s voice sample is removed. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará la muestra de voz de %1$@. Esta acción no se puede deshacer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Isiku %1$@ häälenäidis eemaldatakse. Seda ei saa tagasi võtta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمونه صدای %1$@ حذف می‌شود. این کار قابل بازگشت نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Henkilön %1$@ ääninäyte poistetaan. Tätä ei voi perua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'échantillon vocal de %1$@ sera supprimé. Cette action est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דגימת הקול של %1$@ תוסר. לא ניתן לבטל זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ का आवाज़ नमूना हटा दिया जाएगा। यह पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzorak glasa osobe %1$@ bit će uklonjen. Ovo se ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hangmintája törlődik. Ez nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampel suara %1$@ akan dihapus. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il campione vocale di %1$@ verrà rimosso. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@さんの音声サンプルが削除されます。この操作は元に戻せません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ಅವರ ಧ್ವನಿ ಮಾದರಿಯನ್ನು ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ. ಇದನ್ನು ರದ್ದು ಮಾಡಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@님의 음성 샘플이 삭제됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Asmens %1$@ balso pavyzdys bus pašalintas. Šio veiksmo negalima atšaukti."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Personas %1$@ balss paraugs tiks noņemts. To nevar atsaukt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гласовниот примерок на %1$@ ќе биде отстранет. Ова не може да се врати."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ यांचा आवाजाचा नमुना काढला जाईल. हे पूर्ववत करता येणार नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampel suara %1$@ akan dialih keluar. Tindakan ini tidak boleh dibatalkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De stemsample van %1$@ wordt verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmeprøven til %1$@ fjernes. Dette kan ikke angres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbka głosu osoby %1$@ zostanie usunięta. Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A amostra de voz de %1$@ será removida. Isso não pode ser desfeito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra vocală a persoanei %1$@ va fi eliminată. Această acțiune nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Образец голоса %1$@ будет удалён. Это действие нельзя отменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasová vzorka osoby %1$@ bude odstránená. Túto akciu nie je možné vrátiť späť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasovni vzorec osebe %1$@ bo odstranjen. Tega ni mogoče razveljaviti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Узорак гласа особе %1$@ биће уклоњен. Ово не може бити опозвано."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@s röstprov tas bort. Detta kan inte ångras."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ இன் குரல் மாதிரி நீக்கப்படும். இதை செயல்ரத்து செய்ய முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ వాయిస్ నమూనా తొలగించబడుతుంది. ఇది రిసెట్ చేయబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวอย่างเสียงของ %1$@ จะถูกลบ การดำเนินการนี้ไม่สามารถยกเลิกได้"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aalisin ang voice sample ni %1$@. Hindi ito maaaring bawiin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ adlı kişinin ses örneği kaldırılır. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зразок голосу %1$@ буде видалено. Цю дію неможливо скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ کا آواز کا نمونہ ہٹا دیا جائے گا۔ یہ کالعدم نہیں ہو سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẫu giọng nói của %1$@ sẽ bị xóa. Hành động này không thể hoàn tác."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的声音样本将被删除。此操作无法撤销。"
          }
        }
