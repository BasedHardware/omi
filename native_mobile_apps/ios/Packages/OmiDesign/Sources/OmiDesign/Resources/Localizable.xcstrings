    "cleanUpNothingMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi متأكد من الجميع حاليًا."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Цяпер Omi ва ўсіх упэўнены."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В момента Omi е сигурен за всички."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন Omi কারও সম্পর্কে অনিশ্চিত নয়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi trenutno ni u koga nije nesiguran."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara mateix Omi no dubta de ningú."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi si teď není u nikoho nejisté."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi er ikke usikker på nogen lige nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ist gerade bei niemandem unsicher."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Omi δεν έχει αμφιβολίες για κανέναν αυτή τη στιγμή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi isn't unsure about anyone right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi no tiene dudas sobre nadie ahora mismo."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ei ole praegu kellegi suhtes kahtlev."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi فعلاً درباره هیچ‌کس مطمئن نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ei ole tällä hetkellä epävarma kenestäkään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi n'a de doute sur personne pour l'instant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כרגע Omi בטוח לגבי כולם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi को अभी किसी के बारे में संदेह नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi trenutno nema nedoumica ni oko koga."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi jelenleg senkiben sem bizonytalan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi sedang tidak ragu soal siapa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento Omi è sicuro di tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、Omiが自信のない人はいません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈಗ Omi ಗೆ ಯಾರ ಬಗ್ಗೆಯೂ ಅನುಮಾನವಿಲ್ಲ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 Omi가 확신하지 못하는 사람이 없어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi šiuo metu dėl nieko neabejoja."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pašlaik Omi nav šaubu ne par vienu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi моментално не е несигурен за никого."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सध्या Omi ला कोणाबद्दलही शंका नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi tidak ragu tentang sesiapa sekarang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi is op dit moment over niemand onzeker."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi er ikke usikker på noen akkurat nå."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi na razie nie ma wątpliwości co do nikogo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi não tem dúvida sobre ninguém no momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Momentan Omi nu are dubii despre nimeni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас Omi ни в ком не сомневается."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi teraz o nikom nepochybuje."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi trenutno ni negotov glede nikogar."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi тренутно није несигуран ни у кога."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi är inte osäker på någon just nu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது யாரைப் பற்றியும் Omi-க்கு உறுதியின்மை இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుతం ఎవరి గురించీ Omiకి సందేహం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ Omi ไม่มีคนที่ไม่แน่ใจ"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa ngayon, sigurado si Omi sa lahat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi şu anda hiç kimse konusunda kararsız değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наразі Omi не сумнівається ні в кому."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi کو ابھی کسی کے بارے میں شک نہیں ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
