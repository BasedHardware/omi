    "nativeVoiceNotSavedBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيل ما زال موجودًا. حاول مرة أخرى أو أعدّه لاحقًا في الإعدادات."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Запіс усё яшчэ тут. Паспрабуй яшчэ раз або наладзь пазней у Наладах."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Записът още е тук. Опитай пак или го настрой по-късно в Настройки."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং এখনও আছে। আবার চেষ্টা করুন, বা পরে সেটিংসে সেট আপ করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimak je još tu. Pokušaj ponovo ili podesi kasnije u Postavkama."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrament encara hi és. Torna-ho a provar o configura-ho més tard a Configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávka tu pořád je. Zkus to znovu, nebo to nastav později v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optagelsen er her stadig. Prøv igen, eller sæt den op senere i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme ist noch da. Versuch es nochmal oder richte es später in den Einstellungen ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ηχογράφηση είναι ακόμα εδώ. Δοκίμασε ξανά ή ρύθμισέ το αργότερα στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording is still here. Try again, or set it up later in Settings."
          }
