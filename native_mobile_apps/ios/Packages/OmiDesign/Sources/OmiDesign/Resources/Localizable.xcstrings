    "captureEveryMoment": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل Omi محادثاتك ويكتب لك الملخص\nوالمهام."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi запісвае вашыя размовы і\nсклада для вас рэзюме і спіс спраў."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi записва вашите разговори и пише вместо вас\nрезюмето и задачите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi আপনার কথোপকথন রেকর্ড করে\nআপনার জন্য সারাংশ ও করণীয় তালিকা লিখে দেয়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi snima vaše razgovore i za vas\npiše sažetak i obaveze."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi grava les teves converses i escriu\nel resum i les tasques per a tu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nahrává vaše konverzace a za vás\nsepíše shrnutí a úkoly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi optager dine samtaler og skriver\nresuméet og opgaverne for dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi zeichnet deine Gespräche auf und schreibt\ndir die Zusammenfassung und To-dos."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Omi καταγράφει τις συνομιλίες σας και γράφει\nγια εσάς την περίληψη και τις εργασίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi records your conversations and writes\nthe summary and to-dos for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi graba tus conversaciones y escribe\nel resumen y las tareas por ti."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi salvestab su vestlused ja kirjutab sinu eest\nkokkuvõtte ja ülesanded."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi گفتگوهای شما را ضبط می‌کند و\nخلاصه و کارهایشان را برای شما می‌نویسد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nauhoittaa keskustelusi ja kirjoittaa\nsinulle yhteenvedon ja tehtävät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi enregistre vos conversations et rédige\npour vous le résumé et les tâches."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi מקליט את השיחות שלך וכותב\nעבורך את הסיכום והמשימות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi आपकी बातचीत रिकॉर्ड करता है और आपके लिए\nसारांश और काम की सूची लिखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi snima vaše razgovore i za vas piše\nsažetak i zadatke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Omi rögzíti a beszélgetéseidet, és elkészíti\nhelyetted az összefoglalót és a teendőket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi merekam percakapanmu dan menulis\nringkasan serta tugas untukmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi registra le tue conversazioni e scrive\nper te il riepilogo e le cose da fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Omiが会話を記録し、\n要約とタスクを作成します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ನಿಮ್ಮ ಸಂವಾದಗಳನ್ನು ರೆಕಾರ್ಡ್ ಮಾಡುತ್ತದೆ ಮತ್ತು\nನಿಮಗಾಗಿ ಸಾರಾಂಶ ಮತ್ತು ಮಾಡಬೇಕಾದವುಗಳನ್ನು ಬರೆಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi가 대화를 기록하고 요약과 할 일을\n대신 작성해 드려요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi įrašo jūsų pokalbius ir už jus parašo\nsantrauką ir darbus."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ieraksta jūsu sarunas un jums sagatavo\nkopsavilkumu un uzdevumus."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ги снима вашите разговори и ги пишува\nрезимеа и задачите за вас."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi तुमची संभाषणे रेकॉर्ड करते आणि\nतुमच्यासाठी सारांश व कामांची यादी लिहिते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi merakam perbualan anda dan menulis\nringkasan dan tugasan untuk anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi neemt je gesprekken op en schrijft\nvoor jou de samenvatting en to-do's."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi tar opp samtalene dine og skriver\nsammendraget og oppgavene for deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nagrywa Twoje rozmowy i za Ciebie pisze\npodsumowanie oraz zadania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Omi grava suas conversas e escreve\no resumo e as tarefas para você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi îți înregistrează conversațiile și scrie\nrezumatul și sarcinile pentru tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi записывает ваши разговоры и\nсам составляет резюме и список дел."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi zaznamenáva vaše konverzácie a za vás píše\nzhrnutie a úlohy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi snema vaše pogovore in za vas napiše\npovzetek in opravila."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi бележи ваше разговоре и уместо вас\nпише резиме и задатке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi spelar in dina samtal och skriver\nsammanfattningen och uppgifterna åt dig."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi உங்கள் உரையாடல்களைப் பதிவுசெய்து, உங்களுக்காக\nசுருக்கத்தையும் பணிகளையும் எழுதுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi మీ సంభాషణలను రికార్డ్ చేసి, మీ కోసం\nసారాంశం మరియు చేయవలసిన పనులను రాస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi บันทึกการสนทนาของคุณและ\nเขียนสรุปและสิ่งที่ต้องทำให้คุณ"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nire-record ng Omi ang iyong mga conversation at isinusulat\nang buod at to-do para sa iyo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi konuşmalarınızı kaydeder ve sizin için\nözeti ve yapılacakları yazar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi записує ваші розмови та за вас\nскладає підсумок і завдання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi آپ کی بات چیتیں ریکارڈ کرتا ہے اور آپ کے لیے\nخلاصہ اور کرنے کے کام لکھتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ghi lại các cuộc trò chuyện của bạn và tự viết\nbản tóm tắt và việc cần làm cho bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi 会记录您的对话，\n并为您生成摘要和待办事项。"
          }
        }
      }
    },
