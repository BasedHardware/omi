    "appleHealthFeatureChatDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسأل Omi عن خطواتك ونومك ومعدل ضربات قلبك وتمارينك."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пытайцеся ў Omi пра крокі, сон, пульс і трэніроўкі."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Питайте Omi за стъпките, съня, сърдечния ритъм и тренировките."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi-কে আপনার পদক্ষেপ, ঘুম, হৃদস্পন্দন ও ব্যায়াম সম্পর্কে জিজ্ঞাসা করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitajte Omi o vašim koracima, snu, otkucajima srca i treninzima."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a Omi sobre els teus passos, son, freqüència cardíaca i entrenaments."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeptejte se Omi na své kroky, spánek, tepovou frekvenci a tréninky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørg Omi om dine skridt, søvn, puls og træninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage Omi nach deinen Schritten, deinem Schlaf, deiner Herzfrequenz und deinen Workouts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρωτήστε το Omi για τα βήματα, τον ύπνο, τον καρδιακό ρυθμό και τις προπονήσεις σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Omi about your steps, sleep, heart rate, and workouts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a Omi sobre tus pasos, sueño, frecuencia cardíaca y entrenamientos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Küsi Omilt oma sammude, une, pulsi ja treeningute kohta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از Omi درباره قدم‌ها، خواب، ضربان قلب و تمرین‌های خود بپرسید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysy Omilta askelista, unesta, sykkeestä ja harjoituksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à Omi vos pas, votre sommeil, votre fréquence cardiaque et vos entraînements."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שאל את Omi על הצעדים, השינה, הדופק והאימונים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi से अपने कदम, नींद, हृदय गति और वर्कआउट के बारे में पूछें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitajte Omi o svojim koracima, snu, otkucajima srca i treninzima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérdezd az Omit a lépéseidről, alvásodról, pulzusodról és edzéseidről."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanyakan pada Omi tentang langkah, tidur, detak jantung, dan latihan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi a Omi dei tuoi passi, sonno, frequenza cardiaca e allenamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歩数、睡眠、心拍数、ワークアウトについて Omi に質問できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ಯೊಂದಿಗೆ ಹೆಜ್ಜೆಗಳು, ನಿದ್ರೆ, ಹೃದಯ ಬಡಿತ ಮತ್ತು ವ್ಯಾಯಾಮಗಳ ಬಗ್ಗೆ ಕೇಳಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걸음 수, 수면, 심박수, 운동에 대해 Omi에게 물어보세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Klauskite Omi apie žingsnius, miegą, pulsą ir treniruotes."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jautājiet Omi par saviem soļiem, miegu, sirdsdarbību un treniņiem."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прашајте го Omi за вашите чекори, сон, срцев ритам и тренинзи."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ला आपल्या पावले, झोप, हृदय गती आणि वर्कआउट्सबद्दल विचारा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanyakan Omi tentang langkah, tidur, kadar jantung dan latihan anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag Omi over je stappen, slaap, hartslag en workouts."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør Omi om skritt, søvn, puls og treningsøkter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj Omi o Twoje kroki, sen, tętno i treningi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte ao Omi sobre seus passos, sono, frequência cardíaca e treinos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întreabă Omi despre pașii, somnul, ritmul cardiac și antrenamentele tale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивайте Omi о ваших шагах, сне, пульсе и тренировках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pýtajte sa Omi na kroky, spánok, tep a tréningy."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vprašajte Omi o vaših korakih, spanju, srčnem utripu in treningih."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Питајте Omi о корацима, сну, откуцајима срца и тренинзима."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga Omi om dina steg, sömn, puls och träningspass."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi இடம் உங்கள் படிகள், தூக்கம், இதயத் துடிப்பு, உடற்பயிற்சிகள் பற்றி கேளுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ను మీ అడుగులు, నిద్ర, గుండె రేటు మరియు వర్కవుట్‌ల గురించి అడగండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถาม Omi เกี่ยวกับก้าว การนอน อัตราการเต้นของหัวใจ และการออกกำลังกายของคุณ"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanungin ang Omi tungkol sa iyong hakbang, tulog, tibok ng puso, at mga ehersisyo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adımların, uykun, kalp atışın ve antrenmanların hakkında Omi'ye sor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитайте Omi про кроки, сон, пульс і тренування."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi سے اپنے قدم، نیند، دل کی دھڑکن اور ورزشوں کے بارے میں پوچھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏi Omi về số bước, giấc ngủ, nhịp tim và bài tập của bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "向 Omi 询问你的步数、睡眠、心率和锻炼。"
          }
        }
      }
    },
