    "nativeDeletePersonMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سينسى Omi عينات صوته. ستبقى محادثاتك. لا يمكن التراجع عن ذلك."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi забудзе ўзоры голасу. Твае размовы застануцца. Гэта нельга адрабіць."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ще забрави гласовите мостри. Разговорите ти остават. Това не може да се отмени."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi তাঁর ভয়েস নমুনা ভুলে যাবে। তোমার কথোপকথন থেকে যাবে। এটি আর ফেরানো যাবে না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi zaboravlja uzorke glasa. Tvoji razgovori ostaju. Ovo se ne može poništiti."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi oblidarà les seves mostres de veu. Les teves converses es mantenen. No es pot desfer."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi zapomene vzorky hlasu. Tvoje konverzace zůstanou. Tuto akci nelze vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi glemmer personens stemmeprøver. Dine samtaler bliver. Det kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi vergisst die Stimmproben. Deine Gespräche bleiben. Das lässt sich nicht rückgängig machen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Omi ξεχνά τα δείγματα φωνής του. Οι συζητήσεις σου μένουν. Δεν μπορεί να αναιρεθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi forgets their voice samples. Your conversations stay. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi olvida sus muestras de voz. Tus conversaciones se quedan. No se puede deshacer."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi unustab nende häälenäidised. Sinu vestlused jäävad alles. Seda ei saa tagasi võtta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi نمونه‌های صدای او را فراموش می‌کند. گفتگوهای تو می‌مانند. این کار برگشت‌پذیر نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi unohtaa heidän ääninäytteensä. Keskustelusi säilyvät. Tätä ei voi perua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi oublie ses échantillons de voix. Tes conversations restent. Cette action est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi שוכח את דגימות הקול שלו. השיחות שלך נשארות. אי אפשר לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi उनके आवाज़ के नमूने भूल जाता है। तुम्हारी बातचीतें रहेंगी। इसे पलटा नहीं जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi zaboravlja uzorke njihova glasa. Tvoji razgovori ostaju. Ovo se ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Omi elfelejti a hangmintáikat. A beszélgetéseid megmaradnak. Ez nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi melupakan sampel suara mereka. Percakapanmu tetap ada. Ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi dimentica i suoi campioni vocali. Le tue conversazioni restano. Non si può annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Omiはこの人の声のサンプルを忘れます。会話は残ります。この操作は取り消せません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ಅವರ ಧ್ವನಿ ಮಾದರಿಗಳನ್ನು ಮರೆಯುತ್ತದೆ. ನಿಮ್ಮ ಸಂಭಾಷಣೆಗಳು ಉಳಿಯುತ್ತವೆ. ಇದನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi가 이 사람의 음성 샘플을 잊어요. 대화는 그대로 남아요. 되돌릴 수 없어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi pamiršta jų balso pavyzdžius. Tavo pokalbiai lieka. Šio veiksmo atšaukti negalima."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi aizmirst viņu balss paraugus. Tavas sarunas paliek. To nevar atsaukt."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ги заборава нивните гласовни примероци. Разговорите остануваат. Ова не може да се врати."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi त्यांचे आवाजाचे नमुने विसरते. तुमची संभाषणे राहतात. हे पूर्ववत करता येत नाही."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi melupakan sampel suara mereka. Perbualan anda kekal. Ini tidak boleh dibuat asal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi vergeet hun stemsamples. Je gesprekken blijven. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi glemmer stemmeprøvene deres. Samtalene dine blir værende. Dette kan ikke angres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi zapomni próbki głosu tej osoby. Twoje rozmowy zostaną. Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Omi esquece as amostras de voz da pessoa. Suas conversas ficam. Isso não pode ser desfeito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi uită mostrele vocii lor. Conversațiile tale rămân. Nu se poate anula."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi забудет образцы голоса. Твои разговоры останутся. Это нельзя отменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi zabudne ukážky ich hlasu. Tvoje konverzácie zostanú. Nedá sa to vrátiť späť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi pozabi vzorce njihovega glasu. Tvoji pogovori ostanejo. Tega ni mogoče razveljaviti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi заборавља узорке њиховог гласа. Твоји разговори остају. Ово се не може поништити."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi glömmer deras röstprover. Dina samtal finns kvar. Det går inte att ångra."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவர்களின் குரல் மாதிரிகளை Omi மறந்துவிடும். உன் உரையாடல்கள் இருக்கும். இதைத் திரும்பப் பெற முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi వారి వాయిస్ శాంపిల్స్‌ను మరచిపోతుంది. నీ సంభాషణలు అలాగే ఉంటాయి. దీన్ని రద్దు చేయలేము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi จะลืมตัวอย่างเสียงของเขา บทสนทนาของคุณยังอยู่ ย้อนกลับไม่ได้"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kakalimutan ng Omi ang mga voice sample niya. Mananatili ang mga usapan mo. Hindi na ito mababawi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi onların ses örneklerini unutur. Konuşmaların kalır. Bu geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi забуде зразки голосу цієї людини. Ваші розмови залишаться. Цю дію не можна скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ان کی آواز کے نمونے بھول جائے گا۔ آپ کی گفتگو برقرار رہے گی۔ یہ واپس نہیں ہو سکتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi sẽ quên các mẫu giọng của họ. Các cuộc trò chuyện của bạn vẫn còn. Không thể hoàn tác."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi 会忘记他们的声音样本。你的对话会保留。此操作无法撤销。"
          }
        }
      }
    },
