    "locationAccessDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليتمكن Omi من تسجيل مكان حدوث محادثاتك."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Каб Omi мог адзначаць, дзе адбываліся вашы размовы."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да може Omi да отбелязва къде са се провели разговорите ви."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাতে Omi আপনার কথোপকথন কোথায় হয়েছে তা লিখে রাখতে পারে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Da bi Omi mogao zabilježiti gdje su se vaši razgovori odvijali."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Perquè l'Omi pugui anotar on han tingut lloc les teves converses."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby Omi mohl zaznamenat, kde vaše konverzace probíhaly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Så Omi kan notere, hvor dine samtaler fandt sted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit Omi festhalten kann, wo deine Gespräche stattgefunden haben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ώστε το Omi να σημειώνει πού έγιναν οι συνομιλίες σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So Omi can note where your conversations happened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que Omi anote dónde tuvieron lugar tus conversaciones."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Et Omi saaks märkida, kus sinu vestlused toimusid."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا Omi بتواند محل انجام گفتگوهایتان را ثبت کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotta Omi voi merkitä, missä keskustelusi käytiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour qu'Omi puisse noter où ont eu lieu vos conversations."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי ש-Omi יוכל לציין איפה התקיימו השיחות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ताकि Omi नोट कर सके कि आपकी बातचीत कहाँ हुई।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako bi Omi mogao zabilježiti gdje su se vaši razgovori odvijali."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hogy az Omi feljegyezhesse, hol zajlottak a beszélgetéseid."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agar Omi dapat mencatat di mana percakapan Anda terjadi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così Omi può annotare dove si sono svolte le tue conversazioni."
          }
        },
        "ja": {
          "stringUnit": {
