    "nativeIntroVoicesBody": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimme erscheint als Du. Andere starten als Sprecher 1 oder 2. Omi fragt einmal, wer das war, und erkennt sie ab dann wieder. So landen Aufgaben und Erinnerungen bei der richtigen Person."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice shows as You. Others start as Speaker 1 or 2. Omi asks once who it was and recognizes them from then on, so tasks and memories land with the right person."
          }
        }
      }
    },
    "nativeIntroVoicesTitle": {
      "extractionState": "manual",
