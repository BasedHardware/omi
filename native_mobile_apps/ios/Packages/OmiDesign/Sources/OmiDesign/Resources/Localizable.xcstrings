        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você atingiu seu limite mensal. Atualize para continuar conversando com Omi sem restrições."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai atins limita lunară. Fă upgrade pentru a continua să discuți cu Omi fără restricții."
