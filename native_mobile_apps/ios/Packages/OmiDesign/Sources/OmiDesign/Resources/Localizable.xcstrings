    "mergeConversationsMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى دمج %1$@ محادثة في واحدة. سيتم دمج وإعادة إنشاء جميع المحتويات."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта аб'яднае %1$@ размоў у адну. Усё змесціва будзе аб'яднана і перагенеравана."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това ще комбинира %1$@ разговора в един. Всичко съдържание ще бъде обединено и регенерирано."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি %1$@ টি কথোপকথনকে একটিতে একত্রিত করবে। সমস্ত বিষয়বস্তু মার্জ এবং পুনরায় তৈরি করা হবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo će kombinovati %1$@ razgovora u jedan. Sav sadržaj će biti spojen i regenerisan."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Això combinarà %1$@ converses en una. Tot el contingut es fusionarà i regenerarà."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se spojí %1$@ konverzací do jedné. Veškerý obsah bude sloučen a znovu vygenerován."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil kombinere %1$@ samtaler til én. Alt indhold vil blive flettet og regenereret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies wird %1$@ Unterhaltungen zu einer zusammenfassen. Alle Inhalte werden zusammengeführt und neu generiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό θα συνδυάσει %1$@ συνομιλίες σε μία. Όλο το περιεχόμενο θα συγχωνευτεί και θα αναδημιουργηθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will combine %1$@ conversations into one. All content will be merged and regenerated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto combinará %1$@ conversaciones en una sola. Todo el contenido se fusionará y regenerará."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See ühendab %1$@ vestlust üheks. Kogu sisu ühendatakse ja luuakse uuesti."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این %1$@ گفتگو را در یکی ادغام خواهد کرد. تمام محتوا ادغام و دوباره تولید خواهد شد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä yhdistää %1$@ keskustelua yhdeksi. Kaikki sisältö yhdistetään ja luodaan uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela combinera %1$@ conversations en une seule. Tout le contenu sera fusionné et régénéré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תשלב %1$@ שיחות לאחת. כל התוכן יוזג ויוחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह %1$@ बातचीतों को एक में मिला देगा। सभी सामग्री विलय और पुन: उत्पन्न की जाएगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo će kombinirati %1$@ razgovora u jedan. Sav sadržaj će biti spojen i ponovno generiran."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez %1$@ beszélgetést egyesít egybe. Minden tartalom összevonásra és újragenerálásra kerül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menggabungkan %1$@ percakapan menjadi satu. Semua konten akan digabungkan dan dibuat ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo combinerà %1$@ conversazioni in una. Tutti i contenuti saranno uniti e rigenerati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@件の会話が1つにまとめられます。すべてのコンテンツがマージされ、再生成されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು %1$@ ಸಂವಾದನ್ನು ಒಂದಾಗಿ ಸಂಯೋಜಿಸುತ್ತದೆ. ಎಲ್ಲಾ ವಿಷಯವಸ್ತುಗಳು ಮರ್ಜ್ ಮತ್ತು ಪುನರ್ನಿರ್ಮಾಣ ಮಾಡಲಾಗುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@개의 대화를 하나로 결합합니다. 모든 내용이 병합되고 재생성됩니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bus sujungti %1$@ pokalbiai į vieną. Visas turinys bus sujungtas ir iš naujo sugeneruotas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tas apvienos %1$@ sarunas vienā. Viss saturs tiks apvienots un ģenerēts no jauna."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ово ќе ги спои %1$@ разговори во еден. Сва содржина ќе биде спојена и регенерирана."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "यामुळे %1$@ संभाषण एकात विलीन होतील. सर्व सामग्री विलीन आणि पुनः निर्मित केली जाईल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menggabungkan %1$@ perbualan menjadi satu. Semua kandungan akan digabungkan dan dijana semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit combineert %1$@ gesprekken tot één. Alle inhoud wordt samengevoegd en opnieuw gegenereerd."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil kombinere %1$@ samtaler til én. Alt innhold vil bli slått sammen og regenerert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to połączenie %1$@ rozmów w jedną. Cała zawartość zostanie scalone i wygenerowana ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso combinará %1$@ conversas em uma. Todo o conteúdo será mesclado e regenerado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta va combina %1$@ conversații într-una singură. Tot conținutul va fi combinat și regenerat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это объединит %1$@ разговоров в один. Всё содержимое будет объединено и перегенерировано."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zlúči %1$@ konverzácií do jednej. Celý obsah bude zlúčený a znovu vygenerovaný."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To bo %1$@ pogovorov kombiniralo v enega. Vsa vsebina bo združena in regenerirana."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ово ће комбиновати %1$@ разговора у један. Сав садржај ће бити спојен и регенерисан."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta kommer att kombinera %1$@ konversationer till en. Allt innehåll kommer att slås ihop och genereras på nytt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது %1$@ உரையாடல்களை ஒன்றாக ஒருங்கிணைக்கும். அனைத்து உள்ளடக்கம் ஒருங்கிணைக்கப்பட்டு மீண்டும் உருவாக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది %1$@ సంభాషణలను ఒకటిగా కలిపిస్తుంది. అన్ని కంటెంట్ విలీనం చేయబడుతుంది మరియు పునర్నిర్మించబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่จะรวม %1$@ บทสนทนาเป็นหนึ่งเดียว เนื้อหาทั้งหมดจะถูกรวมและสร้างใหม่"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ito ay pagsasama ng %1$@ pag-uusap sa isa. Lahat ng nilalaman ay pagsasama at muling bubuo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem %1$@ konuşmayı birleştirecek. Tüm içerik birleştirilecek ve yeniden oluşturulacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це об'єднає %1$@ розмов в одну. Весь вміст буде об'єднано та перегенеровано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ %1$@ بات چیتوں کو ایک میں ملاتا ہے۔ تمام مواد ملایا اور دوبارہ تیار کیا جائے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ kết hợp %1$@ cuộc trò chuyện thành một. Tất cả nội dung sẽ được gộp và tạo lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这将把 %1$@ 个对话合并为一个。所有内容将被合并并重新生成。"
          }
        }
      }
    },
