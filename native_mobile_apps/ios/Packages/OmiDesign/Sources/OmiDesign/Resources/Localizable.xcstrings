    "exportingAllData": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تصدير بياناتك… أبقِ Omi مفتوحًا؛ فالحسابات الكبيرة قد تستغرق عدة دقائق."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспарт вашых даных… Не закрывайце Omi; вялікія ўліковыя запісы могуць патрабаваць некалькі хвілін."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Експортиране на вашите данни… Не затваряйте Omi; при големи акаунти може да отнеме няколко минути."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ডেটা রপ্তানি করা হচ্ছে… Omi খোলা রাখুন; বড় অ্যাকাউন্টের ক্ষেত্রে কয়েক মিনিট লাগতে পারে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvoz vaših podataka… Držite Omi otvorenim; veliki računi mogu potrajati nekoliko minuta."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'estan exportant les teves dades… No tanquis Omi; els comptes grans poden trigar diversos minuts."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportují se vaše data… Nechejte Omi otevřené; u velkých účtů to může trvat několik minut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksporterer dine data… Hold Omi åben; store konti kan tage flere minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten werden exportiert… Lass Omi geöffnet; bei großen Konten kann das mehrere Minuten dauern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξαγωγή των δεδομένων σας… Κρατήστε το Omi ανοιχτό· οι μεγάλοι λογαριασμοί μπορεί να χρειαστούν αρκετά λεπτά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporting your data… Keep Omi open; large accounts can take several minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportando tus datos… Mantén Omi abierto; las cuentas grandes pueden tardar varios minutos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teie andmete eksportimine… Hoidke Omi avatud; suurte kontode puhul võib see võtta mitu minutit."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال خروج گرفتن از داده‌های شما… Omi را باز نگه دارید؛ حساب‌های بزرگ ممکن است چند دقیقه طول بکشند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietojasi viedään… Pidä Omi auki; suuret tilit voivat viedä useita minuutteja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportation de vos données… Gardez Omi ouvert ; les comptes volumineux peuvent prendre plusieurs minutes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מייצא את הנתונים שלך… השאירו את Omi פתוח; חשבונות גדולים עשויים לקחת מספר דקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा निर्यात किया जा रहा है… Omi को खुला रखें; बड़े खातों में कई मिनट लग सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvoz vaših podataka… Držite Omi otvorenim; veliki računi mogu potrajati nekoliko minuta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adatai exportálása folyamatban… Tartsa nyitva az Omi-t; a nagy fiókok több percet is igénybe vehetnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengekspor data Anda… Biarkan Omi tetap terbuka; akun besar bisa memakan waktu beberapa menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esportazione dei tuoi dati in corso… Tieni Omi aperta; gli account di grandi dimensioni possono richiedere diversi minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データをエクスポートしています… Omi を開いたままにしてください。大きなアカウントでは数分かかることがあります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಡೇಟಾವನ್ನು ರಫ್ತು ಮಾಡಲಾಗುತ್ತಿದೆ… Omi ಅನ್ನು ತೆರೆದಿರಿಸಿ; ದೊಡ್ಡ ಖಾತೆಗಳಿಗೆ ಹಲವು ನಿಮಿಷಗಳು ಬೇಕಾಗಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 보내는 중… Omi를 열어 두세요. 데이터가 많은 계정은 몇 분 정도 걸릴 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuojami jūsų duomenys… Palikite Omi atvertą; didelėms paskyroms tai gali užtrukti kelias minutes."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiek jūsu datu eksports… Turiet Omi atvērtu; lieliem kontiem tas var ilgt vairākas minūtes."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите податоци се извезуваат… Држете го Omi отворено; за големи сметки може да треба неколку минути."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा डेटा एक्सपोर्ट होत आहे… Omi उघडे ठेवा; मोठ्या खात्यांना अनेक मिनिटे लागू शकतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengeksport data anda… Biarkan Omi terbuka; akaun besar mungkin mengambil masa beberapa minit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gegevens worden geëxporteerd… Houd Omi open; grote accounts kunnen enkele minuten duren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksporterer dataene dine… Hold Omi åpen; store kontoer kan ta flere minutter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa eksportowanie Twoich danych… Nie zamykaj Omi; duże konta mogą potrwać kilka minut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportando seus dados… Mantenha o Omi aberto; contas grandes podem levar vários minutos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se exportă datele tale… Ține Omi deschis; conturile mari pot dura câteva minute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспорт ваших данных… Не закрывайте Omi; для больших аккаунтов это может занять несколько минут."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportujú sa vaše údaje… Nechajte Omi otvorené; pri veľkých účtoch to môže trvať niekoľko minút."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvažanje vaših podatkov… Omi naj ostane odprt; pri velikih računih lahko traja nekaj minut."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Извоз ваших података… Држите Omi отвореним; велики налози могу потрајати неколико минута."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporterar dina data… Håll Omi öppen; stora konton kan ta flera minuter."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் தரவு ஏற்றுமதி செய்யப்படுகிறது… Omi-ஐ திறந்தே வைக்கவும்; பெரிய கணக்குகளுக்கு பல நிமிடங்கள் ஆகலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ డేటా ఎగుమతి అవుతోంది… Omi ను తెరిచే ఉంచండి; పెద్ద ఖాతాలకు కొన్ని నిమిషాలు పట్టవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังส่งออกข้อมูลของคุณ… โปรดเปิด Omi ค้างไว้ บัญชีขนาดใหญ่อาจใช้เวลาหลายนาที"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini-export ang iyong data… Panatilihing bukas ang Omi; ang malalaking account ay maaaring tumagal ng ilang minuto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verileriniz dışa aktarılıyor… Omi'yi açık tutun; büyük hesaplar birkaç dakika sürebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експорт ваших даних… Не закривайте Omi; для великих акаунтів це може тривати кілька хвилин."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ڈیٹا ایکسپورٹ ہو رہا ہے… Omi کو کھلا رکھیں؛ بڑے اکاؤنٹس میں کئی منٹ لگ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang xuất dữ liệu của bạn… Hãy giữ Omi mở; tài khoản lớn có thể mất vài phút."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "正在导出您的数据… 请保持 Omi 打开；大型账户可能需要几分钟。"
          }
        }
      }
    },
