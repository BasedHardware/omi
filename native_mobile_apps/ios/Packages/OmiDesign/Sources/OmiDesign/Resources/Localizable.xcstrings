    "googleCalendarConnectPrompt": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط تقويم Google لربط المحادثات بأحداث التقويم."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падключыце Google Calendar, каб звязваць размовы з падзеямі календара."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свържете Google Календар, за да свързвате разговори със събития в календара."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কথোপকথনকে ক্যালেন্ডার ইভেন্টের সাথে লিঙ্ক করতে আপনার Google ক্যালেন্ডার সংযুক্ত করুন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povežite Google Kalendar da biste razgovore povezali s događajima u kalendaru."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecta el teu Google Calendar per vincular converses a esdeveniments del calendari."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte Kalendář Google, abyste mohli propojovat konverzace s událostmi v kalendáři."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbind din Google Kalender for at knytte samtaler til kalenderbegivenheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie Ihren Google Kalender, um Konversationen mit Kalenderterminen zu verknüpfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέστε το Ημερολόγιο Google για να συνδέετε συνομιλίες με συμβάντα ημερολογίου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your Google Calendar to link conversations to calendar events."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tu Google Calendar para vincular conversaciones con eventos del calendario."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ühenda oma Google Kalender, et siduda vestlusi kalendrisündmustega."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای پیوند دادن گفتگوها به رویدادهای تقویم، Google Calendar خود را متصل کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä Google Kalenteri, niin voit linkittää keskusteluja kalenteritapahtumiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez votre Google Agenda pour lier vos conversations à des événements d'agenda."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חבר את Google Calendar כדי לקשר שיחות לאירועי יומן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बातचीत को कैलेंडर ईवेंट से लिंक करने के लिए अपना Google कैलेंडर कनेक्ट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povežite svoj Google Calendar kako biste razgovore povezali s događajima u kalendaru."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakoztasd a Google naptáradat, hogy a beszélgetéseket naptáreseményekhez kapcsolhasd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan Google Calendar Anda untuk menautkan percakapan ke acara kalender."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega il tuo Google Calendar per associare le conversazioni agli eventi del calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話をカレンダーの予定に紐付けるには、Google カレンダーを接続してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂವಾದಗಳನ್ನು ಕ್ಯಾಲೆಂಡರ್ ಈವೆಂಟ್‌ಗಳಿಗೆ ಲಿಂಕ್ ಮಾಡಲು ನಿಮ್ಮ Google Calendar ಅನ್ನು ಸಂಪರ್ಕಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화를 캘린더 일정에 연결하려면 Google 캘린더를 연결하세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijunkite Google kalendorių, kad galėtumėte susieti pokalbius su kalendoriaus įvykiais."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Savienojiet savu Google kalendāru, lai saistītu sarunas ar kalendāra notikumiem."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поврзете го вашиот Google Calendar за да ги поврзувате разговорите со настани од календарот."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "संभाषणे कॅलेंडर इव्हेंटशी लिंक करण्यासाठी तुमचे Google कॅलेंडर कनेक्ट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungkan Kalendar Google anda untuk memautkan perbualan kepada acara kalendar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind je Google Agenda om gesprekken aan agenda-items te koppelen."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til Google-kalenderen din for å knytte samtaler til kalenderhendelser."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz swój Kalendarz Google, aby powiązywać rozmowy z wydarzeniami w kalendarzu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte seu Google Calendar para vincular conversas a eventos do calendário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectați-vă Google Calendar pentru a asocia conversațiile cu evenimente din calendar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите Google Календарь, чтобы связывать разговоры с событиями календаря."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojte Google kalendár, aby ste mohli konverzácie prepájať s udalosťami v kalendári."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povežite Google Koledar, da boste pogovore lahko povezali s koledarskimi dogodki."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Повежите Google календар да бисте разговоре повезали са догађајима у календару."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut din Google Kalender för att länka samtal till kalenderhändelser."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உரையாடல்களை நாட்காட்டி நிகழ்வுகளுடன் இணைக்க உங்கள் Google நாட்காட்டியை இணைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంభాషణలను క్యాలెండర్ ఈవెంట్‌లకు లింక్ చేయడానికి మీ Google క్యాలెండర్‌ను కనెక్ట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อปฏิทิน Google ของคุณเพื่อเชื่อมโยงการสนทนากับกิจกรรมในปฏิทิน"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikonekta ang iyong Google Calendar upang mai-link ang mga pag-uusap sa mga kaganapan sa kalendaryo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşmaları takvim etkinliklerine bağlamak için Google Takvim hesabınızı bağlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть Google Календар, щоб прив’язувати розмови до подій календаря."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بات چیتوں کو کیلنڈر ایونٹس سے منسلک کرنے کے لیے اپنا Google کیلنڈر منسلک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối Lịch Google của bạn để liên kết cuộc trò chuyện với sự kiện lịch."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "连接您的 Google 日历，即可将对话关联到日历活动。"
          }
        }
      }
    },
