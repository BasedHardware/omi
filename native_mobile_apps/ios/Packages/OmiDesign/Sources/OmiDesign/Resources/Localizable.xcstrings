    "nativeNoOmiFooter": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis es da ist, hört Omi mit dem Mikrofon deines iPhones zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until it arrives, Omi listens with your iPhone's microphone."
          }
        }
      }
    },
    "nativeNoRecordingsWaiting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء بالانتظار. تتم مزامنة التسجيلات تلقائيًا ما دام Omi متصلًا."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічога не чакае. Запісы сінхранізуюцца самі, пакуль Omi падключаны."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Нищо не чака. Записите се синхронизират сами, докато Omi е свързан."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু অপেক্ষায় নেই। Omi কানেক্ট থাকলে রেকর্ডিং নিজে থেকেই সিঙ্ক হয়।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa ne čeka. Snimci se sami sinhronizuju dok je Omi povezan."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No hi ha res pendent. Les gravacions se sincronitzen soles mentre el teu Omi està connectat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nečeká. Nahrávky se synchronizují samy, když je Omi připojený."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet venter. Optagelser synkroniseres af sig selv, mens din Omi er forbundet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts offen. Aufnahmen werden von selbst synchronisiert, solange dein Omi verbunden ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα σε αναμονή. Οι ηχογραφήσεις συγχρονίζονται μόνες τους όσο το Omi είναι συνδεδεμένο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing waiting. Recordings sync on their own while your Omi is connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada pendiente. Las grabaciones se sincronizan solas mientras tu Omi esté conectado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Midagi ei ootel. Salvestused sünkroonitakse ise, kui Omi on ühendatud."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چیزی در انتظار نیست. تا وقتی Omi وصل است، ضبط‌ها خودکار همگام می‌شوند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei odottavia. Tallenteet synkronoituvat itsestään, kun Omi on yhdistetty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien en attente. Les enregistrements se synchronisent seuls tant que ton Omi est connecté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מה לסנכרן. הקלטות מסתנכרנות מעצמן כל עוד ה-Omi מחובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ इंतज़ार में नहीं। Omi कनेक्ट रहने पर रिकॉर्डिंग अपने आप सिंक हो जाती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa ne čeka. Snimke se same sinkroniziraju dok je tvoj Omi spojen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Semmi sem vár. A felvételek maguktól szinkronizálódnak, amíg az Omid csatlakoztatva van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang menunggu. Rekaman tersinkron sendiri selama Omi terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente in attesa. Le registrazioni si sincronizzano da sole finché Omi è connesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中のものはありません。Omiが接続されている間、録音は自動で同期されます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವುದೂ ಕಾಯುತ್ತಿಲ್ಲ. ನಿಮ್ಮ Omi ಸಂಪರ್ಕದಲ್ಲಿರುವಾಗ ರೆಕಾರ್ಡಿಂಗ್‌ಗಳು ತಾವಾಗಿಯೇ ಸಿಂಕ್ ಆಗುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중인 항목이 없어요. Omi가 연결되어 있으면 녹음이 자동으로 동기화돼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieko nelaukia. Įrašai sinchronizuojasi patys, kol tavo Omi prijungtas."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekas negaida. Ieraksti sinhronizējas paši, kamēr Omi ir savienots."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ништо не чека. Снимките се синхронизираат сами додека Omi е поврзан."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीही प्रतीक्षेत नाही. तुमचा Omi कनेक्ट असताना रेकॉर्डिंग आपोआप सिंक होतात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada yang menunggu. Rakaman disegerakkan sendiri semasa Omi anda disambungkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets in de wacht. Opnames synchroniseren vanzelf zolang je Omi verbonden is."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting venter. Opptak synkroniseres av seg selv mens Omi er tilkoblet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie czeka. Nagrania synchronizują się same, gdy Omi jest połączony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada aguardando. As gravações sincronizam sozinhas enquanto o Omi está conectado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic în așteptare. Înregistrările se sincronizează singure cât timp Omi este conectat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не ждёт. Записи синхронизируются сами, пока Omi подключён."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič nečaká. Nahrávky sa synchronizujú samy, kým je Omi pripojené."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič ne čaka. Posnetki se sinhronizirajo sami, dokler je Omi povezan."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ништа не чека. Снимци се синхронизују сами док је Omi повезан."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget väntar. Inspelningar synkas av sig själva medan din Omi är ansluten."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதுவும் காத்திருக்கவில்லை. உன் Omi இணைந்திருக்கும்போது பதிவுகள் தானாக ஒத்திசைக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదీ వేచి లేదు. నీ Omi కనెక్ట్ అయి ఉన్నప్పుడు రికార్డింగ్‌లు తమంతట అవే సింక్ అవుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีรายการรอ การบันทึกจะซิงค์เองขณะที่ Omi เชื่อมต่ออยู่"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang naghihintay. Kusang nagsi-sync ang mga recording habang nakakonekta ang Omi mo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen yok. Omi bağlıyken kayıtlar kendiliğinden senkronize olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не очікує. Записи синхронізуються самі, поки Omi підключено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کچھ منتظر نہیں۔ آپ کا Omi کنیکٹ ہو تو ریکارڈنگز خود بخود سنک ہو جاتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì đang chờ. Bản ghi tự đồng bộ khi Omi được kết nối."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "没有待处理的内容。Omi 连接时，录音会自动同步。"
          }
        }
      }
    },
