    "appleHealthFeatureReadOnlyDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يكتب Omi في Apple Health أبدًا ولا يعدل بياناتك."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ніколі не піша ў Apple Health і не змяняе вашы даныя."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi никога не записва в Apple Health и не променя данните ви."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi কখনই Apple Health-এ লেখে না বা আপনার ডেটা পরিবর্তন করে না।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nikada ne upisuje u Apple Health niti mijenja vaše podatke."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi mai escriu a Apple Health ni modifica les teves dades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nikdy nezapisuje do Apple Health ani neupravuje vaše data."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi skriver aldrig til Apple Health eller ændrer dine data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi schreibt nie in Apple Health und ändert deine Daten nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Omi δεν γράφει ποτέ στο Apple Health και δεν τροποποιεί τα δεδομένα σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi never writes to Apple Health or modifies your data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nunca escribe en Apple Health ni modifica tus datos."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ei kirjuta kunagi Apple Health'i ega muuda teie andmeid."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi هرگز در Apple Health نمی‌نویسد و داده‌های شما را تغییر نمی‌دهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi ei koskaan kirjoita Apple Healthiin tai muuta tietojasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi n'écrit jamais dans Apple Health et ne modifie pas vos données."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi לעולם לא כותב ל-Apple Health ולא משנה את הנתונים שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi कभी Apple Health में नहीं लिखता या आपका डेटा नहीं बदलता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi nikada ne piše u Apple Health niti mijenja vaše podatke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Omi soha nem ír az Apple Healthbe, és nem módosítja az adataidat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi tidak pernah menulis ke Apple Health atau mengubah data Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi non scrive mai in Apple Health né modifica i tuoi dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi は Apple Health に書き込みや変更を行いません。"
