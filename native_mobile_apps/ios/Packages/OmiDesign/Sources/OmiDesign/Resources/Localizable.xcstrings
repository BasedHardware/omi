    "sharedTasksAcceptFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر قبول هذه المهام. ربما قبلت هذه المشاركة من قبل."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не ўдалося прыняць гэтыя задачы. Магчыма, вы ўжо прынялі гэты доступ."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задачите не можаха да бъдат приети. Може вече да сте приели това споделяне."
          }
