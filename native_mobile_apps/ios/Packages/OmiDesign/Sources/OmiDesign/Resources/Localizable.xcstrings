            "state": "translated",
            "value": "앱을 열어 두고 Omi를 가까이에 두세요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Laikyk programėlę atidarytą, o Omi šalia."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Neaizver lietotni un tur Omi tuvumā."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Остави ја апликацијата отворена и држи го Omi близу."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अॅप उघडे ठेवा आणि तुमचा Omi जवळ ठेवा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan apl terbuka dan Omi anda berdekatan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de app open en je Omi dichtbij."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold appen åpen og Omi i nærheten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zamykaj aplikacji i trzymaj Omi blisko."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o app aberto e seu Omi por perto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține aplicația deschisă și Omi în apropiere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не закрывай приложение и держи Omi рядом."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechaj aplikáciu otvorenú a Omi nablízku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacijo imej odprto, Omi pa blizu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Држи апликацију отвореном, а Omi близу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll appen öppen och din Omi i närheten."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயலியைத் திறந்து வைத்து, உன் Omi-ஐ அருகில் வை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్‌ను తెరిచి ఉంచి, నీ Omiని దగ్గరగా ఉంచు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดแอปค้างไว้และวาง Omi ไว้ใกล้ ๆ"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "Panatilihing bukas ang app at malapit ang Omi mo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı açık tut ve Omi'ni yakında bulundur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не закривайте застосунок і тримайте Omi поруч."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ کھلی رکھیں اور اپنا Omi قریب رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở ứng dụng và giữ Omi ở gần."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持应用打开，并让 Omi 靠近。"
          }
        }
      }
    },
