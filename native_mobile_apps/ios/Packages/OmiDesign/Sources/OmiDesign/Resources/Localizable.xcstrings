    "nativeReviewTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بينما تنتظر، هل كان استخدام Omi ممتعًا حتى الآن؟"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль чакаеш, табе падабаецца Omi?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докато чакаш, харесва ли ти Omi досега?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অপেক্ষার ফাঁকে, Omi কি এখন পর্যন্ত ভালো লেগেছে?"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dok čekaš, je li ti Omi do sada bio prijatan za korištenje?"
