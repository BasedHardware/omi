    "feedbackSubtitleAudioQuality": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نود أن نفهم ما حدث."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы б хацелі зразумець, что пайшло не так."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Бихме искали да разберем какво се е объркало."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা বুঝতে চাই কী ভুল হয়েছিল।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Voljeli bismo da razumemo šta je pošlo naopako."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ens encantaria entendre què va anar malament."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rádi bychom pochopili, co se pokazilo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vil gerne forstå, hvad der gik galt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir würden gerne verstehen, was schiefgelaufen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα θέλαμε να καταλάβουμε τι πήγε στραβά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'd love to understand what went wrong."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos encantaría entender qué salió mal."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahaksime mõista, mis läks valesti."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ما دوست داریم بفهمیم چه چیز غلط شد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluaisimme ymmärtää, mikä meni pieleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous aimerions comprendre ce qui n'a pas fonctionné."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היינו רוצים להבין מה השתבש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम समझना चाहेंगे कि क्या गलत हुआ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voljeli bismo razumjeti što je pošlo po zlu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szeretnénk megérteni, mi ment rosszul."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami ingin memahami apa yang salah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorremmo capire cosa è andato storto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が問題だったか理解したいです。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಾವು ತಿಳಿಯಲು ಕುತೂಹಲವಾಗಿದ್ದೇವೆ ಏನು ನಮನ ತಪ್ಪಾಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이 잘못되었는지 이해하고 싶습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Norėtume suprasti, kas nutiko."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mēs labprāt saprastu, kas nogāja greizi."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Би сакале да разумеме што отиде наопако."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे काय चुकीचे गेले हे समजून घेऊ इच्छितो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami ingin memahami apa yang salah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We willen graag begrijpen wat er mis ging."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vil gjerne forstå hva som gikk galt."
