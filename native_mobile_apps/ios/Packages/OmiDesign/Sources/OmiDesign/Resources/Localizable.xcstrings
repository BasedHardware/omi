    "nativeFolderDeleteFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على مجلد لإعادة تسميته، واسحب لحذفه. تبقى محادثاته محفوظة."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Націсні на папку, каб перайменаваць, правядзі, каб выдаліць. Размовы ў ёй захаваюцца."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докосни папка, за да я преименуваш, плъзни, за да я изтриеш. Разговорите в нея се запазват."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নাম বদলাতে ফোল্ডারে ট্যাপ করো, মুছতে সোয়াইপ করো। এর কথোপকথনগুলো থেকে যাবে।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni folder da ga preimenuješ, prevuci da ga izbrišeš. Njegovi razgovori ostaju."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una carpeta per canviar-li el nom, llisca per eliminar-la. Les seves converses es conserven."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím složku přejmenuješ, přejetím smažeš. Její konverzace zůstanou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en mappe for at omdøbe den, swipe for at slette den. Dens samtaler bevares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp auf einen Ordner, um ihn umzubenennen, wisch zum Löschen. Seine Gespräche bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτα έναν φάκελο για να τον μετονομάσεις, σύρε για να τον διαγράψεις. Οι συζητήσεις του διατηρούνται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a folder to rename it, swipe to delete it. Its conversations are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una carpeta para renombrarla, desliza para eliminarla. Sus conversaciones se conservan."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Puuduta kausta, et seda ümber nimetada, pühi kustutamiseks. Selle vestlused jäävad alles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تغییر نام یک پوشه آن را لمس کن، برای حذف بکشش. گفتگوهای آن می‌مانند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta kansiota nimetäksesi sen uudelleen, pyyhkäise poistaaksesi. Sen keskustelut säilyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un dossier pour le renommer, balaie pour le supprimer. Ses conversations sont conservées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על תיקייה כדי לשנות את שמה, החלק כדי למחוק. השיחות שלה נשמרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डर का नाम बदलने के लिए उस पर टैप करो, हटाने के लिए स्वाइप करो। उसकी बातचीतें बनी रहती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni mapu da je preimenuješ, povuci za brisanje. Njezini razgovori ostaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints egy mappára az átnevezéshez, húzd el a törléshez. A beszélgetései megmaradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk folder untuk mengganti namanya, geser untuk menghapus. Percakapannya tetap ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una cartella per rinominarla, scorri per eliminarla. Le sue conversazioni restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダをタップで名前変更、スワイプで削除。中の会話は残ります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಲ್ಡರ್ ಹೆಸರು ಬದಲಿಸಲು ಟ್ಯಾಪ್ ಮಾಡಿ, ಅಳಿಸಲು ಸ್ವೈಪ್ ಮಾಡಿ. ಅದರ ಸಂಭಾಷಣೆಗಳು ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 탭하면 이름을 바꾸고, 살짝 밀면 삭제해요. 폴더 안의 대화는 유지돼요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Palietęs aplanką pervadink, braukdamas ištrink. Jo pokalbiai išlieka."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieskaries mapei, lai to pārsauktu, velc, lai dzēstu. Tās sarunas tiek saglabātas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допри папка за да ја преименуваш, повлечи за да ја избришеш. Нејзините разговори се зачувуваат."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नाव बदलण्यासाठी फोल्डरवर टॅप करा, हटवण्यासाठी स्वाइप करा. त्यातील संभाषणे ठेवली जातात."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik folder untuk menamakan semula, leret untuk memadam. Perbualannya dikekalkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een map om de naam te wijzigen, veeg om te verwijderen. De gesprekken blijven bewaard."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en mappe for å gi den nytt navn, sveip for å slette. Samtalene beholdes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij folder, aby zmienić nazwę, przesuń, aby usunąć. Jego rozmowy zostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma pasta para renomear, deslize para excluir. As conversas dela são mantidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge un folder ca să-l redenumești, trage cu degetul ca să-l ștergi. Conversațiile lui se păstrează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на папку, чтобы переименовать, смахни, чтобы удалить. Разговоры в ней сохранятся."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na priečinok ho premenuješ, potiahnutím ho odstrániš. Jeho konverzácie zostanú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni mapo, da jo preimenuješ, povleci, da jo izbrišeš. Njeni pogovori se ohranijo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Додирни фасциклу да је преименујеш, превуци да је обришеш. Њени разговори се чувају."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en mapp för att byta namn, svep för att radera den. Dess samtal finns kvar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்புறையின் பெயரை மாற்ற அதைத் தட்டு, நீக்க ஸ்வைப் செய். அதன் உரையாடல்கள் அப்படியே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోల్డర్ పేరు మార్చడానికి దాన్ని నొక్కు, తొలగించడానికి స్వైప్ చేయి. దాని సంభాషణలు అలాగే ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะโฟลเดอร์เพื่อเปลี่ยนชื่อ ปัดเพื่อลบ บทสนทนาในโฟลเดอร์จะยังอยู่"
          }
        },
        "tl": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang folder para palitan ang pangalan, i-swipe para burahin. Mananatili ang mga usapan nito."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden adlandırmak için klasöre dokun, silmek için kaydır. Konuşmaları korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться папки, щоб перейменувати, проведіть, щоб видалити. Розмови в ній збережуться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نام بدلنے کے لیے فولڈر پر ٹیپ کریں، حذف کرنے کے لیے سوائپ کریں۔ اس کی گفتگوئیں محفوظ رہتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào thư mục để đổi tên, vuốt để xóa. Các cuộc trò chuyện trong đó vẫn được giữ."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "点按文件夹可重命名，滑动可删除。其中的对话会保留。"
          }
        }
      }
    },
