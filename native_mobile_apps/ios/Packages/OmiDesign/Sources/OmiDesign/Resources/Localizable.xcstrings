    "nativeVoiceSavedBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من الآن يستطيع Omi معرفة متى تتحدث أنت."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Цяпер Omi будзе разумець, калі гаворыш ты."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсега Omi знае кога говориш ти."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন থেকে Omi বুঝতে পারবে কখন আপনি বলছেন।"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od sada Omi zna kada ti govoriš."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir d'ara l'Omi sap quan parles tu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od teď Omi pozná, kdy mluvíš ty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra nu af kan Omi høre, når det er dig, der taler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab jetzt erkennt Omi, wann du sprichst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Από τώρα το Omi καταλαβαίνει πότε μιλάς εσύ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From now on Omi can tell when it's you talking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de ahora Omi sabe cuándo hablas tú."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Nüüdsest teab Omi, millal räägid sina."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از این پس Omi می‌فهمد کی تو صحبت می‌کنی."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tästä lähtien Omi tietää, milloin puhut sinä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désormais, Omi sait quand c'est toi qui parles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעכשיו Omi יודע מתי אתה מדבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब से Omi जान सकता है कि कब आप बोल रहे हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Od sada Omi zna kada ti govoriš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostantól az Omi tudja, mikor te beszélsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai sekarang Omi tahu kapan itu kamu yang bicara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "D'ora in poi Omi sa quando parli tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これからは、あなたが話しているときにOmiが分かります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನು ಮುಂದೆ ನೀವು ಮಾತನಾಡುತ್ತಿರುವಾಗ Omi ಗೆ ತಿಳಿಯುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제부터 Omi는 네가 말할 때를 알 수 있어요."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuo šiol Omi žino, kada kalbi tu."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "No šī brīža Omi zina, kad runā tu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсега Omi знае кога зборуваш ти."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आतापासून तुम्ही बोलत असताना Omi ला कळेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai sekarang Omi tahu bila anda yang bercakap."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanaf nu hoort Omi wanneer jij praat."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra nå av vet Omi når det er du som snakker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od teraz Omi wie, kiedy mówisz ty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Daqui em diante o Omi sabe quando é você falando."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "De acum, Omi știe când vorbești tu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь Omi понимает, когда говоришь ты."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odteraz Omi vie, kedy hovoríš ty."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odslej Omi ve, kdaj govoriš ti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Од сада Omi зна када ти говориш."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från och med nu vet Omi när det är du som pratar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இனி நீங்கள் பேசும்போது Omi க்குத் தெரியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇకపై మీరు మాట్లాడేది Omi కి తెలుస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
