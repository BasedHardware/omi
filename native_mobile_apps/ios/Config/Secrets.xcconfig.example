// Copy to Config/Secrets.xcconfig (gitignored). Included last, so these win.

// --- Run on your own iPhone against the local harness on this Mac ---
// 1. Start the harness reachable on the LAN (upstream docs/doc/developer/AppSetup.mdx, physical device tip):
//    OMI_DEV_HOST=<mac-lan-ip> PROVIDER_MODE=offline make dev-up
// 2. Your signing team and a bundle id your team can register:
// DEVELOPMENT_TEAM = ABCDE12345
// OMI_BUNDLE_ID = com.yourname.omi.native
// 3. Point the app at the Mac (the Auth emulator accepts any bundle id):
// OMI_API_HOST = <mac-lan-ip>:8000
// OMI_AUTH_EMULATOR_HOST = <mac-lan-ip>:9099

// --- Release build outside the Omi repository: Omi's production Firebase file ---
// (inside it, Release uses app/setup/release-firebase/GoogleService-Info.prod.plist)
// OMI_FIREBASE_PROD_PLIST = $(SRCROOT)/Config/Firebase/GoogleService-Info-Prod.plist

// --- Support chat (Intercom), as Flutter's INTERCOM_APP_ID / INTERCOM_IOS_API_KEY ---
// OMI_INTERCOM_APP_ID = abcd1234
// OMI_INTERCOM_IOS_API_KEY = ios_sdk-...
