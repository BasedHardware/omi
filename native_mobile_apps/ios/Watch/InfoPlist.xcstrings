      "comment": "Microphone permission prompt on the watch.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Omi records your conversations from your Apple Watch with your permission to transcribe and summarize them."
