# backend.env.dev — DEV overrides (layered over backend.env.base). Copy to `backend.env.dev`
# (gitignored). Used ONLY with compose.dev.yaml (non-hermetic): the backend reaches inference
# endpoints on the HOST via host.docker.internal. In prod these are internal endpoints (backend.env.prod).

# --- dev auth: any bearer -> uid 123; ADMIN_KEY enables `Bearer <ADMIN_KEY><uid>` impersonation (seed) ---
LOCAL_DEVELOPMENT=true
# ADMIN_KEY=CHANGE_ME_dev_admin_key_min_16_chars    # optional; for multi-user data seeding

# --- LLM (chat) via the llm_gateway service; the gateway forwards to the HOST (see llm_gateway.env) ---
OMI_LLM_GATEWAY_FEATURE_MODE=gateway
OMI_LLM_GATEWAY_URL=http://llm_gateway:9080
OMI_LLM_GATEWAY_ALLOW_PROD_FEATURE_MODE=true
# OMI_LLM_GATEWAY_SERVICE_TOKEN=<same value as llm_gateway.env>

# --- embeddings + vector store (RAG). DEV points at the HOST (host Ollama); dim MUST match the model ---
VECTOR_STORE_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_VECTOR_DIM=1024
OMI_EMBEDDINGS_BASE_URL=http://host.docker.internal:11434/v1
OMI_EMBEDDINGS_MODEL=bge-m3
OMI_EMBEDDINGS_API_KEY=ollama
