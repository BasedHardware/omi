# backend.env.seed — SEED overrides (layered over backend.env.base). Copy to `backend.env.seed`
# (gitignored). Used ONLY with compose.seed.yaml: dev-posture (host inference via
# host.docker.internal) but with REAL OIDC auth so multiple Keycloak users can drive the API.

# --- OIDC auth (real Keycloak users, not the dev-bypass) ---
# LOCAL_DEVELOPMENT MUST be false, otherwise any bearer resolves to uid 123 and JWKS is never used.
LOCAL_DEVELOPMENT=false
AUTH_BACKEND=oidc
# The token `iss` equals the public KC_HOSTNAME the client used; OIDC_ISSUER must match it exactly.
# The seeder mints tokens via kc-proxy at https://localhost:8443 (default KC_HOSTNAME).
OIDC_ISSUER=https://localhost:8443/realms/omi
# JWKS is fetched over the internal net (Keycloak is http-only behind kc-proxy).
OIDC_JWKS_URL=http://keycloak:8090/realms/omi/protocol/openid-connect/certs
# OIDC admin API (Keycloak service-account client) — user-name resolution for memory attribution.
OIDC_ADMIN_API_URL=http://keycloak:8090/admin/realms/omi
OIDC_ADMIN_TOKEN_URL=http://keycloak:8090/realms/omi/protocol/openid-connect/token
OIDC_ADMIN_CLIENT_ID=omi-backend-admin
OIDC_ADMIN_CLIENT_SECRET=CHANGE_ME_confidential_client_secret

# --- storage: REAL on-prem = Mongo (no Google). The store port routes to MongoDocumentStore.
STORAGE_BACKEND=mongo
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGO_DB=omi

# --- LLM (chat) via the llm_gateway service; the gateway forwards to the HOST (see llm_gateway.env) ---
OMI_LLM_GATEWAY_FEATURE_MODE=gateway
OMI_LLM_GATEWAY_URL=http://llm_gateway:9080
OMI_LLM_GATEWAY_ALLOW_PROD_FEATURE_MODE=true
# OMI_LLM_GATEWAY_SERVICE_TOKEN=<same value as llm_gateway.env>

# --- embeddings + vector store (RAG). Points at the HOST (host Ollama); dim MUST match the model ---
VECTOR_STORE_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_VECTOR_DIM=1024
OMI_EMBEDDINGS_BASE_URL=http://host.docker.internal:11434/v1
OMI_EMBEDDINGS_MODEL=bge-m3
OMI_EMBEDDINGS_API_KEY=ollama
