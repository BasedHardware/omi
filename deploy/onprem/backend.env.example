# Copy to `backend.env` and generate a real ENCRYPTION_SECRET:
#   cp backend.env.example backend.env
#   sed -i "s/^ENCRYPTION_SECRET=.*/ENCRYPTION_SECRET=$(openssl rand -hex 32)/" backend.env
# `backend.env` is already ignored by .gitignore (pattern *.env): it is never committed.

# --- offline mode / stage ---
PROVIDER_MODE=offline
OMI_ENV_STAGE=offline

# --- encryption secret (REQUIRED at import-time, >=32 bytes) ---
# dev placeholder value: REPLACE with `openssl rand -hex 32`
ENCRYPTION_SECRET=CHANGE_ME_dev_only_placeholder_at_least_32_bytes_long_0000

# --- Firebase emulators (no cloud credentials) ---
FIRESTORE_EMULATOR_HOST=firestore-emulator:8085
FIREBASE_AUTH_EMULATOR_HOST=firestore-emulator:9099
FIREBASE_PROJECT_ID=demo-omi-local
FIREBASE_AUTH_PROJECT_ID=demo-omi-local
GOOGLE_CLOUD_PROJECT=demo-omi-local

# --- storage backend (ADR-0002/0004): 'firestore' (default, first-class) | 'mongo' ---
# Firestore is the default; leave unset for the baseline. To run on MongoDB instead, set
# STORAGE_BACKEND=mongo and start with `--profile mongo` (replica set required for transactions):
# STORAGE_BACKEND=mongo
# MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0
# MONGO_DB=omi

# --- object store (ADR-0032/0004): 'gcs' (default, first-class) | 's3' ---
# GCS is the default; leave unset for the baseline. To store objects on any S3-compatible backend
# (RustFS/MinIO/SeaweedFS/Ceph/AWS) set OBJECT_STORE_BACKEND=s3 and point at the endpoint. The bundled
# RustFS service starts with `--profile objstore`; the S3 adapter is generic (product = config only):
# OBJECT_STORE_BACKEND=s3
# S3_ENDPOINT=http://rustfs:9000
# S3_ACCESS_KEY=rustfsadmin
# S3_SECRET_KEY=rustfsadmin
# S3_REGION=us-east-1
# S3_PUBLIC_ENDPOINT=          # optional: base for public_url() if objects are served on a different host

# --- local inference (WP5, ADR-0035): point at operator-provided endpoints ---
# Inference is NOT bundled as a prod service: the backend is CONFIGURED to point at endpoints
# you run (often a dedicated GPU host). LLM + embeddings can be one OpenAI-compatible server
# (Ollama/vLLM/TEI serving both /v1/chat/completions and /v1/embeddings). The in-repo GPU
# servers (STT/diarization/translation) can be turned on with `docker compose --profile inference`.
#
# LLM (chat) — OpenAI-compatible gateway/base URL (leave unset to use the cloud default):
# OMI_LLM_GATEWAY_FEATURE_MODE=gateway
# OMI_LLM_GATEWAY_URL=http://ollama:11434/v1
#
# Embeddings — the one hard-cloud gap, made pointable. Set the base URL to your OpenAI-compatible
# endpoint; the model's dimension MUST equal QDRANT_VECTOR_DIM (nomic-embed-text=768,
# mxbai-embed-large=1024, OpenAI text-embedding-3-large=3072). Switching dim needs a fresh vector
# store. Leave unset to keep the cloud default (text-embedding-3-large, 3072-dim).
# OMI_EMBEDDINGS_BASE_URL=http://ollama:11434/v1
# OMI_EMBEDDINGS_MODEL=nomic-embed-text
# OMI_EMBEDDINGS_API_KEY=            # optional; local servers ignore it
# QDRANT_VECTOR_DIM=768              # must match OMI_EMBEDDINGS_MODEL's output dimension
#
# STT / diarization / translation — the `inference` profile's services (or your own hosts):
# HOSTED_PARAKEET_API_URL=http://parakeet:8080
# HOSTED_SPEAKER_EMBEDDING_API_URL=http://diarizer:8080
# HOSTED_TRANSLATION_API_URL=http://nllb:8080
# TRANSLATION_SERVICE_MODELS=nllb
# (VAD runs locally in-process — Silero ONNX bundled in the image, no service needed.)

# --- Valkey (wire-compatible with redis-py) ---
REDIS_DB_HOST=valkey
REDIS_DB_PORT=6379

# --- dev auth: `Authorization: Bearer dev-token` -> uid 123 ---
LOCAL_DEVELOPMENT=true

# --- CORS: do NOT use '*' (main.py raises RuntimeError) ---
CORS_ALLOWED_ORIGINS=

# NB: PINECONE_* intentionally NOT set -> database/vector_db.py takes the no-op path.
