# Copy to `backend.env` and generate a real ENCRYPTION_SECRET:
#   cp backend.env.example backend.env
#   sed -i "s/^ENCRYPTION_SECRET=.*/ENCRYPTION_SECRET=$(openssl rand -hex 32)/" backend.env
# `backend.env` is already ignored by .gitignore (pattern *.env): it is never committed.

# --- offline mode / stage ---
PROVIDER_MODE=offline
OMI_ENV_STAGE=offline

# --- encryption secret (REQUIRED at import-time, >=32 bytes) ---
# dev placeholder value: REPLACE with `openssl rand -hex 32`
ENCRYPTION_SECRET=CHANGE_ME_dev_only_placeholder_at_least_32_bytes_long_0000

# --- Firebase emulators (no cloud credentials) ---
FIRESTORE_EMULATOR_HOST=firestore-emulator:8085
FIREBASE_AUTH_EMULATOR_HOST=firestore-emulator:9099
FIREBASE_PROJECT_ID=demo-omi-local
FIREBASE_AUTH_PROJECT_ID=demo-omi-local
GOOGLE_CLOUD_PROJECT=demo-omi-local

# --- Valkey (wire-compatible with redis-py) ---
REDIS_DB_HOST=valkey
REDIS_DB_PORT=6379

# --- dev auth: `Authorization: Bearer dev-token` -> uid 123 ---
LOCAL_DEVELOPMENT=true

# --- CORS: do NOT use '*' (main.py raises RuntimeError) ---
CORS_ALLOWED_ORIGINS=

# NB: PINECONE_* intentionally NOT set -> database/vector_db.py takes the no-op path.
