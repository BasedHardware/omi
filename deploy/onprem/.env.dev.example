# Dev compose variables for the reproducible on-prem OIDC stack.
# Docker Compose auto-reads a file named `.env` in this directory for ${VAR} substitution, so:
#   cp .env.dev.example .env        # then edit HOST_IP for your LAN
#   HOST_IP=<your-ip> ./gen-dev-certs.sh
#   docker compose -f compose.prod.yaml --profile auth up -d --build
#
# HOST_IP is the address the mobile DEVICE (emulator/phone) uses to reach this host — NOT 127.0.0.1.
HOST_IP=192.168.100.122

# Public https issuer the device and the tokens carry; the backend validates `iss` against this.
# MUST track HOST_IP: if you change HOST_IP, update this host AND OIDC_ISSUER (below) to the same
# IP:port and re-run gen-dev-certs.sh (the cert SAN), or mobile OIDC discovery/token exchange fails.
KC_HOSTNAME=https://192.168.100.122:8443
KC_HTTPS_PORT=8443
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# Backend API https proxy port. Set the app's API_BASE_URL=https://<HOST_IP>:${API_HTTPS_PORT}/.
API_HTTPS_PORT=8444

# ntfy (UnifiedPush) https proxy port — only used with `--profile push`. The ntfy Android distributor
# points at https://<HOST_IP>:${NTFY_HTTPS_PORT}; ntfy itself stays internal behind ntfy-proxy.
NTFY_HTTPS_PORT=8445

# The backend's own OIDC env goes in backend.env.prod (the env_file compose.prod.yaml layers over
# backend.env.base — NOT a bare `backend.env`, which the prod recipe never loads), not here. Set there:
#   AUTH_BACKEND=oidc
#   OIDC_ISSUER=https://192.168.100.122:8443/realms/omi        (= KC_HOSTNAME)
#   OIDC_JWKS_URL=http://keycloak:8090/realms/omi/protocol/openid-connect/certs   (internal http)
#   OIDC_AUDIENCE=account   (REQUIRED, fail-closed; `account` is Keycloak's default aud — use a
#                            dedicated client Audience mapper for real cross-client isolation)
#   LOCAL_DEVELOPMENT=false
