# omi.oss.release.pins — third-party image pins for this release (ADR-0055).
#
# Every third-party image the on-prem stack deploys is pinned HERE, once. The compose files reference
# these variables; the Helm chart mirrors the same pins in its own values.yaml and a CI check verifies
# the two agree (Helm cannot read a file outside the chart directory, so the chart is a projection —
# same pattern as the release itself, ADR-0054).
#
# Compose reads this file through the long form of `include:` in each entry file:
#
#   include:
#     - path: compose.base.yaml
#       env_file:
#         - omi.oss.release.pins
#
# Each variable holds the WHOLE image reference, not a version number, so a pin may be a tag, a
# tag@digest, or a bare digest — the form is a per-line choice and changes nothing else.
#
# EVERY pin here is now tag@digest, and the digest is the multi-arch MANIFEST LIST digest, not one
# platform's: pinning a platform digest would make the release amd64-only without saying so. A bare tag
# means two installs of the same release can have different bits (BACKLOG L28), which is the thing this
# file exists to prevent — a tag is a name, not a version.
#
# REFRESHING a pin is the cost of this, and it is deliberate: a tag like `nginx:stable-alpine` stops
# receiving security patches the moment it is pinned. Resolve the new digest and verify it in one step:
#
#     docker buildx imagetools inspect nginx:stable-alpine | sed -n 's/^Digest:[[:space:]]*//p'
#
# then update the line, and update the Helm mirror in helm/omi-oss/values.yaml (a check compares them).
#
# Names are namespaced OMI_OSS_* on purpose: the shell environment takes PRECEDENCE over an env_file,
# so a stray MONGO_IMAGE exported in the operator's shell would silently override a pin. Do not export
# these names; edit this file.
#
# Images WE build (omi-oss-*) are NOT here — they carry the release, see omi.oss.release.env.
# Registry prefix / mirroring is per-INSTALLATION, not per-release: it does not belong in this file.

# --- shared by compose and Helm ---------------------------------------------------------------
OMI_OSS_VALKEY_IMAGE=valkey/valkey:8-alpine@sha256:e0eb7c480958d32bdc4357a74bdd70653ae15f2f9b4c93c4a5a9fad1dc471c84
# major-pin (currently v7.0.40; gets 7.x security patches, not :latest)
OMI_OSS_MONGO_IMAGE=mongo:7@sha256:b6421fd6d1c5ded6377b397d8983e2f82e2100dc5123332dcfda2065a472be5b
OMI_OSS_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0@sha256:09a381c715ab0b111835b70f2905955274843a219c6f27efb348e4d9f4086858
OMI_OSS_NTFY_IMAGE=binwiederhier/ntfy:v2.11.0@sha256:4a7d0f0adc6d5d9fc36e64ab55ef676e76e124a2bdd50ce115b6d9c1c7430294
# qdrant 1.19.0 (registry digest, verified)
OMI_OSS_QDRANT_IMAGE=qdrant/qdrant@sha256:057ee3a8da769fe7310dd3537b4dc7583bf87a95ce8ac43c0af5a46bc580d1fc
# tag@digest (verified: tag resolves to this digest)
OMI_OSS_RUSTFS_IMAGE=rustfs/rustfs:1.0.0-beta.12@sha256:41fe89380f4120a337790c02af192c3fe7bb55c3edc2e6e9357b487b47c6ab21
# Keyword search. Same version upstream's own dev harness pins (scripts/dev-harness/dev_harness/config.py
# TYPESENSE_PINNED_VERSION), so we run what they develop against. tag@digest, verified by pulling.
OMI_OSS_TYPESENSE_IMAGE=typesense/typesense:27.1@sha256:5c12af89130b8ee0be11541321ba8a3a7c7a538d7c6cd95e0409dc2d75ca6455

# --- compose only ------------------------------------------------------------------------------
# TLS-terminating reverse proxies (api-proxy, kc-proxy, ntfy-proxy). The Helm target terminates TLS at
# the Envoy Gateway instead, so it has no equivalent.
OMI_OSS_NGINX_IMAGE=nginx:stable-alpine@sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46

# --- Helm only ---------------------------------------------------------------------------------
# Keycloak's database (compose runs Keycloak on its dev-mode embedded store) and the bucket-init job
# for RustFS. Pinned here so the whole third-party surface of a release lives in one place, even where
# only one deployment target uses it.
OMI_OSS_POSTGRES_IMAGE=postgres:16-alpine@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685
OMI_OSS_MC_IMAGE=minio/mc:latest@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727

# --- Build base --------------------------------------------------------------------------------
# The Python base our backend image is BUILT from. Upstream's Dockerfile defaults to a private GCR
# mirror we cannot pull, so compose overrides the `PYTHON_BASE_IMAGE` build-arg with the public image.
# It must be the exact patch `backend/.python-version` names (3.11.15): upstream's own unit runner
# refuses to start on a mismatch ("Python version mismatch: expected 3.11.15 ... got 3.11.16"). The
# floating `python:3.11-slim` tag drifted to 3.11.16 and silently made that gate unrunnable here.
OMI_OSS_PYTHON_BASE_IMAGE=python:3.11.15-slim@sha256:90744cff8f32887f075c47d747a173ff333e9e98801667af93c357fa9f5e28ff
