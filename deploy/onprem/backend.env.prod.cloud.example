# backend.env.prod.cloud — PROD CLOUD posture (ADR-0003/0046). Copy to `backend.env.prod.cloud`
# (gitignored) and fill the real credentials. Layered by compose.prod.cloud.yaml AFTER backend.env.base
# (env_file: [backend.env.base, backend.env.prod.cloud], last-wins), so it OVERRIDES the on-prem Mongo
# defaults with the reference/cloud stack.
#
# This posture is NOT hermetic (ADR-0001): it reaches Google/Pinecone over the network — the `omi`
# network stays non-internal (egress). For the offline, no-Google on-prem proof use compose.prod.yaml
# (Mongo + Qdrant + OIDC + S3). Firestore stays a first-class backend (ADR-0003); this file is what
# keeps that path documented and runnable now that Mongo is the on-prem default (ADR-0046).
#
# NOTE: there are NO emulators here — emulators are a dev convenience (compose.dev.yaml
# --profile firestore), pointless in production. Each port points at the REAL managed service.

# --- vendor egress + STT: the cloud posture OVERRIDES the on-prem defaults ---
# backend.env.base declares `OMI_VENDOR_EGRESS=deny` and pins STT to Parakeet, because that is the on-prem
# posture. This file is layered AFTER it (last-wins), and this posture is deliberately NOT hermetic — it
# reaches Google/Pinecone by design — so it must put both back. Without these three lines the cloud
# reference stack would inherit the on-prem refusals: no Hume prosody, no LangSmith, no release check, and
# an STT selection that only offers a Parakeet service this posture does not run.
OMI_VENDOR_EGRESS=allow
# Push: this posture IS the FCM one (ADR-0011's admitted exception), and the base declares `disabled`
# because on-prem the ntfy profile is opt-in. Take it back explicitly — and mount the service-account
# JSON above, or FCM selects fine and then fails on credentials.
PUSH_NOTIFICATION_BACKEND=fcm
STT_SERVICE_MODELS=dg-nova-3,modulate-velma-2,parakeet
STT_PRERECORDED_MODEL=parakeet,modulate-velma-2

# --- storage: Firestore (real, on Google Cloud) ---
STORAGE_BACKEND=firestore
# Real GCP project + a mounted service-account JSON with Firestore access. Do NOT set
# FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST here (that would redirect the SDK to a local
# emulator). backend.env.base no longer sets them (ADR-0046), so they stay unset.
GOOGLE_CLOUD_PROJECT=CHANGE_ME_gcp_project
FIREBASE_PROJECT_ID=CHANGE_ME_gcp_project
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json   # mount the SA JSON into the backend container

# --- vector: Pinecone (real; NO local emulator exists — this is the one non-emulable cloud dep) ---
VECTOR_STORE_BACKEND=pinecone
PINECONE_API_KEY=CHANGE_ME
PINECONE_INDEX_NAME=CHANGE_ME

# --- auth: Firebase (real) ---
AUTH_BACKEND=firebase
FIREBASE_AUTH_PROJECT_ID=CHANGE_ME_gcp_project
# Firebase Admin uses GOOGLE_APPLICATION_CREDENTIALS above.

# --- object store: GCS (real) ---
OBJECT_STORE_BACKEND=gcs
# Bucket names come from the same backend.env.* the on-prem posture uses; GCS auth = the SA JSON above.
# Do NOT set STORAGE_EMULATOR_HOST / GCS_PUBLIC_ENDPOINT (those point at a fake-gcs emulator).
