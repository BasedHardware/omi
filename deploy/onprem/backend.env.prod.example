# backend.env.prod — PROD overrides (layered over backend.env.base). Copy to `backend.env.prod`
# (gitignored). Used with compose.prod.yaml (hermetic, omi internal:true): inference endpoints are
# OPERATOR services reachable on the `omi` net — NO host access. Real OIDC auth.

# --- real auth (no dev bypass) ---
LOCAL_DEVELOPMENT=false

# --- auth backend OIDC (ADR-0034): public issuer for iss, internal JWKS backchannel (split-horizon) ---
AUTH_BACKEND=oidc
OIDC_ISSUER=https://<host>:8443/realms/omi
OIDC_JWKS_URL=http://keycloak:8090/realms/omi/protocol/openid-connect/certs
# Audience validation is REQUIRED and fail-closed (oidc adapter refuses to start without it). The realm
# adds a dedicated `aud=omi-backend` to omi-app / omi-test tokens via an Audience protocol mapper (NOT
# Keycloak's default `aud=account`, which gives no cross-client isolation). Must match that mapper.
OIDC_AUDIENCE=omi-backend

# --- MCP protected-resource identity (BACKLOG L48) ---
# WITHOUT this line the backend serves /.well-known/oauth-protected-resource with
# resource="https://api.omi.me/v1/mcp/sse" — upstream's OWN endpoint, baked in as the code default
# (database/mcp_oauth.py). Measured on a live self-host: the document named OUR issuer as the
# authorization server and UPSTREAM's endpoint as the resource, so an MCP client would have asked our
# Keycloak for a token audienced to Omi's cloud. Same shape the same document already refuses in the
# other half: authorization_servers FAILS loudly when OIDC_ISSUER is missing rather than mislead.
# It is the public URL of THIS deployment's MCP SSE endpoint — substitute <host> like OIDC_ISSUER above
# (an unsubstituted one now stops the boot, ADR-0083).
MCP_RESOURCE_URL=https://<host>:8443/v1/mcp/sse

# The base of every referral link your users share (utils/referrals.py). Unset, the code default is
# upstream's OWN host (https://omi.me), so a self-hosted user inviting a colleague hands out a link into
# Omi's cloud. Substitute <host> like the two above. What this does NOT reach: REFERRAL_SIGNUP_URL is a
# module constant pinned to https://app.omi.me/login, so the page the code lands on is still upstream's
# — product surface, not configuration.
REFERRAL_PUBLIC_BASE_URL=https://<host>:8443

# --- LLM (chat) via the llm_gateway service; the gateway forwards to your OPERATOR endpoint on `omi` ---
OMI_LLM_GATEWAY_FEATURE_MODE=gateway
OMI_LLM_GATEWAY_URL=http://llm_gateway:9080
OMI_LLM_GATEWAY_ALLOW_PROD_FEATURE_MODE=true
# OMI_LLM_GATEWAY_SERVICE_TOKEN=<same value as llm_gateway.env>

# --- embeddings + vector store (RAG). PROD points at an INTERNAL endpoint on the `omi` net (no host) ---
VECTOR_STORE_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_VECTOR_DIM=1024
# OMI_EMBEDDINGS_BASE_URL=http://<your-embeddings-svc-on-omi>:<port>/v1   # operator service, NOT the host
# OMI_EMBEDDINGS_MODEL=bge-m3
