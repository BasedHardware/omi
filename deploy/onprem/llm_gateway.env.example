# LLM gateway env (D32, ADR-0035). Copy to `llm_gateway.env` (gitignored via *.env) and fill in:
#   cp llm_gateway.env.example llm_gateway.env
#   # generate a shared service token and set the SAME value in backend.env:
#   TOK=$(openssl rand -hex 24); sed -i "s|^OMI_LLM_GATEWAY_SERVICE_TOKEN=.*|OMI_LLM_GATEWAY_SERVICE_TOKEN=$TOK|" llm_gateway.env
#
# The gateway resolves the backend's omi:auto:* LANE ids to a concrete model and forwards
# OpenAI-compatibly to the operator's LLM endpoint below. Pin the model in
# llm_gateway/generated_route_overrides.yaml to a model this endpoint serves.

# Operator LLM endpoint (OpenAI-compatible: Ollama/vLLM/TEI serving /v1/chat/completions).
# The gateway joins the `edge` net + uses host.docker.internal, so this can be a host/LAN endpoint
# OUTSIDE the internal `omi` network (e.g. a dedicated GPU host). Must end in /v1.
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama                 # any non-empty value; local servers ignore it

# Shared service token — MUST equal backend.env's OMI_LLM_GATEWAY_SERVICE_TOKEN.
OMI_LLM_GATEWAY_SERVICE_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_24
