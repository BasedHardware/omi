# backend.env.base — COMMON backend env for every on-prem environment. Copy to `backend.env.base`
# (gitignored) and generate the secret:
#   cp backend.env.base.example backend.env.base
#   sed -i "s/^ENCRYPTION_SECRET=.*/ENCRYPTION_SECRET=$(openssl rand -hex 32)/" backend.env.base
#   sed -i "s/^MEMORY_V3_CURSOR_SECRET=.*/MEMORY_V3_CURSOR_SECRET=$(openssl rand -hex 32)/" backend.env.base
# Layered with a per-env file by compose.{dev,prod}.yaml (env_file: [backend.env.base, backend.env.<env>]),
# last-wins. Env-specific values (auth, inference endpoints, LOCAL_DEVELOPMENT) live in backend.env.{dev,prod}.
# The authoritative map of the four environments (prod/dev/test-unit/test-e2e) — network, inference,
# auth, store, seed, exposure — is SELFHOST_NOTES.md "Environments — the authoritative map (ADR-0043)".

# --- deployment stage (ADR-0058) ---
# `selfhost` is this fork's own stage and it means ONE thing: a real deployment, not a developer's
# machine. It is NOT "offline" and NOT "air-gapped" — the network is bridged (ADR-0048) and the
# operator's own LLM/embeddings endpoint is expected to be reachable (ADR-0035).
#
# Why the value matters, verified on every consumer that branches on it:
#   * the LLM-gateway interlock classifies us as a real runtime (hence
#     OMI_LLM_GATEWAY_ALLOW_PROD_FEATURE_MODE=true below) — in Kubernetes that classification comes
#     free from the kubelet, in compose ONLY from this variable, so setting it is what makes the two
#     deployment targets behave identically;
#   * `prod` would refuse to boot (it demands Google Cloud Tasks);
#   * `dev`/`local` would switch on a dev fallback that reaches api.openai.com.
# PROVIDER_MODE is deliberately NOT set: upstream uses it to mean "fake providers", and a self-hosted
# stack runs real providers that merely happen to be local.
OMI_ENV_STAGE=selfhost

# --- encryption secret (REQUIRED at import-time, >=32 bytes) — REPLACE with `openssl rand -hex 32` ---
# Deliberately SHORT so utils/encryption.py fails loudly at import until you replace it: booting with
# this committed, publicly-known value would protect every user's data at rest with a predictable key
# (cubic review 4939247683). Run the sed in the header above after copying this file.
ENCRYPTION_SECRET=CHANGE_ME

# --- canonical memory intake (ADR-0062, BACKLOG L33) ---
# DECLARED EXPLICITLY on purpose. With this variable unset, config/memory_rollout.py defaults the
# rollout mode to `off` and EVERY memory write answers 503 "Service temporarily unavailable" while the
# readiness probe stays green — a product feature silenced by an implicit default, which is the worst
# shape a default can take. `on` needs the scheduled memory-maintenance runner (compose:
# `--profile jobs`, k8s: the memoryMaintenance CronJob), otherwise the outbox is never drained and a
# written memory never gets its projection or its vector.
# HELD at `off` pending a decision (BACKLOG L33/L37): `on` is wanted, but the canonical memory outbox's
# "projection" event IS the Typesense keyword index (projection_upsert = sync_atom_keyword_index_for_item),
# and with no Typesense deployed every projection_sync stays retryable_failure forever — one permanently
# stuck event per memory written. Observed on a live stack.
MEMORY_ENABLED=off
# Signs the memory-list keyset cursor. Without it read_page raises 503 "Memory cursor unavailable" and
# the list endpoint falls back to an offset read for the FIRST page only — the list works until a user
# pages, then breaks. Generate with the header sed pattern:
#   sed -i "s/^MEMORY_V3_CURSOR_SECRET=.*/MEMORY_V3_CURSOR_SECRET=$(openssl rand -hex 32)/" backend.env.base
MEMORY_V3_CURSOR_SECRET=CHANGE_ME
# The maintenance work's OWN switch, separate from MEMORY_ENABLED and defaulting to false. With it off
# the hourly run returns early reporting user_count=0 and zero errors — a green tick that drained
# nothing, which is how a broken queue looks healthy. Found live: the outbox stayed at 2 pending across
# a "successful" tick. Keep it paired with MEMORY_ENABLED (upstream's deploy validator enforces the
# same pairing for its Cloud Run job).
MEMORY_CANONICAL_MAINTENANCE_ENABLED=false

# --- storage: Mongo is the on-prem DEFAULT (ADR-0002/0046), durable and no-Google ---
STORAGE_BACKEND=mongo
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0

# --- Firestore path (OPT-IN, ADR-0046) — Firestore stays a first-class, choosable backend (ADR-0003) ---
# To use the Firestore reference adapter instead of Mongo set STORAGE_BACKEND=firestore, then:
#   DEV: bring up the emulator (compose.dev.yaml --profile firestore) and set, in backend.env.dev:
#          FIRESTORE_EMULATOR_HOST=firestore-emulator:8085
#          FIREBASE_AUTH_EMULATOR_HOST=firestore-emulator:9099
#   PROD: point at a REAL Firestore (no emulator container is ever run in base/prod) via real
#         credentials — the emulator hosts stay UNSET.
# These project ids are harmless identifiers under Mongo (no Firestore client is constructed).
FIREBASE_PROJECT_ID=demo-omi-local
FIREBASE_AUTH_PROJECT_ID=demo-omi-local
GOOGLE_CLOUD_PROJECT=demo-omi-local

# --- Valkey (redis-compatible) ---
REDIS_DB_HOST=valkey
REDIS_DB_PORT=6379

# --- CORS: do NOT use '*' (main.py raises RuntimeError) ---
CORS_ALLOWED_ORIGINS=

# --- Optional backend toggles (feature/profile choices, same in any env). Uncomment to switch: ---
# storage: Mongo is the default (above). Firestore reference adapter is opt-in — see the Firestore path note above.
# object store (ADR-0032): OBJECT_STORE_BACKEND=s3 + S3_ENDPOINT=http://rustfs:9000 (--profile objstore).
#   S3_ACCESS_KEY/S3_SECRET_KEY go in the deploy/onprem .env (compose-level), NOT here — RustFS (server) and
#   the backend (client) both interpolate them from there so they always match (default rustfsadmin).
#   S3_PUBLIC_ENDPOINT is REQUIRED for public object URLs (logos/thumbnails/recordings): S3_ENDPOINT
#   (rustfs:9000) is internal, so public_url must NOT fall back to it. Set an externally reachable base, e.g.
#   S3_PUBLIC_ENDPOINT=https://files.mydomain.locale . On AWS bucket-owner-enforced buckets set S3_PUBLIC_ACL=
#   (empty) and grant public access via a bucket policy.
# push (ADR-0011): PUSH_NOTIFICATION_BACKEND=unifiedpush + UNIFIEDPUSH_INTERNAL_BASE_URL=http://ntfy:80 (--profile push)
# auth (ADR-0034): AUTH_BACKEND=oidc + OIDC_ISSUER=${KC_HOSTNAME}/realms/omi +
#   OIDC_JWKS_URL=http://keycloak:8090/realms/omi/protocol/openid-connect/certs + OIDC_AUDIENCE=omi-backend (--profile auth).
#   Admin API (user-name resolution for memory attribution) via the omi-backend-admin service-account client:
#     OIDC_ADMIN_API_URL=http://keycloak:8090/admin/realms/omi · OIDC_ADMIN_TOKEN_URL=http://keycloak:8090/realms/omi/protocol/openid-connect/token
#     OIDC_ADMIN_CLIENT_ID=omi-backend-admin · OIDC_ADMIN_CLIENT_SECRET=CHANGE_ME
#   SECURITY: OIDC_ADMIN_CLIENT_SECRET MUST match the omi-backend-admin `secret` in the imported realm
#   (keycloak/omi-realm.example.json ships the placeholder CHANGE_ME). This client carries realm-management
#   view-users, so REGENERATE BOTH to a strong shared secret before exposing Keycloak — a known secret lets
#   anyone reaching the token endpoint enumerate every realm user.
# STT/diarization/translation (--profile inference): HOSTED_PARAKEET_API_URL=http://parakeet:8080 ·
#   HOSTED_SPEAKER_EMBEDDING_API_URL=http://diarizer:8080 · HOSTED_TRANSLATION_API_URL=http://nllb:8080 + TRANSLATION_SERVICE_MODELS=nllb ·
#   STT_SERVICE_MODELS=parakeet · STT_PRERECORDED_MODEL=parakeet  (see SELFHOST_NOTES "Local inference")
