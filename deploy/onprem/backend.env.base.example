# backend.env.base — COMMON backend env for every on-prem environment. Copy to `backend.env.base`
# (gitignored) and generate the secret:
#   cp backend.env.base.example backend.env.base
#   sed -i "s/^ENCRYPTION_SECRET=.*/ENCRYPTION_SECRET=$(openssl rand -hex 32)/" backend.env.base
# Layered with a per-env file by compose.{dev,prod}.yaml (env_file: [backend.env.base, backend.env.<env>]),
# last-wins. Env-specific values (auth, inference endpoints, LOCAL_DEVELOPMENT) live in backend.env.{dev,prod}.
# The authoritative map of the four environments (prod/dev/test-unit/test-e2e) — network, inference,
# auth, store, seed, exposure — is SELFHOST_NOTES.md "Environments — the authoritative map (ADR-0043)".

# --- offline mode / stage (on-prem is offline in every environment) ---
PROVIDER_MODE=offline
OMI_ENV_STAGE=offline

# --- encryption secret (REQUIRED at import-time, >=32 bytes) — REPLACE with `openssl rand -hex 32` ---
# Deliberately SHORT so utils/encryption.py fails loudly at import until you replace it: booting with
# this committed, publicly-known value would protect every user's data at rest with a predictable key
# (cubic review 4939247683). Run the sed in the header above after copying this file.
ENCRYPTION_SECRET=CHANGE_ME

# --- storage: Mongo is the on-prem DEFAULT (ADR-0002/0046), durable and no-Google ---
STORAGE_BACKEND=mongo
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0

# --- Firestore path (OPT-IN, ADR-0046) — Firestore stays a first-class, choosable backend (ADR-0003) ---
# To use the Firestore reference adapter instead of Mongo set STORAGE_BACKEND=firestore, then:
#   DEV: bring up the emulator (compose.dev.yaml --profile firestore) and set, in backend.env.dev:
#          FIRESTORE_EMULATOR_HOST=firestore-emulator:8085
#          FIREBASE_AUTH_EMULATOR_HOST=firestore-emulator:9099
#   PROD: point at a REAL Firestore (no emulator container is ever run in base/prod) via real
#         credentials — the emulator hosts stay UNSET.
# These project ids are harmless identifiers under Mongo (no Firestore client is constructed).
FIREBASE_PROJECT_ID=demo-omi-local
FIREBASE_AUTH_PROJECT_ID=demo-omi-local
GOOGLE_CLOUD_PROJECT=demo-omi-local

# --- Valkey (redis-compatible) ---
REDIS_DB_HOST=valkey
REDIS_DB_PORT=6379

# --- CORS: do NOT use '*' (main.py raises RuntimeError) ---
CORS_ALLOWED_ORIGINS=

# --- Optional backend toggles (feature/profile choices, same in any env). Uncomment to switch: ---
# storage: Mongo is the default (above). Firestore reference adapter is opt-in — see the Firestore path note above.
# object store (ADR-0032): OBJECT_STORE_BACKEND=s3 + S3_ENDPOINT=http://rustfs:9000 (--profile objstore).
#   S3_ACCESS_KEY/S3_SECRET_KEY go in the deploy/onprem .env (compose-level), NOT here — RustFS (server) and
#   the backend (client) both interpolate them from there so they always match (default rustfsadmin).
# push (ADR-0011): PUSH_NOTIFICATION_BACKEND=unifiedpush + UNIFIEDPUSH_INTERNAL_BASE_URL=http://ntfy:80 (--profile push)
# STT/diarization/translation (--profile inference): HOSTED_PARAKEET_API_URL=http://parakeet:8080 ·
#   HOSTED_SPEAKER_EMBEDDING_API_URL=http://diarizer:8080 · HOSTED_TRANSLATION_API_URL=http://nllb:8080 + TRANSLATION_SERVICE_MODELS=nllb ·
#   STT_SERVICE_MODELS=parakeet · STT_PRERECORDED_MODEL=parakeet  (see SELFHOST_NOTES "Local inference")
