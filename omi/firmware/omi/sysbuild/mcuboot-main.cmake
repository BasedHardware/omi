# The MCUboot-only Zephyr module includes this application overlay before
# upstream declares its sources.
# Defer replacement until the upstream directory has added main.c. All other
# upstream bootutil, crypto, signing and partition logic remains SDK-owned.
function(cv1_replace_mcuboot_main)
  get_property(targets DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" PROPERTY BUILDSYSTEM_TARGETS)
  set(replaced 0)
  foreach(target IN LISTS targets)
    get_target_property(sources ${target} SOURCES)
    if(NOT sources)
      continue()
    endif()
    set(updated)
    foreach(source IN LISTS sources)
      if(source STREQUAL "main.c" OR source STREQUAL "${CMAKE_CURRENT_SOURCE_DIR}/main.c")
        list(APPEND updated "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/mcuboot_boot_zephyr.c")
        math(EXPR replaced "${replaced} + 1")
      else()
        list(APPEND updated "${source}")
      endif()
    endforeach()
    set_property(TARGET ${target} PROPERTY SOURCES "${updated}")
  endforeach()
  if(NOT replaced EQUAL 1)
    message(FATAL_ERROR "CV1 requires exactly one MCUboot main.c replacement; found ${replaced}")
  endif()
  message(STATUS "CV1 MCUboot: Omi SD initialization main selected")
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL cv1_replace_mcuboot_main)
