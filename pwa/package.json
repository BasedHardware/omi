{
  "name": "@omi-v5/pwa-validation",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "dependencies": {
    "lucide-react-native": "1.31.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native-safe-area-context": "5.9.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "0.21.2"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "format": "bun x prettier --write 'src/**/*.{ts,css}' 'tests/**/*.ts' 'public/**/*.{json,js}' 'index.html' 'vite.config.ts'",
    "format:check": "bun x prettier --check 'src/**/*.{ts,css}' 'tests/**/*.ts' 'public/**/*.{json,js}' 'index.html' 'vite.config.ts'",
    "lint": "bun run typecheck",
    "preview": "vite preview --host 127.0.0.1",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^22",
    "@types/react": "19.2.18",
    "prettier": "2.8.8",
    "typescript": "5.7.3",
    "vite": "7.3.6"
  }
}
