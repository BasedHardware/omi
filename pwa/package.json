{
  "name": "@omi-v5/pwa-validation",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "dependencies": {
    "lucide-react-native": "1.31.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native-safe-area-context": "5.9.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "0.21.2",
    "streamdown": "2.6.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "format": "bun x prettier --write 'src/**/*.{ts,tsx,css}' 'tests/**/*.ts' 'public/**/*.{json,js}' '*.html' 'vite.config.ts'",
    "format:check": "bun x prettier --check 'src/**/*.{ts,tsx,css}' 'tests/**/*.ts' 'public/**/*.{json,js}' '*.html' 'vite.config.ts'",
    "lint": "bun run typecheck",
    "preview": "vite preview --host 127.0.0.1",
    "test": "bun test && bun ../scripts/test-metro-startup.ts",
    "typecheck": "bun x tsc --noEmit"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.3.14",
    "@types/node": "^22",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "prettier": "2.8.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3",
    "vite": "7.3.6"
  }
}
