      "now": [2026, 8, 15, 10, 0],
      "due": [2026, 8, 15, 23, 59],
      "created": [2026, 8, 14, 10, 0],
      "expected": { "fold_overdue": "today", "separate_overdue": "today" }
    },
    {
      "name": "due_tomorrow_start",
      "now": [2026, 8, 15, 10, 0],
      "due": [2026, 8, 16, 0, 0],
      "created": [2026, 8, 14, 10, 0],
      "expected": { "fold_overdue": "tomorrow", "separate_overdue": "tomorrow" }
    },
    {
      "name": "due_tomorrow_last_minute",
      "now": [2026, 8, 15, 10, 0],
      "due": [2026, 8, 16, 23, 59],
