SELECT
    coalesce(properties.billing_event_id, properties.event_id, properties['$insert_id'], uuid) AS event_id,
    event AS event_name,
    distinct_id AS user_id,
    coalesce(properties.occurred_at, timestamp) AS occurred_at,
    timestamp AS ingested_at,
    coalesce(properties['$app_namespace'], properties.namespace, 'default') AS namespace,
    coalesce(properties['$environment'], properties.environment, 'unknown') AS environment,
    coalesce(properties['$app_build'], properties.app_build, 'unknown') AS app_build,
    properties
FROM events
WHERE event IN (
    'Product Journey Started',
    'Product Journey First Result',
    'Product Journey Outcome',
    'Product Value',
    'Account Created',
    'User Signed Up',
    'Billing Subscription Started',
    'Billing Subscription Churned',
    'Product Error'
    , 'Product Feedback Submitted'
    , 'Recording Started'
    , 'Recording Completed'
    , 'Recording Start Failed'
    , 'Phone Mic Recording Started'
    , 'Phone Mic Recording Stopped'
    , 'Transcribe Later Recording Processed'
    , 'Recording Observation'
    , 'Mobile Telemetry Health'
    , 'Mobile Render Observation'
    , 'Billing Paid Population Snapshot'
    , 'experiment_assigned'
    , 'experiment_exposed'
    , 'experiment_outcome'
)
  AND timestamp >= {date_from}
  AND timestamp < {date_to}
