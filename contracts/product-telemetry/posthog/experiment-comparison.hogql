SELECT
    coalesce(properties.billing_event_id, properties.event_id, properties['$insert_id'], uuid) AS event_id,
    event AS event_name,
    distinct_id AS user_id,
    coalesce(properties.occurred_at, timestamp) AS occurred_at,
    timestamp AS ingested_at,
    coalesce(properties['$app_namespace'], properties.namespace, 'default') AS namespace,
    coalesce(properties['$environment'], properties.environment, 'unknown') AS environment,
    coalesce(properties['$app_build'], properties.app_build, 'unknown') AS app_build,
    properties
FROM events
WHERE event IN (
    'experiment_assigned',
    'experiment_exposed',
    'experiment_outcome',
    'Experiment Enrolled',
    'Experiment Assignment',
    'Experiment Exposed',
    'Experiment Outcome',
    'Product Journey Outcome',
    'Product Value'
)
  AND timestamp >= {date_from}
  AND timestamp < {date_to}
