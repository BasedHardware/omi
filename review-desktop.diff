+++ b/desktop/macos/Desktop/Sources/MainWindow/Pages/MemoriesViewModel+CacheMaintenance.swift
@@ -0,0 +1,49 @@
+import Foundation
+
+// MARK: - Cache Maintenance
+
+extension MemoriesViewModel {
+
+  /// Reconcile's server page transport. Extracted from `MemoriesPage.swift`
+  /// to keep that file inside its line-count ceiling; behavior unchanged.
+  func fetchReconcilePage(
+    limit: Int,
+    cursor: String?,
+    authorizationSnapshot: RuntimeOwnerAuthorizationSnapshot?
+  ) async throws -> APIClient.MemoryListPage {
+    if let reconcilePageFetch {
+      return try await reconcilePageFetch(limit, cursor, authorizationSnapshot)
+    }
+    // Archive is included so the pulled population matches the scope the prune
+    // claims; a default-scope pull would read Archive rows as absent.
+    return try await APIClient.shared.getMemoriesPage(
+      limit: limit,
+      cursor: cursor,
+      includeArchive: true,
+      authorizationSnapshot: authorizationSnapshot)
+  }
+
+  /// Give stranded local-only rows a bounded fate: purge them once per launch
+  /// per user, next to the reconcile. See
+  /// `MemoryStorage.purgeStaleLocalOnlyMemories(olderThan:now:)` for why rows
+  /// younger than the bound are kept.
+  func purgeStaleLocalOnlyMemoriesIfNeeded() async {
+    let userId = UserDefaults.standard.string(forKey: .authUserId) ?? "unknown"
+    guard !LocalOnlyPurgeLatch.purgedUserIDs.contains(userId) else { return }
+    do {
+      let purged = try await MemoryStorage.shared.purgeStaleLocalOnlyMemories()
+      LocalOnlyPurgeLatch.purgedUserIDs.insert(userId)
+      if purged > 0 {
+        log("MemoriesViewModel: Purged \(purged) stranded local-only memories (older than 30 days)")
+      }
+    } catch {
+      // No latch on failure: retry on the next load this launch or the next launch.
+      logError("MemoriesViewModel: Stale local-only purge failed (will retry)", error: error)
+    }
+  }
+
+  /// Purge runs once per launch per user, mirroring the reconcile latch.
+  @MainActor private enum LocalOnlyPurgeLatch {
+    static var purgedUserIDs: Set<String> = []
+  }
+}
diff --git a/desktop/macos/Desktop/Sources/MainWindow/Pages/MemoriesViewModel+DeleteRecovery.swift b/desktop/macos/Desktop/Sources/MainWindow/Pages/MemoriesViewModel+DeleteRecovery.swift
new file mode 100644
index 000000000000..ba3e494b7d05
--- /dev/null
+++ b/desktop/macos/Desktop/Sources/MainWindow/Pages/MemoriesViewModel+DeleteRecovery.swift
@@ -0,0 +1,102 @@
+import Foundation
+
+/// Classifies a failed server memory delete and bounds its deferred retry.
+///
+/// The backend's account-wide destructive-operation gate answers a concurrent
+/// delete with 409 `account_gate_busy` plus a `Retry-After` header. That answer
+/// means "try again shortly", not "the delete is impossible" — but the old
+/// failure path restored the row on any error, so every delete during a
+/// retention-cleanup window visibly resurrected seconds after the user
+/// confirmed it.
+enum MemoryDeleteRecovery {
+  /// Matches `ACCOUNT_GATE_BUSY_DETAIL` in `backend/utils/other/account_gate_http.py`.
+  static let gateBusyDetail = "account_gate_busy"
+  static let minRetryDelay: TimeInterval = 5
+  static let maxRetryDelay: TimeInterval = 300
+  /// Used when the server sent no usable `Retry-After`.
+  static let defaultRetryDelay: TimeInterval = 30
+
+  /// The bounded retry delay for a gate-busy delete failure, or nil when the
+  /// failure is not retryable and the caller must restore the row.
+  static func retryDelay(for error: Error) -> TimeInterval? {
+    switch error {
+    case APIError.memoryDeleteGateBusy(let retryAfterSeconds):
+      return clamp(retryAfterSeconds)
+    case APIError.httpError(let statusCode, let detail)
+    where statusCode == 409 && detail == gateBusyDetail:
+      return clamp(nil)
+    default:
+      return nil
+    }
+  }
+
+  /// Clamp the server's hint to a sane backoff window: long enough to let the
+  /// gate clear, short enough that a stuck gate cannot hold a pending delete
+  /// hostage for the rest of the session.
+  static func clamp(_ seconds: Int?) -> TimeInterval {
+    guard let seconds, seconds > 0 else { return defaultRetryDelay }
+    return min(max(TimeInterval(seconds), minRetryDelay), maxRetryDelay)
+  }
+}
+
+/// Runs the single deferred retry for a gate-busy delete.
+///
+/// Holds at most one pending retry: a new schedule replaces (cancels) the
+/// previous one, so repeated failures cannot accumulate tasks. The task holds
+/// the scheduler weakly and the scheduler cancels its task on deinit, so a
+/// deallocated view model cannot fire a late retry into a fresh instance.
+/// The sleeper is injected so tests drive the delay deterministically.
+@MainActor
+final class MemoryDeleteRetryScheduler {
+  typealias Sleeper = @Sendable (TimeInterval) async throws -> Void
+
+  private let sleeper: Sleeper
+  private var task: Task<Void, Never>?
+
+  /// Delay of the currently pending retry, or nil when none is scheduled.
+  private(set) var pendingDelay: TimeInterval?
+
+  /// How many deferred retries have actually run.
+  private(set) var retryCount = 0
+
+  init(sleeper: Sleeper? = nil) {
+    self.sleeper = sleeper ?? MemoryDeleteRetryScheduler.taskSleeper
+  }
+
+  /// Schedule one deferred `retry`. A pending retry is cancelled first; when
+  /// the sleeper throws (cancellation) the retry is dropped without running.
+  func schedule(after delay: TimeInterval, retry: @escaping @MainActor () async -> Void) {
+    task?.cancel()
+    pendingDelay = delay
+    task = Task { [weak self] in
+      guard let self else { return }
+      do {
+        try await self.sleeper(delay)
+      } catch {
+        self.pendingDelay = nil
+        return
+      }
+      guard !Task.isCancelled else {
+        self.pendingDelay = nil
+        return
+      }
+      self.pendingDelay = nil
+      self.retryCount += 1
+      await retry()
+    }
+  }
+
+  func cancel() {
+    task?.cancel()
+    task = nil
+    pendingDelay = nil
+  }
+
+  deinit {
+    task?.cancel()
+  }
+
+  static let taskSleeper: Sleeper = { delay in
+    try await Task.sleep(nanoseconds: UInt64(delay * 1_000_000_000))
+  }
+}
diff --git a/desktop/macos/Desktop/Sources/Rewind/Core/MemoryStorage+StaleLocalOnlyPurge.swift b/desktop/macos/Desktop/Sources/Rewind/Core/MemoryStorage+StaleLocalOnlyPurge.swift
new file mode 100644
index 000000000000..a98d48d9e866
--- /dev/null
+++ b/desktop/macos/Desktop/Sources/Rewind/Core/MemoryStorage+StaleLocalOnlyPurge.swift
@@ -0,0 +1,43 @@
+import Foundation
+@preconcurrency import GRDB
+
+// MARK: - Stale Local-Only Purge
+
+extension MemoryStorage {
+  /// Soft-delete local-only rows stranded by a failed backend create.
+  ///
+  /// The extraction durability pipeline inserts locally first; when the remote
+  /// create fails (for example an expired auth refresh), the row stays
+  /// `backendId NULL, backendSynced false` forever because nothing retries
+  /// `getUnsyncedMemories()`. Such rows keep counting in cache-first surfaces
+  /// — home knowledge count, local search, Spotlight candidates — while the
+  /// Memories page renders the authoritative server page, so the user has no
+  /// delete affordance for them. Rows younger than `days` are kept so a stuck
+  /// extraction has a window to be retried; rows with a backendId are never
+  /// touched (those are the reconcile's to prune).
+  @discardableResult
+  func purgeStaleLocalOnlyMemories(olderThan days: Int = 30, now: Date = Date()) async throws -> Int {
+    let db = try await ensureInitialized()
+    let cutoff = now.addingTimeInterval(-TimeInterval(days) * 86_400)
+    let purged = try await db.write { database -> Int in
+      let stale =
+        try MemoryRecord
+        .filter(Column("backendId") == nil)
+        .filter(Column("backendSynced") == false)
+        .filter(Column("deleted") == false)
+        .filter(Column("createdAt") < cutoff)
+        .fetchAll(database)
+      for var record in stale {
+        record.deleted = true
+        record.updatedAt = now
+        try record.update(database)
+      }
+      return stale.count
+    }
+    if purged > 0 {
+      log("MemoryStorage: Purged \(purged) stale local-only memories older than \(days) days")
+      HomeKnowledgeCountInvalidation.post()
+    }
+    return purged
+  }
+}
