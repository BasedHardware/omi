diff --git a/desktop/macos/Desktop/Sources/MainWindow/Pages/MemoriesViewModel+CacheMaintenance.swift b/desktop/macos/Desktop/Sources/MainWindow/Pages/MemoriesViewModel+CacheMaintenance.swift
