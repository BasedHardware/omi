ARG PYTHON_BASE_IMAGE=python:3.13-slim-bookworm
ARG UV_VERSION=0.12.5

FROM ${PYTHON_BASE_IMAGE} AS builder

ARG UV_VERSION
ENV PATH="/opt/venv/bin:$PATH"
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV UV_LINK_MODE=copy

RUN python -m venv /opt/venv && \
    python3 -m pip install --no-cache-dir "uv==${UV_VERSION}"

# build-essential (not bare gcc): slim image lacks libc headers otherwise, and
# webrtcvad may compile from source.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/omi-backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --compile-bytecode

FROM ${PYTHON_BASE_IMAGE}

WORKDIR /app
ENV PATH="/opt/venv/bin:$PATH"

# No ffmpeg/curl/unzip: ST→LT maintenance is Firestore/LLM/vector only.
# Patch OS packages in this layer (#7136).
RUN apt-get update && apt-get -y dist-upgrade && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
COPY backend/ .
COPY backend/modal/ .

CMD ["python", "memory_maintenance_job.py"]
