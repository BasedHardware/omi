{
  "bucket_env_var": "BUCKET_FRAME_REQUESTS",
  "conversation_attachment_policy": "conversation_lifetime",
  "allowed_locations": ["US", "US-CENTRAL1"],
  "uniform_bucket_level_access": true,
  "public_access_prevention": "enforced",
