          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "C",
          "type": "reduce"
        }
      }
    ],
    "updated": "2026-11-07T00:00:00Z",
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "for": "5m",
    "keep_firing_for": "0s",
    "annotations": {
      "dashboard_url": "https://monitor.omi.me/d/omi-core-features",
      "summary": "Enforced retry caps are quarantining or failing more than 50 units in 30 minutes.",
      "user_impact": "Affected recordings keep their audio but wait in a held state instead of retrying; sync uploads end failed and need a re-upload or operator redrive.",
      "scope": "Counts committed cap decisions with outcome=quarantine across batch lease expiry and sync checks. Enforced for every uid only with CAPTURE_RETRY_CAP_ENFORCED on (default off); otherwise the CAPTURE_COVERAGE_MODE cohort. Agent tier only.",
      "verification": "Read omi_capture_retry_cap_total by check and outcome, then batch worker failure reasons and sync dispatch errors.",
      "safe_next_action": "Find the failure that exhausts attempts (worker crash, OOM, provider outage) before requeueing; requeue only after the cause is fixed. Rollback: CAPTURE_RETRY_CAP_ENFORCED=false.",
      "runbook": "backend/docs/runbooks/backlog-state-machine.md",
      "threshold": ">50 quarantines in 30m for 5m; initial agent threshold, not calibrated from production.",
      "evaluated_bad": "Synthetic: 51 quarantine decisions in 30m.",
      "evaluated_good": "Synthetic: 50 quarantine decisions in 30m, or would_quarantine only."
    },
    "labels": {
