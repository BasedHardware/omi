    "annotations": {
      "summary": "Cloud Run application metrics are arriving under Stackdriver-mangled names instead of their plain omi_ names",
      "threshold": "> 0 un-normalized omi series on the cloud-run-application-metrics job for 15m",
      "user_impact": "No user impact by itself, but every alert and dashboard built on these metrics is silently matching nothing, so a real user-facing failure on a Cloud Run path could pass unnoticed.",
      "scope": "The metric_relabel_configs rewrite on the cloud-run-application-metrics scrape job.",
