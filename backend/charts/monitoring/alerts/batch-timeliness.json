[
  {
    "uid": "omi-batch-unit-unpublished-2h",
    "orgID": 1,
    "folderUID": "betdycdziadc0e",
    "ruleGroup": "Batch timeliness",
    "title": "Batch audio unit still unpublished after 2h",
    "condition": "E",
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max((omi_batch_timeliness_new_oldest_age_seconds{leg=~\"uncommitted|quarantined|assignment_held|projection\"} >= 0) and ignoring(leg) ((max_over_time(omi_batch_timeliness_observed_at_seconds[20m]) == scalar(max(max_over_time(omi_batch_timeliness_observed_at_seconds[20m])))) and (time() - max_over_time(omi_batch_timeliness_observed_at_seconds[20m]) < 1200))) or vector(0)",
          "instant": true,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(time() - max((max_over_time(omi_batch_timeliness_observed_at_seconds[20m]) == scalar(max(max_over_time(omi_batch_timeliness_observed_at_seconds[20m])))))) or vector(1e9)",
          "instant": true,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "B"
        }
      },
      {
        "refId": "C",
        "queryType": "",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(omi_batch_pipeline_oldest_age_seconds{namespace=\"prod-omi-backend\"} >= 0) or vector(0)",
          "instant": true,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "C"
        }
      },
      {
        "refId": "F",
        "queryType": "",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(time() - omi_batch_pipeline_metrics_refreshed_at_seconds{namespace=\"prod-omi-backend\"}) or vector(1e9)",
          "instant": true,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "F"
        }
      },
      {
        "refId": "D",
        "queryType": "",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "($A > 7200 && $B < 1200) || ($C > 7200 && $F < 120)",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "D",
          "type": "math"
        }
      },
      {
        "refId": "E",
        "queryType": "",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "conditions": [
            {
              "evaluator": {
                "params": [],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": [
                  "E"
                ]
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ],
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "D",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "last",
          "refId": "E",
          "type": "reduce"
        }
      }
    ],
    "updated": "2026-11-03T00:00:00Z",
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "for": "5m",
    "keep_firing_for": "0s",
    "annotations": {
      "dashboard_url": "https://monitor.omi.me/d/omi-core-features",
      "summary": "A batch unit is still unpublished after two hours (target: most audio within 30 minutes).",
      "user_impact": "An owner is missing the transcript for some recorded audio. Failed-held and quarantined units are the class that lost 165 segments on 2026-11-01.",
      "scope": "One lateness page: new-cohort uncommitted, quarantined, assignment-held and projection legs, plus all-epoch active compute commitments. Each source requires its own fresh sample; deliberate policy holds and dispositioned queue states remain excluded from the compute proxy.",
      "verification": "Read omi_batch_timeliness_new_over_sla_units and the leg label to find the class, then count that class with the batch custody census (counts only, ro-prod).",
      "safe_next_action": "Redrive or settle the unit through the batch recovery runbook. Never delete staged audio. Set BATCH_TIMELINESS_ALARM_ENABLED=false only to silence a broken sample, never a real breach. Paused at the 2026-11-08 import preparation ruling; follow unpause_criteria before enabling notifications.",
      "runbook": "backend/charts/monitoring/batch-projection/README.md",
      "threshold": "($A > 7200 && $B < 1200) || ($C > 7200 && $F < 120) for 5m",
      "evaluated_bad": "Synthetic: a new quarantined unit age 3h with a fresh timeliness sample, or an all-epoch compute commitment age 7201s with a fresh queue sample.",
      "evaluated_good": "Synthetic: neither fresh source measures a unit older than 7200s; unmeasured queue priorities are covered separately by the blind page.",
      "unpause_criteria": "After #24731/#24893 drain work reaches production, require both fresh timeliness and queue sources below 7200s continuously for 24h, with no blind scan. The drain owner must approve a separate unpause change; missing or stale samples do not count as healthy."
    },
    "labels": {
      "alert_identity": "omi-batch-unit-unpublished-2h",
      "component": "batch-pipeline",
      "impact": "product",
      "severity": "critical",
      "instatus_component": "speech-processing",
      "tier": "page",
      "audience": "human",
      "owner": "two-lane-lead"
    },
    "isPaused": true,
    "notification_settings": {
      "receiver": "Omi - Services Alerting (Telegram)",
      "group_by": [
        "alertname"
      ],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "4h",
      "mute_time_intervals": []
    },
    "record": null
  },
