    "folderUID": "betdycdziadc0e",
    "ruleGroup": "Batch timeliness",
    "title": "Batch audio unit still unpublished 2h after admission",
    "condition": "E",
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(omi_batch_timeliness_new_oldest_age_seconds{leg=~\"uncommitted|quarantined|assignment_held|projection\"})",
          "instant": true,
          "intervalMs": 1000,
