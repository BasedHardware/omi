    "updated": "2026-11-02T00:00:00Z",
    "noDataState": "OK",
    "execErrState": "KeepLast",
    "for": "5m",
    "keep_firing_for": "0s",
    "annotations": {
      "dashboard_url": "https://monitor.omi.me/d/omi-core-features",
      "summary": "A batch audio unit admitted after the timeliness epoch has not reached its owner within 2 hours (target: most audio within 30 minutes).",
      "user_impact": "An owner is missing the transcript for some recorded audio. Failed-held and quarantined units are the class that lost 165 segments on 2026-11-01.",
      "scope": "omi_batch_timeliness_new_oldest_age_seconds from the batch worker queue sample, legs uncommitted (policy holds skipped), quarantined (held, prepared, running, failed_held), assignment_held (committed, projection receipt quarantined) and projection. quarantine_held_rows and backlog counts are visible but never alarm. Alert-only: no rollback or ramp guard reads it.",
      "verification": "Read omi_batch_timeliness_new_over_sla_units and the leg label to find the class, then count that class with the batch custody census (counts only, ro-prod).",
      "safe_next_action": "Redrive or settle the unit through the batch recovery runbook. Never delete staged audio. Set BATCH_TIMELINESS_ALARM_ENABLED=false only to silence a broken sample, never a real breach.",
      "runbook": "backend/charts/monitoring/batch-projection/README.md",
      "threshold": "$A > 7200 && $B < 900 for 5m",
      "evaluated_bad": "Synthetic: a quarantined failed_held unit admitted after the epoch, 3h old.",
      "evaluated_good": "Synthetic: only units admitted before the epoch are late, or every new unit published within 2h."
    },
    "labels": {
      "alert_identity": "omi-batch-unit-unpublished-2h",
      "component": "batch-pipeline",
      "impact": "product",
      "severity": "warning",
      "instatus_component": "speech-processing",
      "tier": "agent",
      "audience": "agent",
      "owner": "two-lane-lead"
    },
    "isPaused": false,
