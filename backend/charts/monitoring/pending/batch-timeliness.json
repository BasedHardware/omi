        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": {
          "from": 900,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max(omi_batch_timeliness_observed_at_seconds)",
          "instant": true,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "B"
        }
      },
      {
        "refId": "D",
        "queryType": "",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "$A > 7200 && $B < 900",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "D",
          "type": "math"
        }
      },
      {
        "refId": "E",
