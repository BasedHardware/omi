{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omi.me/schema/listen-realtime-protocol/0.2.0.json",
  "title": "Omi /listen Realtime WebSocket Protocol",
  "description": "Hand-written schema-of-record for the /listen WebSocket wire format. Ported into core/ from prototypes/listen-schema (attribution: overnight spike 2026-08-06) with entitlement frame + reserved close code added per WS-003 / backend-handoff-requirements. JSON Schema describes individual frame payloads; everything JSON Schema cannot express (handshakes, close codes, frame-level non-envelope shapes, sequence invariants) lives under x-omi-* annotation keys.",
  "x-omi-protocol": {
    "spec": "listen-realtime-protocol",
    "baseline": "e0893286f94ecc75aacb4cbc441f653f347e382b",
    "schema_version": "0.2.0",
    "transport": "websocket",
    "version_knob": {
      "present": false,
      "finding": "No version field, header, or query param exists in either handshake or any frame at baseline (UNK-LISTEN-007 requirement 6).",
      "proposed": {
        "mechanism": "query-param",
        "name": "protocol_version",
        "type": "integer",
        "default_when_absent": 1,
        "rationale": "A query param is observable at admission, before any frame is exchanged, so the server can reject or downgrade before spending an STT connection. A first-frame field would require accepting the socket first, which is already the source of the two-handshake problem."
      }
    },
    "handshakes": [
      {
        "id": "native",
        "path": "/v4/listen",
        "auth": {
          "mechanism": "dependency",
          "detail": "uid derived server-side from the Authorization header on the WS upgrade (get_current_user_uid_ws_listen). No client-supplied uid param in the canonical model.",
          "locator": "omi:backend/routers/transcribe.py:121-160"
        },
        "params": [
          "language",
          "sample_rate",
          "codec",
          "channels",
          "include_speech_profile",
          "stt_service",
          "conversation_timeout",
          "source",
          "custom_stt",
          "onboarding",
          "speaker_auto_assign",
          "create_speakers",
          "vad_gate",
          "call_id",
          "client_conversation_id"
        ]
      },
      {
        "id": "web",
        "path": "/v4/web/listen",
        "auth": {
          "mechanism": "first-frame",
          "detail": "Socket is accepted unconditionally, then the server waits up to 5s for a text frame {\"type\":\"auth\",\"token\":...} and replies {\"type\":\"auth_response\",\"success\":bool}. Timeout or failure closes 1008.",
          "timeout_seconds": 5,
          "request_ref": "#/$defs/ClientAuthMessage",
          "response_ref": "#/$defs/AuthResponseFrame",
          "locator": "omi:backend/routers/transcribe.py:161-200"
        },
        "params": [
          "language",
          "sample_rate",
          "codec",
          "channels",
          "include_speech_profile",
          "conversation_timeout",
          "source",
          "custom_stt",
          "onboarding",
          "call_id",
          "client_conversation_id"
        ],
        "params_absent_vs_native": [
          "stt_service",
          "speaker_auto_assign",
          "create_speakers",
          "vad_gate"
        ]
      }
    ],
    "params_canonical_ref": "#/$defs/HandshakeParams",
    "params_duplication_finding": "Defaults are declared twice: once per route signature (omi:backend/routers/transcribe.py:121-200) and again on ListenRequest (omi:backend/routers/listen/contracts.py:24-44). #/$defs/HandshakeParams is the proposed single home both call sites should derive from.",
    "audio_upload": {
      "frame_kind": "binary",
      "codecs": [
        "pcm8",
        "pcm16",
        "linear16",
        "opus",
        "aac",
        "lc3"
      ],
      "noop_max_bytes": 2,
      "noop_note": "Binary frames of length <= 2 are dropped as heartbeat padding (omi:backend/routers/listen/receiver.py:483-485).",
      "multi_channel": {
        "trigger": "channels >= 2",
        "framing": "first byte of each binary frame is a channel-id tag; remainder is that channel's codec payload"
      }
    },
    "bootstrap_sequence": [
      {
        "event": "service_status",
        "status": "initiating",
        "required": true
      },
      {
        "event": "last_memory",
        "required": false
      },
      {
        "event": "service_status",
        "status": "in_progress_conversations_processing",
        "required": true
      },
      {
        "event": "conversation_session",
        "required": false
      },
      {
        "event": "service_status",
        "status": "stt_initiating",
        "required": true
      },
      {
        "event": "service_status",
        "status": "ready",
        "required": true
      }
    ],
    "close_codes": [
      {
        "code": 1000,
        "name": "normal",
        "emitted_by_listen": true,
        "meaning": "Client-initiated close, or the server echoing the ASGI disconnect frame's own code verbatim. Drives clean desktop finalization.",
        "locator": "omi:backend/routers/listen/receiver.py:481",
        "client_should_retry": true
      },
      {
        "code": 1001,
        "name": "going_away",
        "emitted_by_listen": true,
        "meaning": "Default close code. Heartbeat-detected staleness (no inbound activity for 90s), or the fallback at teardown when nothing overrode it (including after the 300s ws_receive_timeout silently breaks the receive loop).",
        "locator": "omi:backend/routers/listen/runtime.py:314,518,604; omi:backend/routers/listen/contracts.py:48",
        "client_should_retry": true
      },
      {
        "code": 1003,
        "name": "unsupported_audio_format",
        "emitted_by_listen": true,
        "meaning": "Bad codec/sample_rate combination, rejected at admission after accept.",
        "locator": "omi:backend/routers/listen/runtime.py:222",
        "client_should_retry": false,
        "client_action": "fix handshake params; retrying unchanged will fail identically"
      },
      {
        "code": 1008,
        "name": "policy_violation",
        "emitted_by_listen": true,
        "meaning": "Missing uid, trial expired/paywalled, unknown user, unsupported language, malformed image_chunk payload, or web-path auth timeout/failure.",
        "locator": "omi:backend/routers/listen/runtime.py:210,218,230,244; omi:backend/routers/listen/receiver.py:422; omi:backend/routers/transcribe.py:185,192,196,201",
        "client_should_retry": false,
        "client_action": "reason string is the only discriminator; treat as terminal until user state changes"
      },
      {
        "code": 1011,
        "name": "internal_error",
        "emitted_by_listen": true,
        "meaning": "STT provider init failure, detected upstream STT death (~1s poll), or an unhandled exception in the receive loop. Always preceded by service_status{status:\"stt_failed\"} (INV-LISTEN-003).",
        "locator": "omi:backend/routers/listen/receiver.py:526; omi:backend/utils/stt/live_failure.py",
        "client_should_retry": true,
        "preceded_by_event": {
          "type": "service_status",
          "status": "stt_failed"
        }
      },
      {
        "code": 4001,
        "name": "refresh_token",
        "emitted_by_listen": false,
        "meaning": "Documented in spec section 2.5 as an auth-refinement code, but NOT emitted anywhere in /listen at baseline (UNK-LISTEN-007 requirement 4). Retained here as reserved so no future code reuses the number.",
        "client_should_retry": false
      },
      {
        "code": 4004,
        "name": "force_relogin",
        "emitted_by_listen": false,
        "meaning": "As 4001 \u2014 reserved, not emitted by /listen at baseline.",
        "client_should_retry": false
      },
      {
        "code": 4020,
        "name": "entitlement_upgrade_required",
        "emitted_by_listen": false,
        "meaning": "Reserved (WS-005 / entitlements contract): WebSocket closed because entitlement requires upgrade. DISTINCT from the mid-session entitlement frame with capture_continues=true (transcription paused, capture continuing \u2014 socket stays open). A preceding entitlement event carries upgrade advice. Close-code number 4020 is provisional pending WS-005 ratification (avoiding collision with dead 4001/4004).",
        "client_should_retry": false,
        "client_action": "route to existing plan-upgrade flow; do not reconnect until entitlement changes",
        "x-omi-provisional": true
      }
    ],
    "invariants": [
      {
        "id": "INV-LISTEN-001",
        "title": "At-least-once, not exactly-once, transcript delivery",
        "checkable": true,
        "rule": "segment-id-dedupe",
        "detail": "The same segment id may be delivered more than once as batches are re-combined. A conforming client must key by segment id and upsert, never append blindly."
      },
      {
        "id": "INV-LISTEN-002",
        "title": "service_status:ready is the only safe content-start signal",
        "checkable": true,
        "rule": "no-transcript-before-ready",
        "detail": "No transcript batch should be treated as session content before service_status{status:\"ready\"}."
      },
      {
        "id": "INV-LISTEN-003",
        "title": "stt_failed always precedes a 1011 close",
        "checkable": true,
        "rule": "stt-failed-precedes-1011",
        "detail": "A 1011 close must be immediately preceded by service_status{status:\"stt_failed\"}; a 1011 without it is a protocol violation the client should report as an unexplained failure."
      },
      {
        "id": "INV-LISTEN-004",
        "title": "client_conversation_id is the resume idempotency key",
        "checkable": true,
        "rule": "resume-key-required",
        "detail": "client_conversation_id is optional at baseline, but a conforming client MUST send the same value on every reconnect of a logical capture session; omitting it fragments the conversation. Modeled as required-for-conformance (x-omi-required-for-conformance) rather than schema-required so the schema still validates baseline traffic."
      },
      {
        "id": "INV-LISTEN-005",
        "title": "Speaker-label suggestions are best-effort and revisable",
        "checkable": false,
        "detail": "speaker_label_suggestion may be superseded for the same segment_id; last write wins. Not mechanically checkable from a frame corpus."
      },
      {
        "id": "INV-LISTEN-006",
        "title": "Every fallback path emits telemetry",
        "checkable": true,
        "rule": "unknown-frame-degraded",
        "detail": "Decode-time fail-open for unknown frame kinds MUST construct Degraded via @omi-core/kernel degrade() \u2014 never a silent skip. Program invariant; S2-5 ruling extends it to decode-time fail-open."
      }
    ],
    "ordering": {
      "strict": [
        "bootstrap_sequence",
        "stt_failed -> close(1011)"
      ],
      "causal_only": [
        "transcript_batch",
        "speaker_label_suggestion",
        "translating",
        "segments_deleted"
      ],
      "note": "segments_deleted referencing an id implies that id was previously delivered in a transcript batch."
    },
    "producers": [
      {
        "id": "message_event_defaults",
        "locator": "omi:backend/models/message_event.py",
        "event_count": 10
      },
      {
        "id": "conversation_event_caller_supplied",
        "locator": "omi:backend/routers/listen/conversations.py:88",
        "event_count": 2
      },
      {
        "id": "onboarding_raw_dicts",
        "locator": "omi:backend/utils/onboarding.py:231-233",
        "event_count": 4
      },
      {
        "id": "web_handshake_raw_dict",
        "locator": "omi:backend/routers/transcribe.py:195,204",
        "event_count": 1,
        "note": "FOURTH producer, not listed in the UNK-LISTEN-007 requirements note's 3-producer enumeration. Emits auth_response. See REPORT.md open question 2."
      },
      {
        "id": "reserved_entitlement_ws005",
        "locator": "docs/backend-handoff-requirements.md#entitlements",
        "event_count": 1,
        "note": "FIFTH logical producer, not yet implemented. Reserves the entitlement frame. Field shapes provisional pending WS-005 ratification."
      }
    ],
    "unemitted_model_classes": [
      "NewConversationCreated",
      "NewProcessingConversationCreated",
      "ProcessingConversationStatusChanged",
      "MemoryBackwardSycnedEvent",
      "PingEvent"
    ],
    "non_envelope_frames": [
      {
        "id": "transcript_batch",
        "direction": "server->client",
        "shape": "bare JSON array of segment objects",
        "ref": "#/$defs/TranscriptBatchFrame",
        "locator": "omi:backend/routers/listen/transcripts.py:315",
        "discriminator": "Array.isArray(json)",
        "disposition": "permanent exception at baseline; migration to {\"type\":\"transcript\",\"segments\":[...]} is a coordinated client+server change"
      },
      {
        "id": "heartbeat",
        "direction": "server->client",
        "shape": "literal text frame \"ping\" (not JSON)",
        "ref": "#/$defs/HeartbeatFrame",
        "locator": "omi:backend/routers/listen/runtime.py:312",
        "interval_seconds": 10,
        "pong_expected": false,
        "discriminator": "raw === \"ping\"",
        "disposition": "collides with the declared-but-unemitted PingEvent {\"type\":\"ping\"}; converging on the envelope would let the schema drop this exception entirely"
      }
    ],
    "contract_of_record": "omi:core/contracts/wire/listen/listen-protocol.schema.json",
    "ported_from": "omi-frontend-unification-and-microapps-project-tracker/prototypes/listen-schema"
  },
