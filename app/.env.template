API_BASE_URL=
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
USE_WEB_AUTH=false
USE_AUTH_CUSTOM_TOKEN=false
# Additive OIDC client (ADR-0038). Default 'firebase' keeps Google/Apple untouched.
# Set AUTH_BACKEND=oidc + the OIDC_* fields to enable the SSO login path.
AUTH_BACKEND=firebase
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Custom scheme for the OIDC redirect (omiauth:/oidc-callback). Must match the
# native registrations: Android appAuthRedirectScheme (app/android/app/build.gradle)
# and the iOS `omi.oidc.auth` CFBundleURLTypes entry (app/ios/Runner/Info.plist).
OIDC_REDIRECT_SCHEME=omiauth
POSTHOG_API_KEY=
