/* Localized versions of Info.plist keys (Japanese) */

"NSBluetoothAlwaysUsageDescription" = "Omi は Bluetooth で Omi デバイスと接続し、マイクの音声を端末に送信します。例えば会議の音声を文字起こししてメモにしたり、デバイスの電池残量を確認したりします。";
"NSBluetoothPeripheralUsageDescription" = "Omi は Bluetooth で Omi デバイスと接続し、マイクの音声を端末に送信します。例えば会議の音声を文字起こししてメモにしたり、デバイスの電池残量を確認したりします。";

"NSCalendarsUsageDescription" = "Omi はこの端末のカレンダーの読み取りや変更を行いません。この説明文はアプリにカレンダー権限のサポートが含まれている関係で iOS が必須としているため記載しています。";
"NSCalendarsFullAccessUsageDescription" = "Omi はこの端末のカレンダーの読み取りや変更を行いません。この説明文はアプリにカレンダー権限のサポートが含まれている関係で iOS が必須としているため記載しています。";

"NSContactsUsageDescription" = "Omi は連絡先を使用して、アプリから電話をかけたり、会話のサマリーを SMS で共有したり、Omi チャットがメッセージを下書きする際に宛先を探したりできるようにします。";

"NSLocationWhenInUseUsageDescription" = "Omi は位置情報を使用して、会話がどこで行われたかを記録します。";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Omi は位置情報を使用して、会話がどこで行われたかを記録します。";
"NSLocationUsageDescription" = "Omi は位置情報を使用して、会話がどこで行われたかを記録します。";

"NSMicrophoneUsageDescription" = "Omi は端末のマイクを使用して、会話の録音と文字起こし、音声プロファイルの作成、チャットメッセージの音声入力、アプリ内での通話を行います。";

"NSSpeechRecognitionUsageDescription" = "音声をテキストに変換する処理をデバイス上で行うため、音声認識を使用します。";

"NSRemindersUsageDescription" = "Omi の会話からアクションアイテムを書き出すためにリマインダーへのアクセスが必要です。";
"NSRemindersFullAccessUsageDescription" = "Omi の会話からアクションアイテムを書き出すためにリマインダーへのアクセスが必要です。";

"NSHealthShareUsageDescription" = "Omi は Apple ヘルスケアから歩数、ウォーキング・ランニングの距離、アクティブエネルギー、心拍数、睡眠、ワークアウトを読み取り、フィットネス・睡眠・アクティビティについて Omi チャットで質問できるようにします。Omi が Apple ヘルスケアにデータを書き込むことはありません。";
"NSHealthUpdateUsageDescription" = "Omi は Apple ヘルスケアにデータを一切書き込みません。この説明文は HealthKit フレームワークをリンクしている関係で iOS が必須としているため記載しています。";

"NSPhotoLibraryUsageDescription" = "Omi は写真ライブラリを使用して、チャットのメッセージに写真を添付したり、作成したアプリに画像を追加したりできるようにします。";

"NSCameraUsageDescription" = "Omi はカメラを使用して、写真を撮影しチャットのメッセージに添付できるようにします。";
