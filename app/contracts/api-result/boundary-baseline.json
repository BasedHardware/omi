{
  "rules": [
    {
      "id": "legacy-nullable-http",
      "pattern": "\\bmakeApiCall\\s*\\(",
      "paths": [
        "app/lib/"
      ],
      "remedy": "Use executeApi and exhaustively handle ApiResult; see app/lib/backend/http/API_RESULTS.md. Do not turn an outage into null or an empty list.",
      "except": [
        "app/lib/backend/http/shared.dart"
      ]
    },
    {
      "id": "null-swallow-patterns",
      "pattern": "\\breturn\\s+null\\b|\\?\\?\\s*(?:<[^>]+>)?\\s*\\[\\s*\\]|\\bcatch\\s*\\(",
      "paths": [
        "app/lib/backend/http/api/",
        "app/lib/backend/http/api/action_items.dart",
        "app/lib/backend/http/api/announcements.dart",
        "app/lib/backend/http/api/apps.dart",
        "app/lib/backend/http/api/audio.dart",
        "app/lib/backend/http/api/conversations.dart",
        "app/lib/backend/http/api/dev_api.dart",
        "app/lib/backend/http/api/device.dart",
        "app/lib/backend/http/api/folders.dart",
        "app/lib/backend/http/api/goals.dart",
        "app/lib/backend/http/api/imports.dart",
        "app/lib/backend/http/api/integrations.dart",
        "app/lib/backend/http/api/knowledge_graph_api.dart",
        "app/lib/backend/http/api/mcp_api.dart",
        "app/lib/backend/http/api/memories.dart",
        "app/lib/backend/http/api/messages.dart",
        "app/lib/backend/http/api/notifications.dart",
        "app/lib/backend/http/api/payment.dart",
        "app/lib/backend/http/api/payments.dart",
        "app/lib/backend/http/api/phone_calls.dart",
        "app/lib/backend/http/api/privacy.dart",
        "app/lib/backend/http/api/speech_profile.dart",
        "app/lib/backend/http/api/task_integrations.dart",
        "app/lib/backend/http/api/tts.dart",
        "app/lib/backend/http/api/users.dart",
        "app/lib/backend/http/api/wrapped.dart",
        "app/lib/backend/http/webhooks.dart",
        "app/lib/services/account_cutover/account_cutover_control_client.dart"
      ],
      "remedy": "Move error classification to executeApi/decodeApiRows and handle ApiFailure explicitly; see app/lib/backend/http/API_RESULTS.md. Legacy debt may shrink, never grow."
    }
  ],
