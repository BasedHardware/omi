{
  "version": 1,
  "bridgeName": "OmiShellBridge",
  "comment": "Single source of truth for the macOS shell <-> TS surface bridge. Edit this file, run `node codegen/generate.mjs`, never edit a .generated.* file by hand. Screen verbs (`screen.start` …) are a shared spec with the rewind-surface lane; do not rename them.",
  "types": {
    "CaptureState": {
      "kind": "enum",
      "cases": ["idle", "starting", "recording", "error"]
    },
    "StartCaptureParams": {
      "kind": "struct",
      "fields": {
        "deviceId": { "type": "string", "optional": true },
        "sampleRateHz": { "type": "int" }
      }
    },
    "StartCaptureResult": {
      "kind": "struct",
      "fields": {
        "sessionId": { "type": "string" },
        "state": { "type": "CaptureState" }
      }
    },
    "ReadSettingParams": {
      "kind": "struct",
      "fields": {
        "key": { "type": "string" }
      }
    },
    "ReadSettingResult": {
      "kind": "struct",
      "fields": {
        "key": { "type": "string" },
        "value": { "type": "string", "optional": true }
      }
    },
    "OpenExternalParams": {
      "kind": "struct",
      "fields": {
        "url": { "type": "string" }
      }
    },
    "OpenExternalResult": {
      "kind": "struct",
      "fields": {
        "opened": { "type": "bool" }
      }
    },
    "CaptureStatusEvent": {
      "kind": "struct",
      "fields": {
        "sessionId": { "type": "string", "optional": true },
        "state": { "type": "CaptureState" },
        "elapsedMs": { "type": "int" },
        "levelDb": { "type": "double" }
      }
    },
    "ScreenEmptyParams": {
      "kind": "struct",
      "fields": {}
    },
    "ScreenCaptureState": {
      "kind": "enum",
      "cases": ["idle", "starting", "recording", "paused", "error"]
    },
    "ScreenPermission": {
      "kind": "enum",
      "cases": ["granted", "denied", "undetermined"]
    },
    "ScreenStartResult": {
      "kind": "struct",
      "fields": {
        "sessionId": { "type": "string" },
        "state": { "type": "ScreenCaptureState" }
      }
    },
    "ScreenStopResult": {
      "kind": "struct",
      "fields": {
        "state": { "type": "ScreenCaptureState" }
      }
    },
    "ScreenStatusResult": {
      "kind": "struct",
      "fields": {
        "state": { "type": "ScreenCaptureState" },
        "reason": { "type": "string", "optional": true },
        "permission": { "type": "ScreenPermission" },
        "framesStored": { "type": "int" },
        "bytesOnDisk": { "type": "int", "optional": true },
        "lastCaptureAt": { "type": "string", "optional": true }
      }
    },
    "ScreenFrameImageParams": {
      "kind": "struct",
      "fields": {
        "frameRef": { "type": "string" },
        "maxLongEdge": { "type": "int", "optional": true }
      }
    },
    "ScreenFrameImageResult": {
      "kind": "struct",
      "fields": {
        "pngBase64": { "type": "string" },
        "width": { "type": "int" },
        "height": { "type": "int" }
      }
    },
    "ScreenExclusionsListResult": {
      "kind": "struct",
      "fields": {
        "bundleIds": { "type": "string", "array": true }
      }
    },
    "ScreenExclusionsSetParams": {
      "kind": "struct",
      "fields": {
        "bundleIds": { "type": "string", "array": true }
      }
    },
    "ScreenExclusionsSetResult": {
      "kind": "struct",
      "fields": {
        "bundleIds": { "type": "string", "array": true },
        "retiredFrameRefs": { "type": "string", "array": true }
      }
    },
    "ScreenRetentionSetParams": {
      "kind": "struct",
      "fields": {
        "days": { "type": "int" }
      }
    },
    "ScreenRetentionSetResult": {
      "kind": "struct",
      "fields": {
        "days": { "type": "int" },
        "retiredFrameRefs": { "type": "string", "array": true }
      }
    },
    "ScreenRebuildIndexResult": {
      "kind": "struct",
      "fields": {
        "frames": { "type": "int" },
        "chunks": { "type": "int" }
      }
    },
    "ScreenPermissionResult": {
      "kind": "struct",
      "fields": {
        "permission": { "type": "ScreenPermission" }
      }
    },
    "ScreenOpenSettingsResult": {
      "kind": "struct",
      "fields": {
        "opened": { "type": "bool" }
      }
    },
    "ScreenStatusEvent": {
      "kind": "struct",
      "fields": {
        "state": { "type": "ScreenCaptureState" },
        "reason": { "type": "string", "optional": true },
        "permission": { "type": "ScreenPermission" },
        "framesStored": { "type": "int" },
        "bytesOnDisk": { "type": "int", "optional": true },
        "lastCaptureAt": { "type": "string", "optional": true }
      }
    }
  },
  "requests": {
    "startCapture": { "params": "StartCaptureParams", "result": "StartCaptureResult" },
    "readSetting": { "params": "ReadSettingParams", "result": "ReadSettingResult" },
    "openExternal": { "params": "OpenExternalParams", "result": "OpenExternalResult" },
    "screen.start": { "params": "ScreenEmptyParams", "result": "ScreenStartResult" },
    "screen.stop": { "params": "ScreenEmptyParams", "result": "ScreenStopResult" },
    "screen.status": { "params": "ScreenEmptyParams", "result": "ScreenStatusResult" },
    "screen.frameImage": { "params": "ScreenFrameImageParams", "result": "ScreenFrameImageResult" },
    "screen.exclusionsList": { "params": "ScreenEmptyParams", "result": "ScreenExclusionsListResult" },
    "screen.exclusionsSet": { "params": "ScreenExclusionsSetParams", "result": "ScreenExclusionsSetResult" },
    "screen.retentionSet": { "params": "ScreenRetentionSetParams", "result": "ScreenRetentionSetResult" },
    "screen.rebuildIndex": { "params": "ScreenEmptyParams", "result": "ScreenRebuildIndexResult" },
    "screen.requestPermission": { "params": "ScreenEmptyParams", "result": "ScreenPermissionResult" },
    "screen.openSettings": { "params": "ScreenEmptyParams", "result": "ScreenOpenSettingsResult" }
  },
  "events": {
    "captureStatus": { "payload": "CaptureStatusEvent" },
    "screen.status": { "payload": "ScreenStatusEvent" }
  }
}
