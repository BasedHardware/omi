{
  "mcpServers": {
    "notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server@2.5.1"],
      "env": {
        "NOTION_TOKEN": "${env:NOTION_TOKEN}"
      }
    },
    "figma": {
      "command": "npx",
      "args": ["-y", "figma-developer-mcp@0.13.2", "--stdio"],
      "env": {
        "FIGMA_API_KEY": "${env:FIGMA_ACCESS_TOKEN}"
      }
    },
    "browser": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.79"]
    }
  }
}
