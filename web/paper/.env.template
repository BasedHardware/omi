# ==============================================
# PAPER — WEB ENVIRONMENT VARIABLES
# ==============================================
# Copy to .env.local and fill in. Values come from the Omi Firebase project — the same
# ones web/app uses. Never commit a filled-in copy.

# FIREBASE CONFIGURATION (sign-in)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# API CONFIGURATION
# Where /api/proxy/* forwards to. Defaults to https://api.omi.me when unset.
NEXT_PUBLIC_API_BASE_URL=
