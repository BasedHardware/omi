{
  "name": "omi-web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate-sw": "bun scripts/generate-firebase-sw.js",
    "dev": "bun scripts/dev.ts",
    "build": "bun run generate-sw && moonshine build && bun run build:assets",
    "build:assets": "bunx tailwindcss -i src/app/globals.css -o .moonshine/public/styles.css --minify && bun scripts/copy-moonshine-assets.ts",
    "start": "bun .moonshine/server.ts",
    "lint": "bunx oxlint src scripts moonshine.config.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test scripts/moonshine-smoke.test.ts && bunx vitest run --config vitest.config.mts",
    "test:watch": "bunx vitest",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-virtual": "^3.13.18",
    "@tschk/moonshine": "^0.3.7",
    "@tschk/moonshine-compiler": "^0.3.7",
    "@tschk/moonshine-deploy-bun": "^0.3.7",
    "@tschk/moonshine-framework": "^0.3.7",
    "@tschk/moonshine-next": "^0.3.7",
    "@tschk/moonshine-react": "^0.3.7",
    "@tschk/moonshine-server": "^0.3.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.21",
    "@types/lodash": "^4.17.13",
    "@types/three": "^0.182.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "firebase": "^11.8.1",
    "framer-motion": "^11.5.4",
    "fuse.js": "^7.0.0",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "lodash": "^4.17.21",
    "lucide-react": "^0.438.0",
    "mixpanel-browser": "^2.73.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-force-graph-3d": "^1.29.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-virtualized-auto-sizer": "^2.0.2",
    "react-window": "^2.2.3",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^2.5.2",
    "three": "^0.182.0",
    "three-spritetext": "^1.10.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tschk/moonshine-cli": "^0.3.7",
    "@types/bun": "1.3.14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "@types/react-window": "^1.8.8",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "jsdom": "^29.1.1",
    "postcss": "~8.5.18",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "~8.5.18",
    "sharp": "~0.35.0",
    "@grpc/grpc-js": ">=1.9.16",
    "protobufjs": ">=7.6.3",
    "@babel/core": ">=7.26.0",
    "js-yaml": ">=4.1.1",
    "websocket-driver": ">=0.5.8"
  }
}
