# ==============================================
# OMI WEB APP ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env.local — that is the file scripts/generate-firebase-sw.js
# reads, and Bun auto-loads it for the rest of the build too.
#
# NEXT_PUBLIC_FIREBASE_API_KEY through NEXT_PUBLIC_FIREBASE_APP_ID must be
# non-empty: `bun run dev` runs the full build, whose first step
# (scripts/generate-firebase-sw.js) exits 1 when any of those six is blank, so
# the dev server never starts. They are prefilled below with Omi's public web
# config for the `based-hardware` project — the same development values CI
# builds with. config/public-build-values.json stays the source of truth; if
# these drift, copy from there.

# FIREBASE CONFIGURATION
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDSpVTxMinTZXuV89V07HkNJCgdNIhX0Dk
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=based-hardware.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=based-hardware
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=based-hardware.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=208440318997
NEXT_PUBLIC_FIREBASE_APP_ID=1:208440318997:web:98d686dbdf1dc0370e421c
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-CVV8BPC4DT

# API CONFIGURATION
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WS_BASE_URL=

# ANALYTICS
