# ==============================================
# OMI FRONTEND ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and fill in your actual values

# NEXT.JS CONFIGURATION
NEXT_PUBLIC_NODE_ENV=development

# API CONFIGURATION
API_URL=http://127.0.0.1:8787
WEB_URL=http://localhost:3000

# FIREBASE CONFIGURATION
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ADMIN & SECURITY
ADMIN_KEY=
PUBLIC_SHARED_CONVERSATION_CHAT_IP_HMAC_KEY=
PUBLIC_SHARED_CONVERSATION_CHAT_FRONTEND_AUDIENCE=

# REDIS CONFIGURATION
REDIS_DB_HOST=
REDIS_DB_PORT=
REDIS_DB_PASSWORD=

# OPENAI

# API BASE URL
# Browser-visible backend origin. API_URL above is server-only and is never
# inlined into the client bundle, so browser API modules read this instead.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8787

# ALGOLIA SEARCH CONFIGURATION
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_API_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=
