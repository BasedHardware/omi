# Omi Admin Dashboard — Environment Variables
# Copy this file to .env.local and fill in your values.

# Local development only. Set to 1 to enter the dashboard as a non-production
# dev admin without Firebase login. This bypass is hard-disabled when NODE_ENV=production.
NEXT_PUBLIC_DEV_BYPASS_AUTH=0

# Firebase Client SDK (public, safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin SDK (server-side only, never expose)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Omi Backend API
NEXT_PUBLIC_OMI_API_URL=
OMI_API_SECRET_KEY=
NEXT_PUBLIC_PLUGINS_APP_ID=

# Stripe
STRIPE_SECRET_KEY=

# Typesense
TYPESENSE_HOST=
TYPESENSE_API_KEY=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# PostgreSQL
POSTGRES_URL=

# ShipBob
SHIPBOB_API_KEY=

# Shopify
SHOPIFY_STORE=
SHOPIFY_ACCESS_TOKEN=

# Mixpanel
MIXPANEL_SECRET=
MIXPANEL_API_BASE=

OMI_LLM_GATEWAY_URL=
OMI_LLM_GATEWAY_SERVICE_TOKEN=

# PostHog
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=

# Admin features used only on their respective dashboard pages
ENCRYPTION_SECRET=
GITHUB_TOKEN=
GOAFFPRO_ACCESS_TOKEN=
TYPESENSE_CONVERSATION_COLLECTION=

# Scheduled cache precomputation and optional analytics cost overrides
CRON_SECRET=
ADMIN_INFRA_OVERHEAD_MONTHLY=
ADMIN_SERVICE_COSTS_JSON=
# Billing-mode infra costs (preferred over the estimated table above).
# Service-account JSON with BigQuery jobUser + dataViewer on the billing
# export dataset; leave unset to use ambient ADC.
GCP_BILLING_SA_JSON=
# Optional override of the billing export table (project.dataset.table).
GCP_BILLING_TABLE=
# ORG-ADMIN cost-API keys (inference keys get 401/403). Deliberately NOT
# named ANTHROPIC_API_KEY / OPENAI_API_KEY — the deploy contract strips
# those names from the admin service.
ADMIN_ANTHROPIC_COST_API_KEY=
ADMIN_OPENAI_COST_API_KEY=
# Desktop/mobile split shares from the omi-cost-analysis usage-weighted
# report: {"llm":{"desktop":..,"mobile":..},"core":{...},"asOf":"YYYY-MM-DD","method":".."}
ADMIN_PLATFORM_COST_SHARES_JSON=
