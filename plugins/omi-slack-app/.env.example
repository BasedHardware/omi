# Slack OAuth credentials (from api.slack.com/apps)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/auth/callback

# Secret used to sign the omi_slack_settings cookie.
# Required: settings writes return 503 and OAuth cannot issue a session until set.
SLACK_SETTINGS_SECRET=change-me

# Optional
OPENAI_API_KEY=
APP_HOST=0.0.0.0
APP_PORT=8000
