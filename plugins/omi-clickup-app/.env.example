# ClickUp OAuth credentials (from app.clickup.com/settings/apps)
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/auth/callback

# Secret used to sign the omi_clickup_settings cookie.
# Required: settings writes return 503 and OAuth cannot issue a session until set.
CLICKUP_SETTINGS_SECRET=change-me

# Optional
OPENAI_API_KEY=
OMI_APP_ID=
OMI_APP_SECRET=
APP_HOST=0.0.0.0
APP_PORT=8000
