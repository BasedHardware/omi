# Copy to .env and fill in. Never commit .env.

# --- Required. The server refuses payments until these are set. ---

# Hex private key of the paying wallet (LocalSigner). Use a dedicated wallet that
# holds only what you are willing to lose; it signs for every allowed user.
WALLET_PRIVATE_KEY=

# Long random string, added to every Omi URL as ?token=...
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Comma-separated Omi user IDs allowed to spend from the wallet. Empty denies everyone.
ALLOWED_UIDS=

# Public https URL of this server, used in the chat tools manifest.
PUBLIC_BASE_URL=https://YOUR_ENDPOINT

# --- Optional ---

# base-sepolia (testnet) or base (mainnet, real money).
NETWORK=base-sepolia

# Largest single payment, in USD.
MAX_PER_PAYMENT_USD=5

# Most each user can spend per UTC day, in USD.
DAILY_LIMIT_USD=20

# /pay amounts up to this run without a confirmation code. 0 confirms everything.
# Voice payments always need a code regardless of this value.
AUTO_APPROVE_USD=0

# Seconds a confirmation code stays valid.
PENDING_TTL_SECONDS=300

# Comma-separated domains that may be paid (subdomains included). Empty allows any
# public https service. Strongly recommended on mainnet.
ALLOWED_DOMAINS=

# SQLite file for the transaction log, confirmations and audit trail.
# Must be on persistent storage or daily limits reset on redeploy.
DATABASE_PATH=data/spraay.db
