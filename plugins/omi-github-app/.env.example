# GitHub OAuth App credentials (github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8000/auth/callback

# Shared secret for /tools/* server-to-server callers
GITHUB_TOOLS_SECRET=change-me

# Secret used to sign the omi_github_settings cookie.
# Required: settings writes return 503 and OAuth cannot issue a session until set.
GITHUB_SETTINGS_SECRET=change-me-too

# Optional
OPENAI_API_KEY=
APP_HOST=0.0.0.0
APP_PORT=8000
STORAGE_DIR=
DEFAULT_AGENT_PROVIDER=cursor
