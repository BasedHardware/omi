# Microsoft Azure App Registration
MICROSOFT_CLIENT_ID=your-client-id-here
MICROSOFT_CLIENT_SECRET=your-client-secret-here
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8080/auth/microsoft/callback

# App config
APP_BASE_URL=http://localhost:8080
SESSION_SECRET=generate-a-strong-random-string-here
# Shared secret the Omi backend must present to call /tools/* (Bearer header or
# ms365_tools_token query param). Unset means every tool call is refused with 503.
MS365_TOOLS_SECRET=generate-a-strong-random-string-here

# Redis (optional; falls back to in-memory store if empty)
REDIS_URL=

# Logging
LOG_LEVEL=INFO
