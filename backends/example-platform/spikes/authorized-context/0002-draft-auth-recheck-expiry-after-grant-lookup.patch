 core/retrieve/authorization-boundary.ts      |  2 +
 2 files changed, 46 insertions(+)

diff --git a/core/retrieve/authorization-boundary.test.ts b/core/retrieve/authorization-boundary.test.ts
index 7f62320..4cbc281 100644
--- a/core/retrieve/authorization-boundary.test.ts
+++ b/core/retrieve/authorization-boundary.test.ts
@@ -694,6 +694,50 @@ test("injected clock and grant lookup failures deny before store access", () =>
   expect(storeCalls).toBe(0);
 });
 
+test("authorization rechecks expiry after grant lookup before evidence or store access", () => {
+  const request: ApplicationMemoryReadAuthorizationRequest = {
+    ...allowed(),
+    verified_principal: {
+      ...allowed().verified_principal,
+      authentication_expires_at_epoch_seconds: NOW + 1,
+    },
+  };
+  const runInspection = (): { readonly lookupCalls: number; readonly clockCalls: number } => {
+    let currentTime = NOW;
+    let lookupCalls = 0;
+    let clockCalls = 0;
+    expect(() => inspectAuthorization(request, () => {
+      lookupCalls++;
+      currentTime = NOW + 1;
+      return grantFor(request);
+    }, () => {
+      clockCalls++;
+      return currentTime;
+    })).toThrow("authentication_expired");
+    return { lookupCalls, clockCalls };
+  };
+  expect(runInspection()).toEqual({ lookupCalls: 1, clockCalls: 2 });
+
+  let currentTime = NOW;
+  let lookupCalls = 0;
+  let clockCalls = 0;
+  let storeCalls = 0;
+  expect(() => authorizeAndRead(request, () => {
+    lookupCalls++;
+    currentTime = NOW + 1;
+    return grantFor(request);
+  }, () => {
+    clockCalls++;
+    return currentTime;
+  }, (_context) => {
+    storeCalls++;
+    return { snapshot: snapshot(), options: { account_timezone: "UTC" } };
+  })).toThrow("authentication_expired");
+  expect(lookupCalls).toBe(1);
+  expect(clockCalls).toBe(2);
+  expect(storeCalls).toBe(0);
+});
+
